`ifndef DDR_MAP_PAGE_DEFAULTS_VH
`define DDR_MAP_PAGE_DEFAULTS_VH

// DDR addresses are 16-bit units; one 128-bit frame word spans 8 units.
`define DDR_MAP_LIVE0_BASE   25'd0
`define DDR_MAP_LIVE1_BASE   25'd7000000
`define DDR_MAP_LIVE2_BASE   25'd14000000
`define DDR_MAP_LIVE3_BASE   25'd21000000
`define DDR_MAP_ANGLE0_BASE  25'd23000000
`define DDR_MAP_ANGLE45_BASE 25'd24400000
`define DDR_MAP_ANGLE90_BASE 25'd25800000
`define DDR_MAP_ANGLE135_BASE 25'd27200000
`define DDR_MAP_DOLP_BASE    25'd28600000
`define DDR_MAP_AOP_BASE     25'd30000000
`define DDR_MAP_FUSION_BASE  25'd31400000
`define DDR_MAP_EDGE_BASE    25'd4000000
`define DDR_MAP_FRAME_WORDS  172800
`define DDR_MAP_FRAME_SPAN   1382400

`endif
