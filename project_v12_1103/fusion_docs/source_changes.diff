-    wire [7:0] b8 = px_in[7:0];    
-
-    wire [15:0] re = {8'd0, r8};
-    wire [15:0] ge = {8'd0, g8};
-    wire [15:0] be = {8'd0, b8};
-
-    
-    
-    localparam SHIFT = (GRAY_MODE == 1) ? 2 : (GRAY_MODE == 2) ? 3 : 8;
-    localparam [15:0] RND = 16'd1 << (SHIFT - 1);   
-
-    wire [15:0] sum_c;
-
-    generate
-    if (GRAY_MODE == 1) begin : g_cheap
-        
-        assign sum_c = re + (ge << 1) + be;
-    end else if (GRAY_MODE == 2) begin : g_mid
-        
-        assign sum_c = (re << 1) + ((ge << 2) + ge) + be;
-    end else begin : g_exact
-        
-        
-        assign sum_c = ((re << 6) + (re << 3) + (re << 2) + re)
