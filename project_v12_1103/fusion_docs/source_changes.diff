-localparam MEM_DEPTH=NB*IMG_H;
-localparam AW=$clog2(MEM_DEPTH);
-localparam BW=(DS_LOG2<1)?1:DS_LOG2;
-localparam SUM_W=8+DS_LOG2;
-wire [7:0] threshold=thr_in==0 ? DIFF_THR : thr_in;
-wire [7:0] y_cur;wire gd,gh,gv;
-algo_gray #(.GRAY_MODE(GRAY_MODE)) u_gray(.clk(clk),.rst_n(rst_n),
-    .px_in(px_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),
-    .rgb_out(),.y_out(y_cur),.de_out(gd),.hs_out(gh),.vs_out(gv));
-reg [23:0] col1,col2;
-always @(posedge clk or negedge rst_n) begin
-    if(!rst_n) begin col1<=0;col2<=0;end
-    else begin col1<=px_in;col2<=col1;end
-end
-reg [XW-1:0] x2;reg [YW-1:0] y2;
-reg gd_prev,gv_prev;
-wire frame_start=gv && !gv_prev;
-always @(posedge clk or negedge rst_n) begin
-    if(!rst_n) begin x2<=0;y2<=0;gd_prev<=0;gv_prev<=0;end
-    else begin
-        gd_prev<=gd;gv_prev<=gv;
-        if(frame_start) begin x2<=0;y2<=0;end
