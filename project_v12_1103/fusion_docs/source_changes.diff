-`timescale 1ns/1ps
-module algo_binary #(parameter BIN_INV = 0)(
-    input wire clk, input wire rst_n,
-    input wire [7:0] y_in, input wire [7:0] thr_in,
-    input wire de_in, input wire hs_in, input wire vs_in,
-    output reg [23:0] rgb_out, output reg [7:0] y_out,
-    output reg bin_out, output reg de_out, output reg hs_out, output reg vs_out
-);
-wire bin_w = (y_in >= thr_in) ^ (BIN_INV != 0);
-always @(posedge clk or negedge rst_n) begin
-    if (!rst_n) begin
-        rgb_out <= 24'd0; y_out <= 8'd0; bin_out <= 1'b0;
-        de_out <= 1'b0; hs_out <= 1'b0; vs_out <= 1'b0;
-    end else begin
-        rgb_out <= bin_w ? 24'hffffff : 24'h000000;
-        y_out <= y_in; bin_out <= bin_w;
-        de_out <= de_in; hs_out <= hs_in; vs_out <= vs_in;
-    end
-end
-endmodule
