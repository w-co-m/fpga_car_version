-module anlogic_logo_counter #(
-    parameter IMAGE_WIDTH=1280,IMAGE_HEIGHT=720,
-    parameter LOGO_X=16,LOGO_Y=80,COUNTER_X=375,COUNTER_Y=120,
-    parameter COUNTER_COLOR=24'hfff200
-)(
-    input wire clk,input wire rst_n,input wire de_in,input wire vs_in,
-    output wire hit_out,output wire [23:0] color_out
-);
-reg [11:0] x;reg [10:0] y;reg de_d,vs_d;
-wire frame_start=vs_in && !vs_d;
-always @(posedge clk or negedge rst_n) begin
-    if(!rst_n) begin x<=0;y<=0;de_d<=0;vs_d<=0;end
-    else begin
-        de_d<=de_in;vs_d<=vs_in;
-        if(frame_start) begin x<=0;y<=0;end
-        else if(de_in) x<=x==IMAGE_WIDTH-1 ? 0 : x+1'b1;
-        else if(de_d) begin x<=0;y<=y==IMAGE_HEIGHT-1 ? 0 : y+1'b1;end
-    end
-end
-// BCD increment matches official counter; no binary-to-decimal divider.
-reg [3:0] d0,d1,d2,d3,d4,d5;
-always @(posedge clk or negedge rst_n) begin
-    if(!rst_n) begin d0<=0;d1<=0;d2<=0;d3<=0;d4<=0;d5<=0;end
-    else if(frame_start) begin
-        if(d0!=9) d0<=d0+1'b1;
-        else begin d0<=0;
-            if(d1!=9) d1<=d1+1'b1;
-            else begin d1<=0;
-                if(d2!=9) d2<=d2+1'b1;
-                else begin d2<=0;
-                    if(d3!=9) d3<=d3+1'b1;
-                    else begin d3<=0;
-                        if(d4!=9) d4<=d4+1'b1;
-                        else begin d4<=0;d5<=d5==9 ? 0 : d5+1'b1;end
-                    end
-                end
-            end
-        end
-    end
-end
-wire logo_area=de_in && x>=LOGO_X && x<LOGO_X+160 && y>=LOGO_Y && y<LOGO_Y+160;
-wire [11:0] lx=x-LOGO_X,ly=y-LOGO_Y;
-wire [14:0] logo_addr=logo_area ? (ly*160+lx) : 0;
-wire [24:0] logo_pixel2;
-anlogic_logo_rom_indexed u_logo(.clk(clk),.addr(logo_addr),.pixel(logo_pixel2));
-
-// The official 16x16 glyph library and its original 24/16/15 pixel scaling.
-wire counter_area=de_in && x>=COUNTER_X && x<COUNTER_X+200 && y>=COUNTER_Y && y<COUNTER_Y+24;
-wire [11:0] cx=x-COUNTER_X,cy=y-COUNTER_Y;
-reg [7:0] char_code;
-reg [3:0] char_row,char_col;
-reg glyph_area;reg [11:0] local_x,local_y;
-reg [3:0] digit;
-wire [15:0] glyph_row;
-osd_char_lib u_font(.I_char(char_code),.I_row(char_row),.O_row_bits(glyph_row));
-always @* begin
-    char_code=0;char_row=0;char_col=0;glyph_area=0;local_x=0;local_y=0;digit=0;
-    if(counter_area) begin
-        if(cx<48 && cy>=2) begin
-            char_code=cx<24 ? 8'h80 : 8'h81;
-            local_x=cx<24 ? cx : cx-24;local_y=cy-2;
-            char_col=(local_x*16)/24;char_row=(local_y*16)/24;glyph_area=1;
-        end else if(cx>=52 && cx<100 && cy>=4 && cy<20) begin
-            char_code=cx<68 ? 8'h43 : cx<84 ? 8'h4e : 8'h54;
-            local_x=cx<68 ? cx-52 : cx<84 ? cx-68 : cx-84;
-            char_col=local_x[3:0];char_row=cy-4;glyph_area=1;
-        end else if(cx>=100 && cx<108 && cy>=4 && cy<20) begin
-            char_code=8'h3a;char_col=(cx-100)*2;char_row=cy-4;glyph_area=1;
-        end else if(cx>=110) begin
-            if(cx<125) begin digit=d5;local_x=cx-110;end
-            else if(cx<140) begin digit=d4;local_x=cx-125;end
-            else if(cx<155) begin digit=d3;local_x=cx-140;end
-            else if(cx<170) begin digit=d2;local_x=cx-155;end
-            else if(cx<185) begin digit=d1;local_x=cx-170;end
-            else begin digit=d0;local_x=cx-185;end
-            char_code=8'h30+{4'd0,digit};char_col=(local_x*16)/15;char_row=(cy*16)/24;glyph_area=1;
-        end
-    end
-end
-wire text_hit=glyph_area && glyph_row[15-char_col];
-reg logo_area1,logo_area2,text_hit1,text_hit2;
-always @(posedge clk or negedge rst_n) begin
-    if(!rst_n) begin logo_area1<=0;logo_area2<=0;text_hit1<=0;text_hit2<=0;end
-    else begin logo_area1<=logo_area;logo_area2<=logo_area1;text_hit1<=text_hit;text_hit2<=text_hit1;end
-end
-wire logo_hit2=logo_area2 && logo_pixel2[24];
-wire hit2=logo_hit2 || text_hit2;
-wire [23:0] color2=logo_hit2 ? logo_pixel2[23:0] : COUNTER_COLOR;
-video_delay #(.CYCLES(29)) u_align31(.clk(clk),.rst_n(rst_n),
-    .rgb_in(color2),.de_in(hit2),.hs_in(1'b0),.vs_in(1'b0),
-    .rgb_out(color_out),.de_out(hit_out),.hs_out(),.vs_out());
-endmodule
