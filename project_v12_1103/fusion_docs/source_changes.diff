-            rgb_out <= 24'd0;
-            y_out   <= 8'd0;
-            bin_out <= 1'b0;
-            de_out  <= 1'b0; hs_out <= 1'b0; vs_out <= 1'b0;
-        end else begin
-            y_out   <= res8;
-            rgb_out <= {res8, res8, res8};      
-            bin_out <= bin_c;
-            de_out  <= de_w;
-            hs_out  <= hs_w;
-            vs_out  <= vs_w;
-        end
-    end
