--- v8/user_source/algorithms/algo_bank.v
+++ fusion/user_source/algorithms/algo_bank.v
@@ -0,0 +1,192 @@
+`timescale 1ns/1ps
+// RGB888 实时分支共享5拍输出延迟；9..12是后台偏振结果页直通。
+// 模块作用：处理同一视频流并按DDR已确认的mode选择，14运动检测，15目标跟踪。
+// 模式0..8：原图、灰度、二值化、Sobel、亮度、对比度、均衡、腐蚀、膨胀。
+module algo_bank #(
+ parameter IMG_WIDTH=1280,
+ parameter IMG_HEIGHT=720,
+ parameter LB_DEPTH=2048,
+ parameter LB_AW=11,
+ parameter BIN_THRESHOLD=8'd128,
+ parameter EDGE_THRESHOLD=8'd32,
+ parameter DYNAMIC_THRESHOLD=0, // 0使用综合参数，1使用输入的运行时阈值
+ parameter DYNAMIC_GAIN=0, // 0保留固定增益，1使用帧边界提交的运行时增益
+ parameter [7:0] BRIGHT_GAIN=24, // Q4.4：24表示1.5倍亮度增益
+ parameter [7:0] CONTRAST_GAIN=24, // 围绕128拉伸，Q4.4增益1.5倍
+ parameter [7:0] COLOR_THRESHOLD=8'd96, // 旧规则0~3色差门限；规则4使用独立相对红度参数
+ parameter COLOR_MIN_PIX=16,
+ parameter MOTION_THRESHOLD=8,
+ parameter MOTION_MIN_PIX=1000,
+ parameter OUTPUT_LATENCY=5,
+ parameter VS_ACTIVE_LOW=0,
+ parameter integer COLOR_DET_RULE=6,
+ parameter [7:0] COLOR_RED_MIN=8'd24,
+ parameter [4:0] COLOR_RED_RATIO_Q4=5'd17,
+ parameter [7:0] COLOR_RED_CHROMA_MIN=8'd6,
+ parameter [7:0] COLOR_ASPECT_MIN_Q44=8'd5,
+ parameter [7:0] COLOR_ASPECT_MAX_Q44=8'd48,
+ parameter [8:0] COLOR_FILL_MIN_Q8=9'd64,
+ parameter integer MOTION_BLOCK_MEAN=1,
+ parameter integer MOTION_DYNAMIC_THRESHOLD=0
+)(
+ input wire clk,input wire rst_n,input wire [23:0] rgb_in,input wire [3:0] mode,
+ input wire de_in,input wire hs_in,input wire vs_in,
+ input wire [7:0] bin_threshold_in,input wire [7:0] edge_threshold_in,
+ input wire [7:0] bright_gain_in,input wire [7:0] contrast_gain_in,
+ output reg [23:0] rgb_out,output reg de_out,output reg hs_out,output reg vs_out,
+ input wire color_debug_in, // SW1 in mode13; omitted legacy inputs are treated as off.
+ input wire [7:0] motion_threshold_in,
+ output wire trk_update, trk_valid,
+ output wire [4:0] trk_lost_cnt,
+ output wire [((IMG_WIDTH<=1)?1:$clog2(IMG_WIDTH))-1:0] trk_x_min,trk_x_max,
+ output wire [((IMG_HEIGHT<=1)?1:$clog2(IMG_HEIGHT))-1:0] trk_y_min,trk_y_max
+);
+ // 重要：这是各分支的原始流水级数。公共 OUTPUT_LATENCY 不得小于最长分支。
+ // 新增算法时更新实例、信号、延迟补偿和 case，并修改顶层 ALGO_COUNT。
+ localparam RAW_LATENCY=1,GRAY_LATENCY=2,BINARY_LATENCY=3,SOBEL_LATENCY=5;
+ // Invalid integration parameters must fail elaboration instead of wrapping addresses.
+ generate if(OUTPUT_LATENCY<5 || IMG_WIDTH>LB_DEPTH || IMG_WIDTH>(1<<LB_AW))begin:g_bad_config
+  ERROR_ALGO_BANK_LATENCY_OR_LINE_BUFFER_CONFIGURATION invalid_configuration();
+ end endgenerate
+ wire [23:0] raw_rgb,gray_rgb,bin_rgb,sobel_rgb;
+ wire [7:0] gray_y;
+ wire raw_de,raw_hs,raw_vs,gray_de,gray_hs,gray_vs,bin_de,bin_hs,bin_vs,sobel_de,sobel_hs,sobel_vs;
+ wire [23:0] raw_aligned,gray_aligned,bin_aligned,sobel_aligned;
+ wire raw_de_a,raw_hs_a,raw_vs_a,gray_de_a,gray_hs_a,gray_vs_a,bin_de_a,bin_hs_a,bin_vs_a,sobel_de_a,sobel_hs_a,sobel_vs_a;
+ // 九路同时运行，Sobel 行缓存持续积累历史行，切换到它时不必重新等待缓存填充。
+ algo_passthrough u_raw(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(raw_rgb),.de_out(raw_de),.hs_out(raw_hs),.vs_out(raw_vs));
+ algo_gray u_gray(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(gray_rgb),.y_out(gray_y),.de_out(gray_de),.hs_out(gray_hs),.vs_out(gray_vs));
+ algo_binary #(.BIN_THRESHOLD(BIN_THRESHOLD),.DYNAMIC_THRESHOLD(DYNAMIC_THRESHOLD)) u_binary(.clk(clk),.rst_n(rst_n),.threshold_in(bin_threshold_in),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(bin_rgb),.de_out(bin_de),.hs_out(bin_hs),.vs_out(bin_vs));
+ algo_sobel #(.IMG_WIDTH(IMG_WIDTH),.LB_DEPTH(LB_DEPTH),.LB_AW(LB_AW),.EDGE_THRESHOLD(EDGE_THRESHOLD),.VS_ACTIVE_LOW(VS_ACTIVE_LOW),.DYNAMIC_THRESHOLD(DYNAMIC_THRESHOLD)) u_sobel(.clk(clk),.rst_n(rst_n),.threshold_in(edge_threshold_in),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(sobel_rgb),.de_out(sobel_de),.hs_out(sobel_hs),.vs_out(sobel_vs));
+ // 统一总延迟为 5 级：原图补 4、灰度补 3、二值化补 2、Sobel 补 0。
+ // RGB 和 DE/HS/VS 一起延迟，不能只补颜色数据，否则像素与显示位置错位。
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-RAW_LATENCY)) u_raw_align(.clk(clk),.rst_n(rst_n),.data_in(raw_rgb),.de_in(raw_de),.hs_in(raw_hs),.vs_in(raw_vs),.data_out(raw_aligned),.de_out(raw_de_a),.hs_out(raw_hs_a),.vs_out(raw_vs_a));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-GRAY_LATENCY)) u_gray_align(.clk(clk),.rst_n(rst_n),.data_in(gray_rgb),.de_in(gray_de),.hs_in(gray_hs),.vs_in(gray_vs),.data_out(gray_aligned),.de_out(gray_de_a),.hs_out(gray_hs_a),.vs_out(gray_vs_a));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-BINARY_LATENCY)) u_binary_align(.clk(clk),.rst_n(rst_n),.data_in(bin_rgb),.de_in(bin_de),.hs_in(bin_hs),.vs_in(bin_vs),.data_out(bin_aligned),.de_out(bin_de_a),.hs_out(bin_hs_a),.vs_out(bin_vs_a));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-SOBEL_LATENCY)) u_sobel_align(.clk(clk),.rst_n(rst_n),.data_in(sobel_rgb),.de_in(sobel_de),.hs_in(sobel_hs),.vs_in(sobel_vs),.data_out(sobel_aligned),.de_out(sobel_de_a),.hs_out(sobel_hs_a),.vs_out(sobel_vs_a));
+ // 新增分支持续运行，直方图均衡利用上一帧统计；形态学处理灰度3x3邻域。
+ wire [23:0] bright_rgb,bright_aligned;
+ wire bright_de,bright_hs,bright_vs,bright_de_a,bright_hs_a,bright_vs_a;
+ algo_bright u_bright(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(DYNAMIC_GAIN ? bright_gain_in : BRIGHT_GAIN),.rgb_out(bright_rgb),.y_out(),.bin_out(),.de_out(bright_de),.hs_out(bright_hs),.vs_out(bright_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-3)) u_bright_align(.clk(clk),.rst_n(rst_n),.data_in(bright_rgb),.de_in(bright_de),.hs_in(bright_hs),.vs_in(bright_vs),.data_out(bright_aligned),.de_out(bright_de_a),.hs_out(bright_hs_a),.vs_out(bright_vs_a));
+ wire [23:0] contrast_rgb,contrast_aligned;
+ wire contrast_de,contrast_hs,contrast_vs,contrast_de_a,contrast_hs_a,contrast_vs_a;
+ algo_contrast u_contrast(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(DYNAMIC_GAIN ? contrast_gain_in : CONTRAST_GAIN),.rgb_out(contrast_rgb),.y_out(),.bin_out(),.de_out(contrast_de),.hs_out(contrast_hs),.vs_out(contrast_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-3)) u_contrast_align(.clk(clk),.rst_n(rst_n),.data_in(contrast_rgb),.de_in(contrast_de),.hs_in(contrast_hs),.vs_in(contrast_vs),.data_out(contrast_aligned),.de_out(contrast_de_a),.hs_out(contrast_hs_a),.vs_out(contrast_vs_a));
+ wire [23:0] histeq_rgb,histeq_aligned;
+ wire histeq_de,histeq_hs,histeq_vs,histeq_de_a,histeq_hs_a,histeq_vs_a;
+ algo_histeq #(.HIST_BITS(20),.VS_ACTIVE_LOW(VS_ACTIVE_LOW)) u_histeq(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(8'd128),.rgb_out(histeq_rgb),.y_out(),.bin_out(),.de_out(histeq_de),.hs_out(histeq_hs),.vs_out(histeq_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-4)) u_histeq_align(.clk(clk),.rst_n(rst_n),.data_in(histeq_rgb),.de_in(histeq_de),.hs_in(histeq_hs),.vs_in(histeq_vs),.data_out(histeq_aligned),.de_out(histeq_de_a),.hs_out(histeq_hs_a),.vs_out(histeq_vs_a));
+ wire [23:0] erode_rgb,erode_aligned;
+ wire erode_de,erode_hs,erode_vs,erode_de_a,erode_hs_a,erode_vs_a;
+ algo_morph #(.LB_W(IMG_WIDTH),.LB_DEPTH(LB_DEPTH),.LB_AW(LB_AW),.VS_ACTIVE_LOW(VS_ACTIVE_LOW),.OP_FROM_THR(0),.MORPH_OP(0)) u_erode(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(8'd128),.rgb_out(erode_rgb),.y_out(),.bin_out(),.de_out(erode_de),.hs_out(erode_hs),.vs_out(erode_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-4)) u_erode_align(.clk(clk),.rst_n(rst_n),.data_in(erode_rgb),.de_in(erode_de),.hs_in(erode_hs),.vs_in(erode_vs),.data_out(erode_aligned),.de_out(erode_de_a),.hs_out(erode_hs_a),.vs_out(erode_vs_a));
+ wire [23:0] dilate_rgb,dilate_aligned;
+ wire dilate_de,dilate_hs,dilate_vs,dilate_de_a,dilate_hs_a,dilate_vs_a;
+ algo_morph #(.LB_W(IMG_WIDTH),.LB_DEPTH(LB_DEPTH),.LB_AW(LB_AW),.VS_ACTIVE_LOW(VS_ACTIVE_LOW),.OP_FROM_THR(0),.MORPH_OP(1)) u_dilate(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(8'd128),.rgb_out(dilate_rgb),.y_out(),.bin_out(),.de_out(dilate_de),.hs_out(dilate_hs),.vs_out(dilate_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-4)) u_dilate_align(.clk(clk),.rst_n(rst_n),.data_in(dilate_rgb),.de_in(dilate_de),.hs_in(dilate_hs),.vs_in(dilate_vs),.data_out(dilate_aligned),.de_out(dilate_de_a),.hs_out(dilate_hs_a),.vs_out(dilate_vs_a));
+ // 颜色检测始终共享原始RGB输入；偏振页只关闭本帧统计，避免把结果页当作新目标。
+ wire live_algorithm_enable=!((mode>=4'd9)&&(mode<=4'd12));
+ localparam TRACK_XW=(IMG_WIDTH<=1)?1:$clog2(IMG_WIDTH);
+ localparam TRACK_YW=(IMG_HEIGHT<=1)?1:$clog2(IMG_HEIGHT);
+ wire [TRACK_XW-1:0] color_bbox_x_min,color_bbox_x_max;
+ wire [TRACK_YW-1:0] color_bbox_y_min,color_bbox_y_max;
+ wire color_bbox_valid,color_bbox_fresh;
+ wire [23:0] color_rgb,color_aligned;
+ wire color_mask,color_mask_aligned;
+ wire color_de,color_hs,color_vs,color_de_a,color_hs_a,color_vs_a;
+ reg color_vs_prev,color_debug_active;
+ wire color_vs_active=VS_ACTIVE_LOW ? ~vs_in : vs_in;
+ always @(posedge clk or negedge rst_n)
+   if(!rst_n)begin color_vs_prev<=0;color_debug_active<=0;end
+   else begin
+     color_vs_prev<=color_vs_active;
+     if(color_vs_active && !color_vs_prev && !de_in)
+       color_debug_active<=(color_debug_in===1'b1);
+   end
+ algo_color_detect #(.IMG_WIDTH(IMG_WIDTH),.IMG_HEIGHT(IMG_HEIGHT),.TARGET_COLOR(0),
+     .DET_RULE(COLOR_DET_RULE),.RED_MIN(COLOR_RED_MIN),.RED_RATIO_Q4(COLOR_RED_RATIO_Q4),
+     .RED_CHROMA_MIN(COLOR_RED_CHROMA_MIN),
+     .R_SAT_MIN(8'd192),.SHAPE_FILTER_EN(1),.TARGET_SHAPE(0),
+     .ASPECT_MIN_Q44(COLOR_ASPECT_MIN_Q44),.ASPECT_MAX_Q44(COLOR_ASPECT_MAX_Q44),
+     .FILL_MIN_Q8(COLOR_FILL_MIN_Q8),
+     .S_DEF(COLOR_THRESHOLD),.MIN_PIX(COLOR_MIN_PIX),.BOX_W(2),.BOX_FILL(0),
+     .BOX_COLOR(24'h00ff00),.VS_ACTIVE_LOW(VS_ACTIVE_LOW)) u_color_detect (
+     .clk(clk),.rst_n(rst_n),.enable_in(live_algorithm_enable),
+     .rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.thr_in(8'd0),
+     .rgb_out(color_rgb),.y_out(),.bin_out(color_mask),.de_out(color_de),.hs_out(color_hs),.vs_out(color_vs),
+     .bbox_x_min(color_bbox_x_min),.bbox_x_max(color_bbox_x_max),
+     .bbox_y_min(color_bbox_y_min),.bbox_y_max(color_bbox_y_max),.bbox_valid(color_bbox_valid),.bbox_fresh(color_bbox_fresh),.hit_cnt(),
+     .shape_type(),.shape_ok(),.bbox_valid_raw(),.fill_ratio_q8(),.aspect_ratio_q44());
+ // 检测核为3拍，补齐到各模式共用的OUTPUT_LATENCY级。
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-3)) u_color_align(
+     .clk(clk),.rst_n(rst_n),.data_in(color_rgb),.de_in(color_de),.hs_in(color_hs),.vs_in(color_vs),
+     .data_out(color_aligned),.de_out(color_de_a),.hs_out(color_hs_a),.vs_out(color_vs_a));
+ video_delay #(.DATA_WIDTH(1),.DELAY(OUTPUT_LATENCY-3)) u_color_mask_align(
+     .clk(clk),.rst_n(rst_n),.data_in(color_mask),.de_in(color_de),.hs_in(color_hs),.vs_in(color_vs),
+     .data_out(color_mask_aligned),.de_out(),.hs_out(),.vs_out());
+ // Tracking reuses the detector's published frame bbox and always sees the original stream.
+ wire [23:0] track_rgb,track_aligned;
+ wire track_de,track_hs,track_vs,track_de_a,track_hs_a,track_vs_a;
+ algo_track #(.IMG_WIDTH(IMG_WIDTH),.IMG_HEIGHT(IMG_HEIGHT),
+     .DET_XW(TRACK_XW),.DET_YW(TRACK_YW),.SMOOTH_SHIFT(2),.LOST_MAX(15),
+     .SNAP_DIST(64),.BOX_W(2),.HINT_EN(0),.VS_ACTIVE_LOW(VS_ACTIVE_LOW)) u_track (
+     .clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),
+     .enable_in(live_algorithm_enable),.det_x_min(color_bbox_x_min),.det_x_max(color_bbox_x_max),
+     .det_y_min(color_bbox_y_min),.det_y_max(color_bbox_y_max),.det_valid(color_bbox_fresh),.mot_in(1'b0),
+     .trk_x_min(trk_x_min),.trk_x_max(trk_x_max),.trk_y_min(trk_y_min),.trk_y_max(trk_y_max),.trk_valid(trk_valid),.lost_cnt(trk_lost_cnt),.update_out(trk_update),
+     .rgb_out(track_rgb),.y_out(),.bin_out(),.de_out(track_de),.hs_out(track_hs),.vs_out(track_vs));
+ // Tracker adds two pixel clocks; align its RGB and syncs with the shared output latency.
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-2)) u_track_align(
+     .clk(clk),.rst_n(rst_n),.data_in(track_rgb),.de_in(track_de),.hs_in(track_hs),.vs_in(track_vs),
+     .data_out(track_aligned),.de_out(track_de_a),.hs_out(track_hs_a),.vs_out(track_vs_a));
+ // 算法11复用灰度核：原RGB补1拍到总2拍，与gray_y/gray_de同位置。
+ // 参考在普通RGB模式连续更新；偏振结果页期间失效，返回后完整预热一帧。
+ wire [23:0] raw_gray_aligned,motion_rgb,motion_aligned;
+ wire motion_de,motion_hs,motion_vs,motion_de_a,motion_hs_a,motion_vs_a;
+ // A threshold committed on raw VS must travel with gray RGB/sync. Without
+ // these two stages it can affect the previous frame's final block in flight.
+ reg [7:0] motion_threshold_gray1,motion_threshold_gray2;
+ always @(posedge clk or negedge rst_n)
+   if(!rst_n)begin
+     motion_threshold_gray1<=MOTION_THRESHOLD;
+     motion_threshold_gray2<=MOTION_THRESHOLD;
+   end else begin
+     motion_threshold_gray1<=motion_threshold_in;
+     motion_threshold_gray2<=motion_threshold_gray1;
+   end
+ video_delay #(.DATA_WIDTH(24),.DELAY(GRAY_LATENCY-RAW_LATENCY)) u_motion_rgb_align(
+     .clk(clk),.rst_n(rst_n),.data_in(raw_rgb),.de_in(raw_de),.hs_in(raw_hs),.vs_in(raw_vs),
+     .data_out(raw_gray_aligned),.de_out(),.hs_out(),.vs_out());
+ algo_motion #(.IMG_WIDTH(IMG_WIDTH),.IMG_HEIGHT(IMG_HEIGHT),.DS_LOG2(4),
+     .BLOCK_MEAN_MODE(MOTION_BLOCK_MEAN),
+     .DIFF_THR(MOTION_THRESHOLD),.MOTION_CNT(MOTION_MIN_PIX),.VS_ACTIVE_LOW(VS_ACTIVE_LOW)) u_motion(
+     .clk(clk),.rst_n(rst_n),.enable_in(live_algorithm_enable),.rgb_in(raw_gray_aligned),
+     .y_in(gray_y),.de_in(gray_de),.hs_in(gray_hs),.vs_in(gray_vs),
+     .threshold_in(MOTION_DYNAMIC_THRESHOLD ? motion_threshold_gray2 : 8'd0),
+     .rgb_out(motion_rgb),.mask_out(),.bin_out(),.motion_detected(),.motion_pixel_cnt(),.ref_ready(),
+     .de_out(motion_de),.hs_out(motion_hs),.vs_out(motion_vs));
+ video_delay #(.DATA_WIDTH(24),.DELAY(OUTPUT_LATENCY-GRAY_LATENCY-2)) u_motion_align(
+     .clk(clk),.rst_n(rst_n),.data_in(motion_rgb),.de_in(motion_de),.hs_in(motion_hs),.vs_in(motion_vs),
+     .data_out(motion_aligned),.de_out(motion_de_a),.hs_out(motion_hs_a),.vs_out(motion_vs_a));
+ // 组合多路选择器，不再增加寄存级；模式应在集成模块的垂直消隐期切换。
+ always @* begin
+  case(mode)
+   4'd1:begin rgb_out=gray_aligned;de_out=gray_de_a;hs_out=gray_hs_a;vs_out=gray_vs_a;end
+   4'd2:begin rgb_out=bin_aligned;de_out=bin_de_a;hs_out=bin_hs_a;vs_out=bin_vs_a;end
+   4'd3:begin rgb_out=sobel_aligned;de_out=sobel_de_a;hs_out=sobel_hs_a;vs_out=sobel_vs_a;end
+   4'd4:begin rgb_out=bright_aligned;de_out=bright_de_a;hs_out=bright_hs_a;vs_out=bright_vs_a;end
+   4'd5:begin rgb_out=contrast_aligned;de_out=contrast_de_a;hs_out=contrast_hs_a;vs_out=contrast_vs_a;end
+   4'd6:begin rgb_out=histeq_aligned;de_out=histeq_de_a;hs_out=histeq_hs_a;vs_out=histeq_vs_a;end
+   4'd7:begin rgb_out=erode_aligned;de_out=erode_de_a;hs_out=erode_hs_a;vs_out=erode_vs_a;end
+   4'd8:begin rgb_out=dilate_aligned;de_out=dilate_de_a;hs_out=dilate_hs_a;vs_out=dilate_vs_a;end
+   // 后台DoLP/AoP/Fusion/PEDGE页已经是RGB888结果，直接沿用RAW的5级延迟。
+   4'd9,4'd10,4'd11,4'd12:begin rgb_out=raw_aligned;de_out=raw_de_a;hs_out=raw_hs_a;vs_out=raw_vs_a;end
+   4'd13:begin rgb_out=color_debug_active ? (color_mask_aligned ? 24'h00ff00 : 24'h000000) : color_aligned;de_out=color_de_a;hs_out=color_hs_a;vs_out=color_vs_a;end
+   4'd14:begin rgb_out=motion_aligned;de_out=motion_de_a;hs_out=motion_hs_a;vs_out=motion_vs_a;end
+   4'd15:begin rgb_out=track_aligned;de_out=track_de_a;hs_out=track_hs_a;vs_out=track_vs_a;end
+   default:begin rgb_out=raw_aligned;de_out=raw_de_a;hs_out=raw_hs_a;vs_out=raw_vs_a;end
+  endcase
+ end
+endmodule
+
--- v8/user_source/algorithms/algo_binary.v
+++ fusion/user_source/algorithms/algo_binary.v
@@ -0,0 +1,15 @@
+`timescale 1ns/1ps
+// 模块作用：先转灰度再阈值判断；默认灰度>=128 输出白色，否则黑色。
+// BIN_INV 非零时反相；总延迟为灰度 2 级加判断输出 1 级。
+module algo_binary #(parameter GRAY_MODE=0,parameter BIN_THRESHOLD=8'd128,parameter BIN_INV=0, parameter DYNAMIC_THRESHOLD=0)(input wire clk,input wire rst_n,input wire [23:0] rgb_in, input wire [7:0] threshold_in,input wire de_in,input wire hs_in,input wire vs_in,output reg [23:0] rgb_out,output reg de_out,output reg hs_out,output reg vs_out);
+ wire [23:0] gray_rgb; wire [7:0] y_gray; wire de_gray,hs_gray,vs_gray;
+ algo_gray #(.GRAY_MODE(GRAY_MODE)) u_gray(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(gray_rgb),.y_out(y_gray),.de_out(de_gray),.hs_out(hs_gray),.vs_out(vs_gray));
+ // DYNAMIC_THRESHOLD=1使用threshold_in；为0时兼容原固定参数接口。
+ // white 的异或实现黑白反相；消隐期颜色不作为有效像素使用。
+ // 动态阈值随输入像素延迟两拍，与灰度结果对齐；总视频延迟仍为三拍。
+ reg [7:0] threshold_s1, threshold_s2; wire white=(y_gray >= (DYNAMIC_THRESHOLD ? threshold_s2 : BIN_THRESHOLD))^(BIN_INV!=0);
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin threshold_s1<=BIN_THRESHOLD;threshold_s2<=BIN_THRESHOLD;rgb_out<=0;de_out<=0;hs_out<=0;vs_out<=0; end
+  else begin threshold_s1<=threshold_in;threshold_s2<=threshold_s1;rgb_out<=white?24'hFFFFFF:24'h000000;de_out<=de_gray;hs_out<=hs_gray;vs_out<=vs_gray; end
+ end
+endmodule
--- v8/user_source/algorithms/algo_bright.v
+++ fusion/user_source/algorithms/algo_bright.v
@@ -0,0 +1,59 @@
+// algo_bright.v —— 算法5 子模式①：亮度增强（mode = 0100）
+// 【解决的问题】夜间/暗光：整体偏暗，细节埋在低灰度区。
+// 【增益】沿用总线上的既有一根 thr_in[7:0]（不新增端口/引脚）：
+//     thr_in = 16 → ×1.0（恒等）      32 → ×2.0     48 → ×3.0
+//              8 → ×0.5              0 → 目标亮度Y为0（彩色输出还取决于通道差值与裁剪）
+//   上板演示给 24~40（×1.5~×2.5）最直观；
+//   要拨码/按键实时调：把顶层给 thr_in 的那根 wire 换成你的信号，
+//   异步输入进 clk_pix 域前必须**打两拍同步**（按键再去抖），本模块不用改。
+//
+// 【输出】rgb_out = 增强后的彩色图（默认共同加减 Δ；未发生通道饱和时色差保持）；
+//         y_out   = 增强后的亮度 Y'（给后续算法复用）；
+//         bin_out = 饱和截断标志（1 = 本像素有通道被钉到 0/255）——可直接当"过曝告警"用。
+// 【流水线】固定 3 拍，de/hs/vs 同延 3 拍（内部例化 algo_gray 2 拍 + 变换 1 拍）。
+//=============================================================================
+// 来源：算法5交付包原 wrapper，保留默认增益与 Δ 色差保持公式，仅改为 RGB888 输入。
+// 流水延迟：灰度 2 级 + 变换/输出 1 级，总计 3 级；thr_in 与像素同拍对齐。
+`timescale 1ns/1ps
+
+module algo_bright #(
+    parameter GRAY_MODE  = 0,       // 内部灰度权值模式（必须与上游一致）
+    parameter BRIGHT_ADD = 0,       // 加性偏移 0~127（默认 0 = 纯乘性增益）
+    parameter RGB_MODE   = 0        // 0 = Δ 色差保持（默认，1 个乘法器）；1 = 三通道各自乘增益
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        hs_in,
+    input  wire        vs_in,
+    input  wire [7:0]  thr_in,      // ★ Q4.4 亮度增益（16 = ×1.0）
+
+    output wire [23:0] rgb_out,
+    output wire [7:0]  y_out,
+    output wire        bin_out,
+    output wire        de_out,
+    output wire        hs_out,
+    output wire        vs_out
+);
+
+    algo_level #(
+        .GRAY_MODE  (GRAY_MODE),
+        .CENTER     (0),                // ★ 中心 = 0 ⇒ 保黑点的乘性增益 = 亮度增强
+        .ADD        (BRIGHT_ADD),
+        .GAIN_SHIFT (4),                // Q4.4：16 = ×1.0
+        .RGB_MODE   (RGB_MODE)
+    ) u_core (
+        .clk     (clk),    .rst_n  (rst_n),
+        .rgb_in  (rgb_in),
+        .de_in   (de_in),  .hs_in  (hs_in), .vs_in (vs_in),
+        .thr_in  (thr_in),
+        .rgb_out (rgb_out),
+        .y_out   (y_out),
+        .bin_out (bin_out),
+        .de_out  (de_out), .hs_out (hs_out), .vs_out (vs_out)
+    );
+
+endmodule
+
--- v8/user_source/algorithms/algo_color_detect.v
+++ fusion/user_source/algorithms/algo_color_detect.v
@@ -0,0 +1,423 @@
+`timescale 1ns/1ps
+
+//=============================================================================
+// 算法10：颜色目标检测与包围框（模式13 COLORBOX）
+//-----------------------------------------------------------------------------
+// 来源：new_algorithm/算法10交付包（2026-10-17 修订版）
+//   交付核心 rtl/算法 10 颜色目标检测与包围框.v  SHA256 27F7F5A6DE022333F5C09F5F169F56EE93B410C4B14743AB64C892A25848A926
+//   交付顶层算法流水线的顶层调度器.v              SHA256 EC0BF32C0AA264290...
+//
+// 【为什么不是整包覆盖】交付包的调度器/参数源按 640x480 RGB565、25MHz 像素时钟、
+//   OV5640 寄存器表设计（video_defs.vh：IMG_W=640、IMG_H=480）；本板原理图为
+//   HX1P35B_FT（PH1P35MDG324）+ MIPI 摄像头 SC500CS + HDMI，工程为 1280x720 RGB888、
+//   75MHz 像素时钟、DDR 帧缓存与偏振后台。整包覆盖会改掉采集/显示/OSD 等非算法部分，
+//   因此只把**算法本体**移植进本文件，保留工程既有的 RGB888/720p 壳体。
+//
+// 【与交付包逐项对齐的算法语义】
+//   · 颜色判定  DET_RULE=0 差分 / 1 绝对上下限 / 2 抗暖白(R-G 且 R 饱和) / 3 规则2+第三通道差分
+//   · 2026-10-20：追加规则4，相对红度+低亮度下限，改善同比变暗时的漏检；规则0~3不变。
+//   · 追加规则5：低饱和红色扇区，支持粉红目标；旧规则0~4不变。
+//   · 规则6    分行程连通区域，选择并保持单个红色目标；不使用长宽比/填充率筛选。
+//   · 旧规则0~5保留整帧 bbox 统计；新规则6接口不变，像素延迟仍为3拍。
+//   · 画框      BOX_W 线宽、BOX_FILL 实心、BOX_COLOR 框色
+//   · 抗噪      MIN_PIX 命中像素下限
+//   · 形状筛选  SHAPE_FILTER_EN/TARGET_SHAPE/ASPECT_*/FILL_*/SHAPE_TOL_Q8，全程无除法
+//   · 调试视图  DEBUG_VIEW=1 时命中像素=纯绿、未命中=原图变暗 1/4
+//   只有两处按本工程规模做了等价改写（不改变算法结果）：
+//     1) 通道用完整 RGB888（交付包为 RGB565 的 r6/g6/b6），阈值按名义 ×4 缩放，
+//        旧规则见 algo_bank 的 COLOR_THRESHOLD=96 与 R_SAT_MIN=192；
+//     2) 交付包的运行时端口 r_sat_in 在本工程合并为编译期参数 R_SAT_MIN
+//        （板上没有对应旋钮，algo_bank 也没有运行期配置通路）。
+//
+// 【保留的工程壳体（交付包没有、但本工程已验证的加固）】
+//   · VS 取上升沿 frame_start，而非电平，避免 VS 多拍重复锁存；
+//   · 帧末最后一个有效像素仍计入本帧（publish_* 先合并再发布）；
+//   · enable_in 关闭时统计与形状状态确定性清零（模式9~12 不被偏振页污染）；
+//   · X/Y/HIT 位宽按 IMG_WIDTH/IMG_HEIGHT 派生，1280x720 时为 11/10/20 位。
+//
+// 时序：像素级 3 级流水（RGB/sync 同延），帧级 1 帧（bbox 整帧统计后锁存）。
+//=============================================================================
+module algo_color_detect #(
+    parameter integer IMG_WIDTH = 1280,
+    parameter integer IMG_HEIGHT = 720,
+    parameter integer TARGET_COLOR = 0,
+    parameter integer DET_RULE = 0,
+    parameter [7:0] R_MIN = 8'd128,
+    parameter [7:0] R_MAX = 8'd255,
+    parameter [7:0] G_MIN = 8'd0,
+    parameter [7:0] G_MAX = 8'd64,
+    parameter [7:0] B_MIN = 8'd0,
+    parameter [7:0] B_MAX = 8'd128,
+    parameter [7:0] S_DEF = 8'd32,
+    parameter integer MIN_PIX = 16,
+    parameter integer BOX_W = 2,
+    parameter integer BOX_FILL = 0,
+    parameter [23:0] BOX_COLOR = 24'h00FF00,
+    parameter integer VS_ACTIVE_LOW = 0,
+    parameter integer XW = (IMG_WIDTH <= 1) ? 1 : $clog2(IMG_WIDTH),
+    parameter integer YW = (IMG_HEIGHT <= 1) ? 1 : $clog2(IMG_HEIGHT),
+    parameter integer HIT_W = (IMG_WIDTH*IMG_HEIGHT <= 1) ? 1 : $clog2(IMG_WIDTH*IMG_HEIGHT+1),
+    parameter [7:0] R_SAT_MIN = 8'd192,
+    parameter integer SHAPE_FILTER_EN = 0,
+    parameter integer TARGET_SHAPE = 0,
+    parameter [7:0] ASPECT_MIN_Q44 = 8'd12,
+    parameter [7:0] ASPECT_MAX_Q44 = 8'd20,
+    parameter [8:0] FILL_MIN_Q8 = 9'd180,
+    parameter [8:0] FILL_MAX_Q8 = 9'd260,
+    parameter [7:0] SHAPE_TOL_Q8 = 8'd28,
+    parameter integer SHAPE_FILL_EN = 1,
+    // 交付包同款调试视图：1 = 命中像素画纯绿、未命中像素取原图>>2（变暗 1/4）。
+    // 生产配置为 0；置 1 时综合会常量折叠出独立视图通道，不增加 DSP/ERAM。
+    parameter integer DEBUG_VIEW = 0,
+    // Rule 4 is red-only. Q4 ratio 24 means R >= 1.5*G and R >= 1.5*B.
+    // Keep a calibration knob for the sensor noise floor and white-balance response.
+    parameter [7:0] RED_MIN = 8'd64,
+    parameter [4:0] RED_RATIO_Q4 = 5'd24,
+    parameter [7:0] RED_CHROMA_MIN = 8'd6
+)(
+    input  wire clk,
+    input  wire rst_n,
+    input  wire enable_in,
+    input  wire [23:0] rgb_in,
+    input  wire de_in,
+    input  wire hs_in,
+    input  wire vs_in,
+    input  wire [7:0] thr_in,
+    output reg [23:0] rgb_out,
+    output reg [7:0] y_out,
+    output reg bin_out,
+    output reg de_out,
+    output reg hs_out,
+    output reg vs_out,
+    output reg [XW-1:0] bbox_x_min,
+    output reg [XW-1:0] bbox_x_max,
+    output reg [YW-1:0] bbox_y_min,
+    output reg [YW-1:0] bbox_y_max,
+    output reg bbox_valid,
+    output reg [HIT_W-1:0] hit_cnt,
+    output reg [1:0] shape_type,
+    output reg shape_ok,
+    output reg bbox_valid_raw,
+    // These outputs are 0/1/2 range bands, not numeric ratios.
+    output reg [7:0] fill_ratio_q8,
+    output reg bbox_fresh, // current completed frame actually measured the selected object
+    output reg [7:0] aspect_ratio_q44
+);
+    localparam [XW-1:0] X_MAX = IMG_WIDTH-1;
+    localparam [YW-1:0] Y_MAX = IMG_HEIGHT-1;
+
+    generate if (((DET_RULE == 4) || (DET_RULE == 5) || (DET_RULE == 6)) && (TARGET_COLOR == 0) &&
+                 ((RED_MIN == 0) || (RED_RATIO_Q4 <= 16) ||
+                  ((DET_RULE >= 5) && (RED_CHROMA_MIN == 0)))) begin:g_bad_red_config
+        ERROR_COLOR_RED_MIN_OR_RATIO_CONFIGURATION invalid_configuration();
+    end endgenerate
+
+    wire [7:0] r = rgb_in[23:16];
+    wire [7:0] g = rgb_in[15:8];
+    wire [7:0] b = rgb_in[7:0];
+    wire [7:0] rg = (r > g) ? r-g : 8'd0;
+    wire [7:0] rb = (r > b) ? r-b : 8'd0;
+    wire [7:0] gr = (g > r) ? g-r : 8'd0;
+    wire [7:0] gb = (g > b) ? g-b : 8'd0;
+    wire [7:0] br = (b > r) ? b-r : 8'd0;
+    wire [7:0] bg = (b > g) ? b-g : 8'd0;
+    wire [7:0] threshold = (thr_in == 0) ? S_DEF : thr_in;
+    wire red_hit = (rg >= threshold) && (rb >= threshold);
+    wire green_hit = (gr >= threshold) && (gb >= threshold);
+    wire blue_hit = (br >= threshold) && (bg >= threshold);
+    wire abs_hit = (r >= R_MIN) && (r <= R_MAX) &&
+                   (g >= G_MIN) && (g <= G_MAX) &&
+                   (b >= B_MIN) && (b <= B_MAX);
+    wire rule2_red_hit = (rg >= threshold) && (r >= R_SAT_MIN);
+    wire rule2_green_hit = (gr >= threshold) && (g >= R_SAT_MIN);
+    wire rule2_blue_hit = (br >= threshold) && (b >= R_SAT_MIN);
+    wire rule2_hit = (TARGET_COLOR == 1) ? rule2_green_hit :
+                     (TARGET_COLOR == 2) ? rule2_blue_hit : rule2_red_hit;
+    // DET_RULE=3（交付包同款）= 规则2 + 保留"目标通道 vs 第三通道"的差分。
+    // 交付包注释明确：加回第三通道差分挡不住白炽灯（暖白 R-B 本来就大），
+    // 它的价值只在"画面里有青/品红类同亮度杂物"时收窄误判，故默认不开。
+    wire rule3_red_hit = rule2_red_hit && (rb >= threshold);
+    wire rule3_green_hit = rule2_green_hit && (gb >= threshold);
+    wire rule3_blue_hit = rule2_blue_hit && (bg >= threshold);
+    wire rule3_hit = (TARGET_COLOR == 1) ? rule3_green_hit :
+                     (TARGET_COLOR == 2) ? rule3_blue_hit : rule3_red_hit;
+    // 13 bits cover 31*255=7905. Constant-ratio products synthesize without division.
+    // G/B=0 needs no special case; the independent RED_MIN rejects dark noise.
+    wire [12:0] red_scaled = {1'b0, r, 4'b0000};
+    wire [12:0] green_scaled = RED_RATIO_Q4 * {5'b00000, g};
+    wire [12:0] blue_scaled = RED_RATIO_Q4 * {5'b00000, b};
+    wire relative_red_hit = (r >= RED_MIN) &&
+                            (red_scaled >= green_scaled) &&
+                            (red_scaled >= blue_scaled);
+    // A low ratio admits pale pink. Restrict hue around red to reject warm white
+    // and orange: 3*abs(G-B) <= R-min(G,B), equivalent to +/-20 degrees for R=max.
+    wire [7:0] gb_min = (g < b) ? g : b;
+    wire [7:0] red_chroma = (r > gb_min) ? r-gb_min : 8'd0;
+    wire [7:0] gb_delta = (g >= b) ? g-b : b-g;
+    wire [9:0] hue_distance = {2'b00, gb_delta} + {1'b0, gb_delta, 1'b0};
+    wire pink_red_hit = relative_red_hit && (red_chroma >= RED_CHROMA_MIN) &&
+                        (hue_distance <= {2'b00, red_chroma});
+    // Rule 6 retains the weak pink branch and admits a wider red hue only
+    // for strongly red-dominant pixels. No low-saturation skin expansion.
+    wire strong_red_hit=(r>=RED_MIN) && (red_chroma>=RED_CHROMA_MIN) &&
+                        ({1'b0,r,1'b0}>={2'b00,g}+{1'b0,g,1'b0}) &&
+                        ({1'b0,r,1'b0}>={2'b00,b}+{1'b0,b,1'b0}) &&
+                        ({1'b0,gb_delta,1'b0}<={2'b00,red_chroma});
+    wire color_hit = (DET_RULE == 1 || TARGET_COLOR == 3) ? abs_hit :
+                     (DET_RULE == 2) ? rule2_hit :
+                     (DET_RULE == 3) ? rule3_hit :
+                     (DET_RULE == 4 && TARGET_COLOR == 0) ? relative_red_hit :
+                     (DET_RULE == 5 && TARGET_COLOR == 0) ? pink_red_hit :
+                     (DET_RULE == 6 && TARGET_COLOR == 0) ? (pink_red_hit || strong_red_hit) :
+                     (TARGET_COLOR == 1) ? green_hit :
+                     (TARGET_COLOR == 2) ? blue_hit : red_hit;
+
+    wire vs_active = VS_ACTIVE_LOW ? ~vs_in : vs_in;
+    reg vs_active_d;
+    wire frame_start = vs_active && !vs_active_d;
+    reg de_d;
+    reg [XW-1:0] x_count;
+    reg [YW-1:0] y_count;
+
+    // DE按像素推进x，DE下降沿结束一行并推进y；VS有效沿重新定位帧首。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            vs_active_d <= 1'b0;
+            de_d <= 1'b0;
+            x_count <= 0;
+            y_count <= 0;
+        end else begin
+            vs_active_d <= vs_active;
+            de_d <= de_in;
+            if (frame_start) begin
+                x_count <= 0;
+                y_count <= 0;
+            end else if (de_in) begin
+                if (x_count == X_MAX) x_count <= 0;
+                else x_count <= x_count + 1'b1;
+            end else if (de_d) begin
+                x_count <= 0;
+                if (y_count == Y_MAX) y_count <= 0;
+                else y_count <= y_count + 1'b1;
+            end
+        end
+    end
+
+    wire [XW-1:0] region_x0,region_x1;
+    wire [YW-1:0] region_y0,region_y1;
+    wire [HIT_W-1:0] region_hits;
+    wire region_valid,region_overflow,region_fresh;
+    generate if(DET_RULE==6 && TARGET_COLOR==0) begin:g_regions
+        red_region_selector #(.IMG_WIDTH(IMG_WIDTH),.IMG_HEIGHT(IMG_HEIGHT),
+            .XW(XW),.YW(YW),.HIT_W(HIT_W),.MIN_PIX(MIN_PIX)) u_regions (
+            .clk(clk),.rst_n(rst_n),.enable_in(enable_in),.frame_start(frame_start),
+            .de_in(de_in),.hit_in(color_hit),.x_in(x_count),.y_in(y_count),
+            .x_min(region_x0),.x_max(region_x1),.y_min(region_y0),.y_max(region_y1),
+            .valid(region_valid),.measurement_valid(region_fresh),.hits(region_hits),.overflow(region_overflow));
+    end else begin:g_no_regions
+        assign region_x0=0;assign region_x1=0;assign region_y0=0;assign region_y1=0;
+        assign region_fresh=0;assign region_hits=0;assign region_valid=0;assign region_overflow=0;
+    end endgenerate
+
+    // 第一级：对齐原像素、检测结果、坐标和帧边界。
+    reg [23:0] rgb1;
+    reg [XW-1:0] x1;
+    reg [YW-1:0] y1;
+    reg hit1, enable1, de1, hs1, vs1, frame_start1;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb1 <= 0; x1 <= 0; y1 <= 0;
+            hit1 <= 0; enable1 <= 0; de1 <= 0; hs1 <= 0; vs1 <= 0; frame_start1 <= 0;
+        end else begin
+            rgb1 <= rgb_in;
+            x1 <= x_count;
+            y1 <= y_count;
+            hit1 <= color_hit;
+            enable1 <= enable_in;
+            de1 <= de_in; hs1 <= hs_in; vs1 <= vs_in;
+            frame_start1 <= frame_start;
+        end
+    end
+
+    reg [XW-1:0] stat_x_min, stat_x_max;
+    reg [YW-1:0] stat_y_min, stat_y_max;
+    reg [HIT_W-1:0] stat_hits;
+    reg stat_seen;
+    wire [XW-1:0] x_min_next = (!stat_seen || x1 < stat_x_min) ? x1 : stat_x_min;
+    wire [XW-1:0] x_max_next = (!stat_seen || x1 > stat_x_max) ? x1 : stat_x_max;
+    wire [YW-1:0] y_min_next = (!stat_seen || y1 < stat_y_min) ? y1 : stat_y_min;
+    wire [YW-1:0] y_max_next = (!stat_seen || y1 > stat_y_max) ? y1 : stat_y_max;
+    wire hit1_valid = de1 && hit1;
+    wire [XW-1:0] publish_x_min = (hit1_valid && enable1) ? x_min_next : stat_x_min;
+    wire [XW-1:0] publish_x_max = (hit1_valid && enable1) ? x_max_next : stat_x_max;
+    wire [YW-1:0] publish_y_min = (hit1_valid && enable1) ? y_min_next : stat_y_min;
+    wire [YW-1:0] publish_y_max = (hit1_valid && enable1) ? y_max_next : stat_y_max;
+    wire [HIT_W-1:0] publish_hits = stat_hits + ((hit1_valid && enable1) ? 1'b1 : 1'b0);
+    wire publish_seen = stat_seen || (hit1_valid && enable1);
+
+    // Shape geometry is evaluated from the same current-frame values that are
+    // published at frame_start1, including a hit on the final active pixel.
+    localparam integer FW_W = XW + 1;
+    localparam integer FH_W = YW + 1;
+    localparam integer AREA_W = FW_W + FH_W;
+    localparam integer ASPECT_W = ((FW_W + 4) > (FH_W + 8)) ? (FW_W + 4) : (FH_W + 8);
+    localparam integer SHAPE_PROD_W = AREA_W + 9;
+    localparam integer SHAPE_CMP_W = ((SHAPE_PROD_W) > (HIT_W + 8)) ? SHAPE_PROD_W : (HIT_W + 8);
+    wire [FW_W-1:0] shape_w = publish_seen ?
+        ({1'b0, publish_x_max} - {1'b0, publish_x_min} + {{XW{1'b0}}, 1'b1}) : {FW_W{1'b0}};
+    wire [FH_W-1:0] shape_h = publish_seen ?
+        ({1'b0, publish_y_max} - {1'b0, publish_y_min} + {{YW{1'b0}}, 1'b1}) : {FH_W{1'b0}};
+    wire [ASPECT_W-1:0] shape_w16 = {shape_w, 4'b0};
+    wire [ASPECT_W-1:0] aspect_min_h = ASPECT_MIN_Q44 * shape_h;
+    wire [ASPECT_W-1:0] aspect_max_h = ASPECT_MAX_Q44 * shape_h;
+    wire aspect_pass = publish_seen && (shape_w != 0) && (shape_h != 0) &&
+                       (shape_w16 >= aspect_min_h) && (shape_w16 <= aspect_max_h);
+
+    wire [AREA_W-1:0] shape_w_ext = shape_w;
+    wire [AREA_W-1:0] shape_h_ext = shape_h;
+    wire [2*AREA_W-1:0] shape_area_full = shape_w_ext * shape_h_ext;
+    wire [AREA_W-1:0] shape_area = shape_area_full[AREA_W-1:0];
+    wire [SHAPE_PROD_W-1:0] area_ext = shape_area;
+    wire [SHAPE_PROD_W-1:0] fill_min_ext = FILL_MIN_Q8;
+    wire [SHAPE_PROD_W-1:0] fill_max_ext = FILL_MAX_Q8;
+    wire [2*SHAPE_PROD_W-1:0] fill_min_full = fill_min_ext * area_ext;
+    wire [2*SHAPE_PROD_W-1:0] fill_max_full = fill_max_ext * area_ext;
+    wire [SHAPE_PROD_W-1:0] fill_min_area = fill_min_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_PROD_W-1:0] fill_max_area = fill_max_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_CMP_W-1:0] shape_hits256 =
+        {{(SHAPE_CMP_W-HIT_W-8){1'b0}}, publish_hits, 8'b0};
+    wire [SHAPE_CMP_W-1:0] fill_min_cmp = fill_min_area;
+    wire [SHAPE_CMP_W-1:0] fill_max_cmp = fill_max_area;
+    wire fill_pass = (SHAPE_FILL_EN == 0) ||
+                     (publish_seen && (shape_area != 0) &&
+                      (shape_hits256 >= fill_min_cmp) && (shape_hits256 <= fill_max_cmp));
+
+    localparam [8:0] RECT_MIN_Q8 = (SHAPE_TOL_Q8 >= 8'd255) ? 9'd0 : (9'd255 - SHAPE_TOL_Q8);
+    localparam [8:0] CIRC_MIN_Q8 = (SHAPE_TOL_Q8 >= 8'd201) ? 9'd0 : (9'd201 - SHAPE_TOL_Q8);
+    localparam [8:0] CIRC_MAX_Q8 = 9'd201 + SHAPE_TOL_Q8;
+    localparam [8:0] TRI_MIN_Q8 = (SHAPE_TOL_Q8 >= 8'd128) ? 9'd0 : (9'd128 - SHAPE_TOL_Q8);
+    localparam [8:0] TRI_MAX_Q8 = 9'd128 + SHAPE_TOL_Q8;
+    wire [SHAPE_PROD_W-1:0] rect_min_ext = RECT_MIN_Q8;
+    wire [SHAPE_PROD_W-1:0] circ_min_ext = CIRC_MIN_Q8;
+    wire [SHAPE_PROD_W-1:0] circ_max_ext = CIRC_MAX_Q8;
+    wire [SHAPE_PROD_W-1:0] tri_min_ext = TRI_MIN_Q8;
+    wire [SHAPE_PROD_W-1:0] tri_max_ext = TRI_MAX_Q8;
+    wire [2*SHAPE_PROD_W-1:0] rect_min_full = rect_min_ext * area_ext;
+    wire [2*SHAPE_PROD_W-1:0] circ_min_full = circ_min_ext * area_ext;
+    wire [2*SHAPE_PROD_W-1:0] circ_max_full = circ_max_ext * area_ext;
+    wire [2*SHAPE_PROD_W-1:0] tri_min_full = tri_min_ext * area_ext;
+    wire [2*SHAPE_PROD_W-1:0] tri_max_full = tri_max_ext * area_ext;
+    wire [SHAPE_PROD_W-1:0] rect_min_area = rect_min_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_PROD_W-1:0] circ_min_area = circ_min_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_PROD_W-1:0] circ_max_area = circ_max_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_PROD_W-1:0] tri_min_area = tri_min_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_PROD_W-1:0] tri_max_area = tri_max_full[SHAPE_PROD_W-1:0];
+    wire [SHAPE_CMP_W-1:0] rect_min_cmp = rect_min_area;
+    wire [SHAPE_CMP_W-1:0] circ_min_cmp = circ_min_area;
+    wire [SHAPE_CMP_W-1:0] circ_max_cmp = circ_max_area;
+    wire [SHAPE_CMP_W-1:0] tri_min_cmp = tri_min_area;
+    wire [SHAPE_CMP_W-1:0] tri_max_cmp = tri_max_area;
+    wire classify_rect = publish_seen && (shape_area != 0) && (shape_hits256 >= rect_min_cmp);
+    wire classify_circle = publish_seen && (shape_area != 0) &&
+                           (shape_hits256 >= circ_min_cmp) && (shape_hits256 <= circ_max_cmp);
+    wire classify_triangle = publish_seen && (shape_area != 0) &&
+                             (shape_hits256 >= tri_min_cmp) && (shape_hits256 <= tri_max_cmp);
+    wire [1:0] shape_type_now = classify_rect ? 2'd1 : classify_circle ? 2'd2 :
+                                classify_triangle ? 2'd3 : 2'd0;
+    wire shape_pass = aspect_pass && fill_pass &&
+                      ((TARGET_SHAPE == 0) || (shape_type_now == TARGET_SHAPE[1:0]));
+    wire [7:0] aspect_band = !publish_seen || (shape_h == 0) ? 8'd0 :
+                             (shape_w16 < aspect_min_h) ? 8'd0 :
+                             (shape_w16 > aspect_max_h) ? 8'd2 : 8'd1;
+    wire [7:0] fill_band = (SHAPE_FILL_EN == 0) ? 8'd1 :
+                            (!publish_seen || (shape_area == 0)) ? 8'd0 :
+                            (shape_hits256 < fill_min_cmp) ? 8'd0 :
+                            (shape_hits256 > fill_max_cmp) ? 8'd2 : 8'd1;
+    wire publish_raw_valid = publish_seen && (publish_hits >= MIN_PIX);
+    wire publish_shape_valid = publish_raw_valid &&
+                               ((SHAPE_FILTER_EN == 0) || shape_pass);
+
+    // 消费stage1数据。若VS紧随最后一个输入像素，其统计仍先进入本级再发布。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            stat_x_min <= {XW{1'b1}}; stat_x_max <= 0;
+            stat_y_min <= {YW{1'b1}}; stat_y_max <= 0;
+            stat_hits <= 0; stat_seen <= 0;
+            bbox_x_min <= 0; bbox_x_max <= 0; bbox_y_min <= 0; bbox_y_max <= 0;
+            bbox_fresh <= 0; bbox_valid <= 0; hit_cnt <= 0;
+            shape_type <= 0; shape_ok <= 0; bbox_valid_raw <= 0;
+            fill_ratio_q8 <= 0; aspect_ratio_q44 <= 0;
+        end else if (!enable_in || (frame_start1 && !enable1)) begin
+            stat_x_min <= {XW{1'b1}}; stat_x_max <= 0;
+            stat_y_min <= {YW{1'b1}}; stat_y_max <= 0;
+            stat_hits <= 0; stat_seen <= 0;
+            bbox_x_min <= 0; bbox_x_max <= 0; bbox_y_min <= 0; bbox_y_max <= 0;
+            bbox_fresh <= 0; bbox_valid <= 0; hit_cnt <= 0;
+            shape_type <= 0; shape_ok <= 0; bbox_valid_raw <= 0;
+            fill_ratio_q8 <= 0; aspect_ratio_q44 <= 0;
+        end else if (DET_RULE==6 && TARGET_COLOR==0) begin
+            bbox_x_min<=region_x0;bbox_x_max<=region_x1;
+            bbox_y_min<=region_y0;bbox_y_max<=region_y1;bbox_valid<=region_valid;
+            bbox_fresh<=region_fresh;
+            bbox_valid_raw<=region_valid;shape_ok<=region_valid;shape_type<=0;hit_cnt<=region_hits;
+            fill_ratio_q8<=region_valid?1:0;aspect_ratio_q44<=region_valid?1:0;
+        end else if (frame_start1) begin
+            bbox_fresh <= publish_shape_valid;
+            bbox_valid <= publish_shape_valid;
+            bbox_valid_raw <= publish_raw_valid;
+            shape_type <= publish_raw_valid ? shape_type_now : 2'd0;
+            shape_ok <= publish_shape_valid;
+            fill_ratio_q8 <= fill_band;
+            aspect_ratio_q44 <= aspect_band;
+            bbox_x_min <= publish_raw_valid ? publish_x_min : 0;
+            bbox_x_max <= publish_raw_valid ? publish_x_max : 0;
+            bbox_y_min <= publish_raw_valid ? publish_y_min : 0;
+            bbox_y_max <= publish_raw_valid ? publish_y_max : 0;
+            hit_cnt <= publish_hits;
+            stat_x_min <= {XW{1'b1}}; stat_x_max <= 0;
+            stat_y_min <= {YW{1'b1}}; stat_y_max <= 0;
+            stat_hits <= 0; stat_seen <= 0;
+        end else if (hit1_valid && enable1) begin
+            stat_x_min <= x_min_next; stat_x_max <= x_max_next;
+            stat_y_min <= y_min_next; stat_y_max <= y_max_next;
+            stat_hits <= stat_hits + 1'b1;
+            stat_seen <= 1'b1;
+        end
+    end
+
+    // 第二级：用稳定的上一帧bbox判断框边，避免比较链进入帧统计反馈。
+    reg [23:0] rgb2;
+    reg hit2, enable2, de2, hs2, vs2, box2;
+    reg [XW-1:0] x2;
+    reg [YW-1:0] y2;
+    wire in_span = bbox_valid && x1 >= bbox_x_min && x1 <= bbox_x_max &&
+                   y1 >= bbox_y_min && y1 <= bbox_y_max;
+    wire on_edge = ((x1 - bbox_x_min) < BOX_W) || ((bbox_x_max - x1) < BOX_W) ||
+                   ((y1 - bbox_y_min) < BOX_W) || ((bbox_y_max - y1) < BOX_W);
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb2 <= 0; hit2 <= 0; enable2 <= 0; de2 <= 0; hs2 <= 0; vs2 <= 0; box2 <= 0;
+            x2 <= 0; y2 <= 0;
+        end else begin
+            rgb2 <= rgb1; hit2 <= hit1; enable2 <= enable1; de2 <= de1; hs2 <= hs1; vs2 <= vs1;
+            x2 <= x1; y2 <= y1;
+            box2 <= in_span && (BOX_FILL || on_edge);
+        end
+    end
+
+    // 第三级：输出图像、掩膜与同步；RGB原图逐位保持。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 0; y_out <= 0; bin_out <= 0;
+            de_out <= 0; hs_out <= 0; vs_out <= 0;
+        end else begin
+            // DEBUG_VIEW（交付包同款）：命中=纯绿，未命中=原图右移2位（变暗1/4），
+            // 用于现场调颜色阈值；生产 DEBUG_VIEW=0 时该分支被常量折叠。
+            rgb_out <= DEBUG_VIEW ? (hit2 ? 24'h00ff00 : {2'b00, rgb2[23:2]}) :
+                       ((enable2 && de2 && box2) ? BOX_COLOR : rgb2);
+            y_out <= hit2 ? 8'hff : 8'h00;
+            bin_out <= hit2;
+            de_out <= de2; hs_out <= hs2; vs_out <= vs2;
+        end
+    end
+endmodule
--- v8/user_source/algorithms/algo_contrast.v
+++ fusion/user_source/algorithms/algo_contrast.v
@@ -0,0 +1,70 @@
+// algo_contrast.v —— 算法5 子模式②：对比度增强（mode = 0101）
+// 【解决的问题】目标和背景灰度接近（低对比度），边界看不清。
+// 【方案：以中灰 128 为轴的线性拉伸】
+//       Y' = sat( (Y - 128) * gain / 16 + 128 )
+//  128 为轴：128 是 8bit 灰度的中点，拉伸时把中灰固定、亮部更亮暗部更暗，
+//   整体平均亮度不变（画面不会整体变亮变暗，只"变冲"）。
+// 【增益范围与量化】thr_in[7:0] = Q4.4 增益（16 = ×1.0）：
+//     thr_in = 16 → ×1.0（恒等，锚点）
+//              20 → ×1.25     24 → ×1.5      32 → ×2.0      48 → ×3.0
+//              0  → ×0.0（全部压到中灰 128 附近 ⇒ 整幅变灰，可用于反向演示）
+//    推荐演示给 24~32；
+//    范围取 0~15.9（Q4.4 而不是 Q3.5）：×2.0 是常用档，Q4.4 里 32 整除无误差；
+//    再大的增益（×4 以上）对 8bit 图像没有意义（一步就饱和）。
+//    定点化位宽：8bit 增益 × 8bit 灰度 = 16bit 乘积，右移 4 位后 12bit，
+//    与位宽核算一致（见 algo_level.v 头注释），无中间溢出。
+//
+// 【与亮度增强的关系：能合并，已经合并了】
+//   两者都是 Y' = sat( (Y - CENTER) * gain / 2^SHIFT + CENTER + ADD )：
+//     CENTER = 0   → 亮度增强（保黑点）
+//     CENTER = 128 → 对比度增强（保中灰）
+//   本文件与 algo_bright.v 都是 **algo_level.v 的一行例化**（只差 CENTER/ADD 两个参数），
+//   综合出来的逻辑各自独立、可单独演示，但真值来源只有一份。
+//
+// 【输出/延时】与 algo_bright 完全一致：rgb 彩色（未发生通道饱和时 Δ 色差保持）+ y_out + bin_out(饱和标志)；
+//   固定 3 拍，de/hs/vs 同延 3 拍。
+//=============================================================================
+// 来源：算法5交付包原 wrapper，保留默认增益与 Δ 色差保持公式，仅改为 RGB888 输入。
+// 流水延迟：灰度 2 级 + 变换/输出 1 级，总计 3 级；thr_in 与像素同拍对齐。
+`timescale 1ns/1ps
+
+module algo_contrast #(
+    parameter GRAY_MODE    = 0,
+    parameter CONTRAST_ADD = 0,     // 加性偏移 0~127（默认 0；>0 = 拉完再整体提亮）
+    parameter RGB_MODE     = 0      // 0 = Δ 色差保持（默认）；1 = 三通道各自乘增益
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        hs_in,
+    input  wire        vs_in,
+    input  wire [7:0]  thr_in,      // ★ Q4.4 对比度增益（16 = ×1.0）
+
+    output wire [23:0] rgb_out,
+    output wire [7:0]  y_out,
+    output wire        bin_out,
+    output wire        de_out,
+    output wire        hs_out,
+    output wire        vs_out
+);
+
+    algo_level #(
+        .GRAY_MODE  (GRAY_MODE),
+        .CENTER     (128),              // ★ 中心 = 128 ⇒ 以中灰为轴拉伸 = 对比度增强
+        .ADD        (CONTRAST_ADD),
+        .GAIN_SHIFT (4),
+        .RGB_MODE   (RGB_MODE)
+    ) u_core (
+        .clk     (clk),    .rst_n  (rst_n),
+        .rgb_in  (rgb_in),
+        .de_in   (de_in),  .hs_in  (hs_in), .vs_in (vs_in),
+        .thr_in  (thr_in),
+        .rgb_out (rgb_out),
+        .y_out   (y_out),
+        .bin_out (bin_out),
+        .de_out  (de_out), .hs_out (hs_out), .vs_out (vs_out)
+    );
+
+endmodule
--- v8/user_source/algorithms/algo_edge_polar.v
+++ fusion/user_source/algorithms/algo_edge_polar.v
@@ -0,0 +1,167 @@
+//=============================================================================
+// 算法9：偏振辅助边缘检测（mode 12）
+// 输入来自 DDR 读出的极化核心像素流：polar_core 25 级输出 y 与 DoLP 同拍。
+// y_in=(i0+i90)>>1；Y 与 DoLP 两路分别计算 Sobel G8。
+// vin 可连续 16 个像素后停顿任意长度；空白期间行列状态保持，HS 标记行首。
+// 使用 G8=(|Gx|+|Gy|)>>3，公式与普通 Sobel 同定标，但输入量不同，不承诺逐像素相同。
+// polar_core 25 级 + 本模块 3 级 = 28 级。默认加权融合后饱和到 255 再比较阈值。
+// W_DOLP=0 时 weighted 模式仍执行权重公式；需要纯 Y 边缘时设置 EDGE_MODE=0。
+//=============================================================================
+`timescale 1ns/1ps
+
+module algo_edge_polar #(
+    parameter EDGE_MODE = 1,        // 0 = 仅 Sobel(亮度)；1 = 亮度 + DoLP 双路融合（默认）
+    parameter FUSE_MODE = 0,        // 0 = 加权和（推荐）；1 = 取最大
+    parameter W_RGB     = 8'd192,   // 融合权重（编译期；建议和 ≈ 256）
+    parameter W_DOLP    = 8'd64,    // weighted 模式按公式使用；纯 Y 边缘请设 EDGE_MODE=0
+    parameter EDGE_INV  = 0,        // 1 = 反色输出
+    parameter BORDER    = 1,        // 1 = 复制边缘（默认，推荐）；0 = 补零
+    parameter LB_W      = 1280,      // 一行宽度（= IMG_W）
+    parameter LB_DEPTH  = 2048,     // 行缓存深度，必须 >= LB_W+1
+    parameter LB_AW     = 11        // = log2(LB_DEPTH)
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    // ---- DDR/极化核心输出，两路数据与 vin 同拍 ----
+    input  wire [7:0]  y_in,        // y=(i0+i90)>>1
+    input  wire [7:0]  dolp_in,     // DoLP8（算法7 的 dolp_out）
+    input  wire        vin,         // 像素有效；可连续 16 像素后任意长度停顿
+    input  wire        hs_in,       // 行首脉冲（同源）
+    input  wire        vs_in,       // 帧首脉冲（同源，1 拍宽）
+
+    input  wire [7:0]  thr_in,      // 边缘二值阈值（比较对象是 G8 = |G|>>3，0~255）
+
+    output reg  [23:0] rgb_out,     // 边缘图：bin ? 白 : 黑
+    output reg  [7:0]  y_out,       // 融合后边缘强度（给算法10/11 复用）
+    output reg  [7:0]  e_rgb_out,   // 亮度支路边缘强度（调试/复用）
+    output reg  [7:0]  e_dolp_out,  // DoLP 支路边缘强度
+    output reg         bin_out,     // 边缘二值
+    output reg         de_out,
+    output reg         hs_out,
+    output reg         vs_out
+);
+
+    //=================================================================
+    // 0) 从"1 拍宽 vs 脉冲"重建"场消隐电平"给行缓存
+    //    line_buffer_3x3_sparse 期望 vs 是**电平**（VS_ACTIVE_LOW=1 ⇒ 帧起始区间内为 0），
+    //    而总线上 vs 是 1 拍脉冲 ⇒ 这里做成："vs 脉冲之后 ~ 第一条 hs 之前"为 0，其余为 1。
+    //=================================================================
+    reg vs_lvl;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)          vs_lvl <= 1'b0;
+        else if (vs_in)      vs_lvl <= 1'b1;      // 收到 vs 脉冲 ⇒ 进入帧起始区间
+        else if (hs_in)      vs_lvl <= 1'b0;      // 第一条 hs ⇒ 区间结束
+    end
+    wire lb_vs = ~vs_lvl;
+
+    //=================================================================
+    // 1) 一份行缓存（DW=16）同时给出两路 3x3 窗口（稀疏 de 模式）
+    //=================================================================
+    wire [15:0] lb_din = {y_in, dolp_in};
+    wire [15:0] q00, q01, q02, q10, q11, q12, q20, q21, q22;
+    wire        lb_de, lb_hs, lb_vs_o;
+
+    line_buffer_3x3_sparse #(
+        .DW         (16),
+        .LB_W       (LB_W),
+        .LB_DEPTH   (LB_DEPTH),
+        .LB_AW      (LB_AW),
+        .BORDER     (BORDER),
+        .VS_ACTIVE_LOW (1),
+        .SPARSE_EN  (1)                     // ★ 稀疏 de：行边界用 hs_in
+    ) u_lb (
+        .clk (clk), .rst_n (rst_n),
+        .din (lb_din), .de_in (vin), .hs_in (hs_in), .vs_in (lb_vs),
+        .p00 (q00), .p01 (q01), .p02 (q02),
+        .p10 (q10), .p11 (q11), .p12 (q12),
+        .p20 (q20), .p21 (q21), .p22 (q22),
+        .de_out (lb_de), .hs_out (lb_hs), .vs_out (lb_vs_o),
+        .col_out (), .row_out ()
+    );
+
+    // 拆出两路的窗口
+    wire [7:0] y00=q00[15:8], y01=q01[15:8], y02=q02[15:8];
+    wire [7:0] y10=q10[15:8], y11=q11[15:8], y12=q12[15:8];
+    wire [7:0] y20=q20[15:8], y21=q21[15:8], y22=q22[15:8];
+    wire [7:0] d00=q00[7:0],  d01=q01[7:0],  d02=q02[7:0];
+    wire [7:0] d10=q10[7:0],  d11=q11[7:0],  d12=q12[7:0];
+    wire [7:0] d20=q20[7:0],  d21=q21[7:0],  d22=q22[7:0];
+
+    //=================================================================
+    // 2) Sobel 核：返回 |Gx|+|Gy| ≤ 2040，G8 对输入强度右移 3 位
+    //=================================================================
+    function [10:0] sobel_abs;
+        input [7:0] a00,a01,a02, a10,a11,a12, a20,a21,a22;
+        reg [9:0] gr, gl, gt, gb;
+        reg signed [10:0] gx, gy;
+        begin
+            gr = {2'b00,a02} + ({2'b00,a12} << 1) + {2'b00,a22};   // 右列加权和
+            gl = {2'b00,a00} + ({2'b00,a10} << 1) + {2'b00,a20};   // 左列加权和
+            gt = {2'b00,a00} + ({2'b00,a01} << 1) + {2'b00,a02};   // 上行加权和
+            gb = {2'b00,a20} + ({2'b00,a21} << 1) + {2'b00,a22};   // 下行加权和
+            gx = {1'b0, gr} - {1'b0, gl};                          // ±1020
+            gy = {1'b0, gt} - {1'b0, gb};                          // ±1020
+            sobel_abs = (gx[10] ? (~gx + 11'd1) : gx) + (gy[10] ? (~gy + 11'd1) : gy);
+        end
+    endfunction
+
+    wire [10:0] s_y = sobel_abs(y00,y01,y02,y10,y11,y12,y20,y21,y22);
+    wire [10:0] s_d = sobel_abs(d00,d01,d02,d10,d11,d12,d20,d21,d22);
+    wire [7:0]  g8_y = s_y[10:3];        // >>3 ⇒ 0~255
+    wire [7:0]  g8_d = s_d[10:3];
+
+    //=================================================================
+    // 3) 第 2 拍：登记两路边缘强度（+ 同步头/thr 跟进）
+    //=================================================================
+    reg [7:0] e_y1, e_d1;
+    reg       de1, hs1, vs1, vs_pulse_d1;
+    reg [7:0] thr1, thr2r;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            e_y1 <= 8'd0; e_d1 <= 8'd0; de1 <= 1'b0; hs1 <= 1'b0;
+            vs1 <= 1'b0; vs_pulse_d1 <= 1'b0;
+            thr1 <= 8'd0; thr2r <= 8'd0;
+        end else begin
+            e_y1 <= g8_y;  e_d1 <= g8_d;  de1 <= lb_de;
+            hs1  <= lb_hs;
+            // lb_vs_o is the reconstructed blanking level; preserve the input VS pulse separately.
+            vs_pulse_d1 <= vs_in;
+            vs1 <= vs_pulse_d1;
+            // 阈值链：2 级自由推进（与"比较发生在第 2 级组合逻辑"对上 —— 见下）
+            //   thr 与输入按时钟推进，使阈值和对应像素在输出级相遇；停顿长度不受限。
+            thr1  <= thr_in;
+            thr2r <= thr1;
+        end
+    end
+
+    //=================================================================
+    // 4) 第 3 拍：融合 → 二值 → 输出
+    //=================================================================
+    wire [7:0] e_d_used = EDGE_MODE ? e_d1 : 8'd0;          // EDGE_MODE=0 ⇒ 仅亮度
+    wire [16:0] fsum = ({9'd0, W_RGB} * e_y1) + ({9'd0, W_DOLP} * e_d_used);
+    // ★ EDGE_MODE=0（仅亮度）直接输出亮度支路；W_DOLP=0 仍按 W_RGB 加权：
+    //   weighted 模式下不因 W_DOLP=0 改变加权公式。
+    wire [7:0]  e_fuse = (EDGE_MODE == 0) ? e_y1 :
+                         (FUSE_MODE ? ((e_y1 > e_d_used) ? e_y1 : e_d_used)
+                                    : ((fsum[16:8] > 9'd255) ? 8'hFF : fsum[15:8]));
+
+    wire bin_c = EDGE_INV ? (e_fuse < thr2r) : (e_fuse >= thr2r);
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 24'd0; y_out <= 8'd0; e_rgb_out <= 8'd0; e_dolp_out <= 8'd0;
+            bin_out <= 1'b0; de_out <= 1'b0; hs_out <= 1'b0; vs_out <= 1'b0;
+        end else begin
+            y_out     <= e_fuse;
+            e_rgb_out <= e_y1;
+            e_dolp_out<= e_d_used;
+            rgb_out   <= bin_c ? 24'hFFFFFF : 24'h000000;
+            bin_out   <= bin_c;
+            de_out    <= de1;
+            hs_out    <= hs1;
+            vs_out    <= vs1;
+        end
+    end
+
+endmodule
--- v8/user_source/algorithms/algo_fusion.v
+++ fusion/user_source/algorithms/algo_fusion.v
@@ -0,0 +1,166 @@
+// 算法8：RGB、DoLP、AoP同拍输入的融合模块，改编自算法8交付包。
+// 本工程algo_polar_core同时接收四角度RGB888与光强，每拍可处理一组坐标。
+// algo_polar_fusion串接25级偏振核与本模块2级寄存器，组合共27级。
+// rgb_unpol_in名称沿用交付接口，实际是四角度平均RGB，不构成去反光保证。
+// y_unpol_in是与该RGB/DoLP/AoP对应的亮度参考；三路须同位置、同拍。
+// FUSION_MODE=0用DoLP调制亮度，1定点加权，2取max；AOP_HUE选择方向伪彩。
+// thr_in低7位为K（0回落K_DEF），最高位0抑制、1增强。
+// 饱和RGB加保留未饱和通道的色差，饱和后颜色关系可能改变。
+// 本模块由板级顶层的模式11偏振处理链调用，不单独增加按键显示模式或引脚。
+`timescale 1ns/1ps
+
+module algo_fusion #(
+    parameter FUSION_MODE = 0,          // 0=DoLP 引导增益 1=三通道加权和 2=max
+    parameter K_DEF       = 7'd64,      // MODE0 默认 K（thr_in[6:0] 会在运行时覆盖它）
+    parameter W_RGB       = 8'd128,     // MODE1 权重（编译期；建议三者之和 ≈ 256）
+    parameter W_DOLP      = 8'd96,
+    parameter W_AOP       = 8'd32,      //   ★ 建议默认 0：AoP 是角度，线性加权有 180° 接缝
+    parameter AOP_HUE     = 0,          // 0=保留四角度平均RGB 1=AoP 方向伪彩
+    parameter BIN_THR     = 8'd128      // bin_out：DoLP ≥ 此值判"强偏振/反光"
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    // ---- 三路输入：由 algo_polar 同拍给出（已在源头对齐；无需行/帧缓存）----
+    input  wire [23:0] rgb_unpol_in,    // 四角度样本平均 RGB
+    input  wire [7:0]  y_unpol_in,      // 配对和亮度参考（= S0/2）
+    input  wire [7:0]  dolp_in,         // DoLP8
+    input  wire [7:0]  aop_in,          // AoP8
+    input  wire        vin,             // 三路共用的有效脉冲（= algo_polar 的 de_out）
+    input  wire        hs_in, vs_in,    // 同源同步头
+    input  wire [7:0]  thr_in,          // [6:0]=偏振强度 K；[7]=极性(0 抑制/1 增强)
+
+    // ---- 输出 ----
+    output reg  [23:0] rgb_out,         // 融合结果（彩色；AOP_HUE=1 时为方向伪彩）
+    output reg  [7:0]  y_out,           // 融合亮度 8bit（给算法9 做偏振辅助边缘）
+    output reg  [7:0]  dolp_out,        // DoLP8 直通（算法9 要用）
+    output reg  [7:0]  aop_out,         // AoP8 直通（后续算法/伪彩可用）
+    output reg         bin_out,         // DoLP ≥ BIN_THR 的"强偏振/反光"掩膜
+    output reg         de_out,          // 与vin对应，支持每拍一像素，延迟2级
+    output reg         hs_out,
+    output reg         vs_out
+);
+
+    //=================================================================
+    // 统一把三路拆分好，按 FUSION_MODE 算融合亮度
+    //=================================================================
+    wire [7:0] yr = y_unpol_in;                       // 配对和亮度参考
+    wire [7:0] rr = rgb_unpol_in[23:16];
+    wire [7:0] gr = rgb_unpol_in[15:8];
+    wire [7:0] br = rgb_unpol_in[7:0];
+
+    wire [6:0] k7     = (thr_in[6:0] == 7'd0) ? K_DEF : thr_in[6:0];   // 全零则用参数默认值
+    wire       inc    = thr_in[7];                    // 0=抑制偏振 1=增强偏振
+
+    //---- MODE 0：DoLP 引导自适应增益 ----
+    wire [14:0] gterm = k7 * dolp_in;                 // ≤127×255 = 32385
+    wire [8:0]  gadj  = gterm[14:7];                  // ≤253
+    wire [9:0]  gain0 = inc ? (10'd256 + {1'b0, gadj})      // 增强偏振（反光更亮）
+                            : (10'd256 - {1'b0, gadj});      // 降低高 DoLP 像素亮度
+    wire [16:0] ypre0 = yr * gain0[8:0];              // ≤255×509 = 129795（17bit 不溢出）
+    wire [7:0]  y0    = (ypre0[16:8] > 8'd255) ? 8'hFF : ypre0[16:8];   // 饱和（不环绕）
+
+    //---- MODE 1：三通道定点加权和（全常数乘法 ⇒ 0 DSP）----
+    wire [17:0] wsum = ({10'b0, W_RGB}  * yr)
+                     + ({10'b0, W_DOLP} * dolp_in)
+                     + ({10'b0, W_AOP}  * aop_in);
+    wire [7:0]  y1   = (wsum[17:8] > 8'd255) ? 8'hFF : wsum[15:8];
+
+    //---- MODE 2：max(Y, DoLP) ----
+    wire [7:0]  y2   = (yr > dolp_in) ? yr : dolp_in;
+
+    wire [7:0] yf = (FUSION_MODE == 0) ? y0 : (FUSION_MODE == 1) ? y1 : y2;
+
+    //---- 亮度差值；未饱和通道保留色差，饱和裁剪可能改变色差 ----
+    wire signed [8:0] dlt = $signed({1'b0, yf}) - $signed({1'b0, yr});
+    function [7:0] satadd;
+        input [7:0] c;  input signed [8:0] d;
+        reg signed [9:0] t;
+        begin
+            t = $signed({1'b0, c}) + d;
+            if (t[9] == 1'b1)      satadd = 8'd0;        // 下溢 ⇒ 钉 0
+            else if (t > 10'sd255) satadd = 8'hFF;       // 上溢 ⇒ 钉 255
+            else                   satadd = t[7:0];
+        end
+    endfunction
+
+    // （Δ 保持的饱和加放在第二级：r2/g2/b2）
+
+    //=================================================================
+    // AoP 方向伪彩（可选）：256×24 色环（0..255 映射 0..360°）× 融合亮度
+    //=================================================================
+    function [23:0] hue_wheel;               // 生成方式固定、可复现（见交付说明）
+        input [7:0] a;
+        reg [7:0] h;  reg [7:0] q;  reg [7:0] t;
+        begin
+            h = a;                                        // 0..255 → 色相环
+            q = (h >> 6);                                 // 4 段（每段 64）
+            t = (h & 8'h3F) << 2;                         // 0..252
+            case (q)
+            2'd0: hue_wheel = {8'hFF, t,     8'h00};      // R→G
+            2'd1: hue_wheel = {8'hFF-t, 8'hFF, 8'h00};    // G→R 减
+            2'd2: hue_wheel = {8'h00, 8'hFF, t};          // B→
+            default: hue_wheel = {t, 8'h00, 8'hFF};       // R→
+            endcase
+        end
+    endfunction
+
+    //=================================================================
+    // 输出：**两级、valid 全程跟着走**（延时固定 2 拍，像素与 de_out 同拍）
+    //   ★ 踩过的坑：第一版把 rgb_out 写成"每拍都登记组合结果"、de_out 走两级，
+    //     结果像素比 de_out 早一拍 ⇒ 输出与同步头错位（TB 里表现为"看到的不是那个像素"）。
+    //     纪律：输出登记必须与它的 valid 在同一个沿、同一级。
+    //=================================================================
+    reg        v1r, hs1r, vs1r;
+    reg [7:0]  y1r, dolp1r, aop1r;
+    reg signed [8:0] dl1r;                    // Δ = Y' − Y（第一级算好，第二级只做饱和加）
+    reg [23:0] col1r;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            v1r <= 1'b0; hs1r <= 1'b0; vs1r <= 1'b0;
+            y1r <= 8'd0; dolp1r <= 8'd0; aop1r <= 8'd0; dl1r <= 9'sd0; col1r <= 24'd0;
+        end else begin
+            v1r    <= vin;
+            hs1r   <= hs_in;
+            vs1r   <= vs_in;
+            y1r    <= yf;
+            dolp1r <= dolp_in;
+            aop1r  <= aop_in;
+            dl1r   <= dlt;
+            col1r  <= rgb_unpol_in;
+        end
+    end
+
+    // 第二级：Δ 保持（或 AoP 伪彩），与 de_out 同沿登记
+    wire [7:0] r2 = satadd(col1r[23:16], dl1r);
+    wire [7:0] g2 = satadd(col1r[15:8],  dl1r);
+    wire [7:0] b2 = satadd(col1r[7:0],   dl1r);
+
+    wire [23:0] hue2 = hue_wheel(aop1r);
+    // ★ 位宽坑（同 §"小位宽×大位宽"）：两个 8bit 相乘若直接写 `>>8`，
+    //   表达式的上下文位宽仍是 8 位 ⇒ 乘积回绕、右移后恒为 0（实测伪彩全黑）。
+    //   必须先把乘积登记到 16 位再取高位。
+    wire [15:0] hR2 = hue2[23:16] * y1r;
+    wire [15:0] hG2 = hue2[15:8]  * y1r;
+    wire [15:0] hB2 = hue2[7:0]   * y1r;
+    wire [7:0]  rh2 = hR2[15:8], gh2 = hG2[15:8], bh2 = hB2[15:8];
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 24'd0; y_out <= 8'd0; dolp_out <= 8'd0; aop_out <= 8'd0;
+            bin_out <= 1'b0; de_out <= 1'b0; hs_out <= 1'b0; vs_out <= 1'b0;
+        end else begin
+            de_out   <= v1r;
+            hs_out   <= hs1r;
+            vs_out   <= vs1r;
+            y_out    <= y1r;
+            dolp_out <= dolp1r;
+            aop_out  <= aop1r;
+            bin_out  <= (dolp1r >= BIN_THR);
+            if (AOP_HUE) rgb_out <= {rh2, gh2, bh2};
+            else         rgb_out <= {r2, g2, b2};
+        end
+    end
+
+endmodule
--- v8/user_source/algorithms/algo_gray.v
+++ fusion/user_source/algorithms/algo_gray.v
@@ -0,0 +1,19 @@
+`timescale 1ns/1ps
+// 模块作用：RGB888 转 8 位灰度，rgb_out 三通道相同，y_out 提供独立灰度值。
+// 总延迟 2 级；GRAY_MODE=0 为加权灰度，1/2 为移位加法近似。
+module algo_gray #(parameter GRAY_MODE=0)(input wire clk,input wire rst_n,input wire [23:0] rgb_in,input wire de_in,input wire hs_in,input wire vs_in,output reg [23:0] rgb_out,output reg [7:0] y_out,output reg de_out,output reg hs_out,output reg vs_out);
+ // 颜色分量先零扩展到 16 位，保留加权计算需要的位宽。默认权重为 77、150、29。
+ wire [15:0] r={8'd0,rgb_in[23:16]},g={8'd0,rgb_in[15:8]},b={8'd0,rgb_in[7:0]};
+ wire [15:0] sum=(GRAY_MODE==1)?(r+(g<<1)+b):(GRAY_MODE==2)?((r<<1)+(g<<2)+g+b):(r*16'd77+g*16'd150+b*16'd29);
+ // 默认公式 Y=(77R+150G+29B+128)>>8；ROUND 在移位前加入，实现舍入。
+ localparam SHIFT=(GRAY_MODE==1)?2:((GRAY_MODE==2)?3:8);
+ localparam [15:0] ROUND=16'd1<<(SHIFT-1);
+ // 第一级寄存加权和与时序；第二级输出灰度，并将上一拍时序送到输出。
+ reg [15:0] sum_r; reg de_r,hs_r,vs_r;
+ wire [7:0] y_next=sum_r>>SHIFT;
+ // 非阻塞赋值使 y_next 使用上一拍 sum_r，因此 RGB、y_out 与输出 DE 同拍对应。
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin sum_r<=0;de_r<=0;hs_r<=0;vs_r<=0;y_out<=0;rgb_out<=0;de_out<=0;hs_out<=0;vs_out<=0; end
+  else begin sum_r<=sum+ROUND;de_r<=de_in;hs_r<=hs_in;vs_r<=vs_in;y_out<=y_next;rgb_out<={y_next,y_next,y_next};de_out<=de_r;hs_out<=hs_r;vs_out<=vs_r; end
+ end
+endmodule
--- v8/user_source/algorithms/algo_histeq.v
+++ fusion/user_source/algorithms/algo_histeq.v
@@ -0,0 +1,302 @@
+// 算法5③：移植自算法5交付包，适配 SC520CS 的 RGB888、1280×720、高有效 VS。
+// 使用上一帧统计生成映射，本帧应用；像素通路固定4级，不缓存/推迟整帧图像。
+// HIST_BITS=20 可容纳921600个同灰度像素；19位不足以统计720p单色帧。
+// 建表最多约1800拍，需留足垂直消隐；当前720p显示时序满足这一条件。
+// 开机空帧和单色帧使用恒等映射；色差仅在通道未饱和时保持，饱和会改变色差。
+`timescale 1ns/1ps
+
+module algo_histeq #(
+    parameter GRAY_MODE = 0,        // 内部灰度权值模式（必须与上游一致）
+    parameter HIST_BITS = 20,       // 直方图计数位宽：20 位可到1048575 > 1280*720=921600
+    parameter STRENGTH  = 256,      // 均衡强度 Q8：256 = 完全均衡（默认），0 = 直通
+    parameter VS_ACTIVE_LOW = 0,  // 当前显示高有效VS
+    parameter RGB_MODE  = 0         // 0 = Δ 色差保持（默认）；1 = 输出灰度 R=G=B=Y''
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        hs_in,
+    input  wire        vs_in,
+    input  wire [7:0]  thr_in,      // 未使用（保留）
+
+    output reg  [23:0] rgb_out,
+    output reg  [7:0]  y_out,
+    output reg         bin_out,
+    output reg         de_out,
+    output reg         hs_out,
+    output reg         vs_out
+);
+
+    localparam AW = HIST_BITS + 8; // cdf*256 的位宽，默认28
+
+    //---------------- RGB888分量，保留输入精度----------------
+    wire [7:0] r8 = rgb_in[23:16];
+    wire [7:0] g8 = rgb_in[15:8];
+    wire [7:0] b8 = rgb_in[7:0];
+
+    //---------------- 灰度（例化算法2，2 拍）----------------
+    wire [7:0]  y_g;
+    wire        de_g, hs_g, vs_g;
+    wire [23:0] rgb_g_unused;
+
+    algo_gray #(.GRAY_MODE (GRAY_MODE)) u_gray (
+        .clk     (clk),    .rst_n  (rst_n),
+        .rgb_in  (rgb_in),
+        .de_in   (de_in),  .hs_in  (hs_in), .vs_in (vs_in),
+        .rgb_out (rgb_g_unused),
+        .y_out   (y_g),
+        .de_out  (de_g),   .hs_out (hs_g),  .vs_out (vs_g)
+    );
+
+    //=================================================================
+    // 存储数组先声明（供后面状态机引用；数组本身**不复位**以便推断 BRAM）
+    //=================================================================
+    reg [HIST_BITS-1:0] hmem [0:255];   // 直方图 256 × HIST_BITS（单读单写 ⇒ ERAM）
+    reg [HIST_BITS-1:0] h_rdo;          // 同步读输出
+    reg [7:0]           mmap [0:255];   // 映射表 256 × 8bit（⇒ 分布式 RAM）
+    reg [7:0]           mapy;           // 映射表同步读输出
+
+    //=================================================================
+    // 状态机
+    //=================================================================
+    localparam S_RST  = 3'd0,   // 复位后：把 256 个 bin 清零
+               S_IDLE = 3'd1,   // 统计中（像素流正常）
+               S_SUM_A= 3'd2,   // 求和：给读地址
+               S_SUM_B= 3'd3,   // 求和：累加
+               S_RD_A = 3'd4,   // 建表：给读地址
+               S_RD_B = 3'd5,   // 建表：累加 CDF + 清零该 bin
+               S_LOOP = 3'd6,   // 阈值跨越循环
+               S_WR   = 3'd7;   // 写映射表
+
+    reg [2:0]  st;
+    reg [8:0]  cy;                  // 0..255（9bit 便于判 ==255）
+    reg [HIST_BITS:0]  sum_acc;     // 求和累加（HIST_BITS+1位）
+    reg [HIST_BITS:0]  total;       // 一帧像素总数 = cdf[255]
+    reg [AW-1:0]       acc;         // cdf*256
+    reg [AW-1:0]       rhs;         // k*total
+    reg [8:0]          kk;          // 输出档数 0..256
+    reg                map_rdy;
+    reg                vs_d;
+    reg [HIST_BITS:0]  cmin;        // cdf_min = 第一个非零 bin 的计数
+    reg [HIST_BITS:0]  den;         // denom = total - cdfmin
+    reg                uni;         // 单色帧标志（只有一个 bin 非零）⇒ 映射表退化为恒等
+    reg [1:0] occupied_bins; // 第一遍计数非零桶，提前判定单色，避免低灰度桶先被写成0
+    reg                nz;          // 本次建表已经找到第一个非零 bin
+
+    wire fsm_busy = (st != S_IDLE);
+    wire vs_active = VS_ACTIVE_LOW ? ~vs_g : vs_g;
+    wire frame_end = vs_active & ~vs_d; // 使用灰度域对齐后的VS有效沿启动上一帧建表
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) vs_d <= 1'b0;
+        else        vs_d <= vs_active;
+    end
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            st <= S_RST; cy <= 9'd0; occupied_bins <= 0;
+            sum_acc <= 0; total <= 0; acc <= 0; rhs <= 0; kk <= 9'd0;
+            map_rdy <= 1'b0;
+            cmin <= 0; den <= 0; uni <= 1'b0; nz <= 1'b0;
+        end else begin
+            case (st)
+            //---------- 复位后清一次直方图（避免未初始化 X 进 CDF）----------
+            S_RST: begin
+                if (cy == 9'd255) begin st <= S_IDLE; cy <= 9'd0; end
+                else                    cy <= cy + 9'd1;
+            end
+            //---------- 统计中，等帧结束 ----------
+            S_IDLE: begin
+                if (frame_end) begin
+                    st <= S_SUM_A; cy <= 9'd0; sum_acc <= 0; occupied_bins <= 0;
+                    cmin <= 0; den <= 0; uni <= 1'b0; nz <= 1'b0; kk <= 9'd0;
+                end
+            end
+            //---------- 第一遍：求 total ----------
+            S_SUM_A: st <= S_SUM_B;
+            S_SUM_B: begin
+                if(h_rdo != 0 && occupied_bins < 2) occupied_bins <= occupied_bins + 1'b1;
+                if (cy == 9'd255) begin
+                    // 空统计帧（如上电时先到VS）也使用恒等表，避免第一帧全黑。
+                    uni <= ((occupied_bins + (h_rdo != 0)) <= 1);
+                    total   <= sum_acc + h_rdo;
+                    acc     <= 0;
+                    rhs     <= {{(AW-HIST_BITS-1){1'b0}}, (sum_acc + h_rdo)};
+                    kk      <= 9'd0;
+                    st      <= S_RD_A;
+                    cy      <= 9'd0;
+                end else begin
+                    sum_acc <= sum_acc + h_rdo;
+                    cy      <= cy + 9'd1;
+                    st      <= S_SUM_A;
+                end
+            end
+            //---------- 第二遍：CDF + cdf_min + 阈值跨越 + 出表 ----------
+            S_RD_A: st <= S_RD_B;
+            S_RD_B: begin
+                acc <= acc + {h_rdo, 8'b0};     // cdf += hist[cy]（同时 ×256）
+                if (nz == 1'b0) begin
+                    if (h_rdo == 0) begin
+                        // 还没到第一个非零 bin：该 bin 的映射记为 0（下面 S_WR 用 kk=0）
+                        kk <= 9'd0;
+                        st <= S_WR;
+                    end else if (h_rdo == total) begin
+                        // ★ 单色帧：total == cdf_min ⇒ denom = 0（除零）
+                        //   约定：映射表退化为**恒等**（全黑仍是全黑、全白仍是全白）
+                        uni <= 1'b1;
+                        st  <= S_WR;
+                        kk  <= 9'd0;
+                    end else begin
+                        // 第一个非零 bin：记下 cdf_min 与 denom，rhs 初值 = cdfmin*256 + denom
+                        cmin <= h_rdo;
+                        den  <= total - h_rdo;
+                        rhs  <= {h_rdo, 8'b0} + (total - h_rdo);
+                        kk   <= 9'd0;
+                        nz   <= 1'b1;
+                        st   <= S_LOOP;
+                    end
+                end else begin
+                    st <= S_LOOP;
+                end
+            end
+            // 阈值跨越循环：out = max{ k : (cdf−cdfmin)*256 ≥ k*denom }（= floor(差值*256/denom)）
+            S_LOOP: begin
+                if (acc >= rhs) begin
+                    if (kk < 9'd255) begin      // 档数封顶 255
+                        kk  <= kk + 9'd1;
+                        rhs <= rhs + den;
+                    end else begin
+                        st <= S_WR;
+                    end
+                end else begin
+                    st <= S_WR;
+                end
+            end
+            S_WR: begin
+                if (cy == 9'd255) begin
+                    st <= S_IDLE; cy <= 9'd0; map_rdy <= 1'b1;
+                end else begin
+                    cy <= cy + 9'd1; st <= S_RD_A;
+                end
+            end
+            default: st <= S_IDLE;
+            endcase
+        end
+    end
+
+    //=================================================================
+    // 直方图 RAM 的读写控制（数组已在文件前部声明）
+    //=================================================================
+    reg [7:0] y_d1;
+    reg       de_g_d1;
+
+    wire fsm_rd  = (st == S_SUM_A) || (st == S_RD_A);
+    wire fsm_clr = (st == S_RST)   || (st == S_RD_B);
+
+    wire coll = (y_g == y_d1);                                  // 本拍读地址 == 本拍写地址
+    wire [HIST_BITS:0] wdat = h_rdo + 1'b1;                     // 本拍要写的计数值
+    // ★ 补写尾巴 & 抑制"起始拍陈旧写"：
+    //   本拍写的是**上一拍那个像素**的计数（地址 y_d1 = 上一拍 Y）。
+    //   de 拉低后的第一拍要补写（否则每行最后 1 个像素会丢）；
+    //   但 de 拉**起**的第一拍，y_d1 还停在消隐期的 Y（=0）上，会把上一行/上一帧的
+    //   计数值写进 bin 0 —— 实测这会污染 cdf_min，导致整张映射表偏移（探针抓到 hist[0]=112）。
+    //   ⇒ 丢一拍不损失任何像素：本拍像素的计数会在下一拍作为"上一拍"被写出。
+    wire de_rise = de_g & ~de_g_d1;                             // 一行/一帧的第一个有效像素
+    wire stat_en = (de_g | (de_g_d1 & ~de_g)) & ~de_rise;       // 含"最后 1 拍补写"
+    wire stat_en_g = stat_en & ~fsm_busy;                       // 状态机期间停统计
+
+    // 读：状态机期间用 cy 当地址；统计期间用当前像素 Y，并做同址旁路
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)          h_rdo <= 0;
+        else if (fsm_rd)     h_rdo <= hmem[cy[7:0]];
+        else if (de_g)       h_rdo <= (coll && stat_en_g) ? (h_rdo + 1'b1) : hmem[y_g];
+    end
+
+    // 写：统计写（含补写）优先；状态机清零次之
+    always @(posedge clk) begin
+        if (stat_en_g)       hmem[y_d1]     <= wdat[HIST_BITS-1:0];
+        else if (fsm_clr)    hmem[cy[7:0]]  <= {HIST_BITS{1'b0}};
+    end
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin y_d1 <= 8'd0; de_g_d1 <= 1'b0; end
+        else        begin y_d1 <= y_g;  de_g_d1 <= de_g; end
+    end
+
+    //=================================================================
+    // 映射表 RAM 的写控制（数组已在文件前部声明）
+    //=================================================================
+    always @(posedge clk) if (st == S_WR) mmap[cy[7:0]] <= uni ? cy[7:0]
+                                                            : ((kk > 9'd255) ? 8'd255 : kk[7:0]);
+
+    //=================================================================
+    // 应用通路：延迟链（通道 3 拍、Y 1 拍）+ 查表 + 强度混合 + Δ 色差保持
+    //=================================================================
+    reg [7:0] r8a, g8a, b8a;
+    reg [7:0] r8b, g8b, b8b;
+    reg [7:0] r8c, g8c, b8c;
+    reg [7:0] y_d1a;
+    reg       de_s3, hs_s3, vs_s3;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            r8a<=0; g8a<=0; b8a<=0;  r8b<=0; g8b<=0; b8b<=0;  r8c<=0; g8c<=0; b8c<=0;
+            y_d1a<=0; mapy<=0;  de_s3<=0; hs_s3<=0; vs_s3<=0;
+        end else begin
+            r8a<=r8;   g8a<=g8;   b8a<=b8;
+            r8b<=r8a;  g8b<=g8a;  b8b<=b8a;
+            r8c<=r8b;  g8c<=g8b;  b8c<=b8b;
+            y_d1a <= y_g;
+            mapy  <= mmap[y_g];             // 同步读：地址=第 2 拍的 Y，数据第 3 拍有效
+            de_s3 <= de_g; hs_s3 <= hs_g; vs_s3 <= vs_g;
+        end
+    end
+
+    // 强度混合（全无符号）：Y'' = (Y*(256-S) + mapY*S) >> 8
+    //   权和 = 256 ⇒ 结果 ≤ 255，**不需要饱和逻辑**；S=256 → Y''=mapY（完全均衡）；S=0 → Y''=Y
+    wire [15:0] blend = y_d1a * (256 - STRENGTH) + mapy * STRENGTH;
+
+    // 映射表没建好（或模式刚切过来）⇒ 直通，避免读到未初始化的表
+    wire [7:0] ypp = map_rdy ? blend[15:8] : y_d1a;
+
+    // Δ 色差保持：Δ = Y'' - Y
+    wire       dsgn = (y_d1a > ypp);
+    wire [7:0] dmag = dsgn ? (y_d1a - ypp) : (ypp - y_d1a);
+
+    function [8:0] dadd;
+        input [7:0] c;
+        input       sgn;
+        input [7:0] mag;
+        reg [8:0]   v;
+        begin
+            if (sgn) dadd = (mag > c) ? {1'b1, 8'h00} : {1'b0, (c - mag)};
+            else begin
+                v = {1'b0, c} + mag;
+                dadd = (v > 9'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
+            end
+        end
+    endfunction
+
+    wire [8:0] rx = (RGB_MODE == 0) ? dadd(r8c, dsgn, dmag) : {1'b0, ypp};
+    wire [8:0] gx = (RGB_MODE == 0) ? dadd(g8c, dsgn, dmag) : {1'b0, ypp};
+    wire [8:0] bx = (RGB_MODE == 0) ? dadd(b8c, dsgn, dmag) : {1'b0, ypp};
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 24'd0; y_out <= 8'd0; bin_out <= 1'b0;
+            de_out <= 1'b0; hs_out <= 1'b0; vs_out <= 1'b0;
+        end else begin
+            y_out   <= ypp;
+            rgb_out <= {rx[7:0], gx[7:0], bx[7:0]};
+            bin_out <= rx[8] | gx[8] | bx[8];
+            de_out  <= de_s3;
+            hs_out  <= hs_s3;
+            vs_out  <= vs_s3;
+        end
+    end
+
+endmodule
+
+
--- v8/user_source/algorithms/algo_level.v
+++ fusion/user_source/algorithms/algo_level.v
@@ -0,0 +1,185 @@
+// algo_level.v —— 线性变换内核（算法5 子模式①②共用：亮度增强 / 对比度增强）
+// 亮度增强和对比度增强**是同一个线性变换**，只差一个"中心点"：
+//     对比度：Y' = (Y - 128) * gain / 2^SHIFT + 128        ← 以中灰 128 为轴拉伸
+//     亮度  ：Y' = (Y -   0) * gain / 2^SHIFT + 0 + ADD    ← 以黑点 0 为轴缩放（保黑点）
+//   两者都能写成  Y' = sat( (Y - CENTER) * gain / 2^SHIFT + CENTER + ADD )
+//   ⇒ 用同一个模块 + 参数 CENTER 区分（algo_bright.v 固定 CENTER=0，
+//     algo_contrast.v 固定 CENTER=128），**只有一份真值来源**，
+// thr_in[7:0] 复用为「增益」，Q4.4 定点：gain = thr_in / 16
+//     thr_in = 8'd16  → ×1.0（恒等，锚点）
+//     thr_in = 8'd32  → ×2.0
+//     thr_in = 8'd8   → ×0.5
+//     thr_in = 8'd48  → ×3.0
+//     thr_in = 8'd0   → ×0.0（亮度目标0，对比度目标128，彩色通道仍按RGB_MODE恢复）
+//   ★ 注意：顶层给算法3(二值化)的默认值 8'd128 对算法5 是 ×8 ⇒ 会全白。
+//     上板演示算法5 时 thr_in 要给 16~48（见 交付说明 §3、§7）。
+//
+// 【溢出：饱和，不截断（不环绕）】
+//   截断(取低 8 位)会把亮部直接翻回黑，画面上是刺眼的"黑洞"伪影；
+//   饱和(钉在 0/255)只是丢高光细节，视觉上自然。所有通道统一饱和，
+//   并将裁剪/负向零边界标志引到 bin_out（见下）。
+//
+// 【颜色怎么保：Δ 色差保持（默认，RGB_MODE=0）】
+//   只算一个亮度映射 Y' = f(Y)，然后三通道**同加减** Δ = Y' - Y：
+//       R' = sat(R + Δ)   G' = sat(G + Δ)   B' = sat(B + Δ)
+//   ⇒ 不除法、不乘 3 次；未饱和时色差 (R-G, G-B) 不变；通道饱和时色差会变化。
+//     中性灰像素 (R=G=B=Y) 恰好变成 (Y',Y',Y') ⇒ 亮度语义严格正确。
+//     （对比之下"三通道各自乘 gain"会把饱和度一起放大、颜色变冲；
+//      那版留着 RGB_MODE=1，代价是 4 个乘法器而不是 1 个。见文档 §3.1）
+//
+// 【位宽核算（算出来的，不是"应该够"）】
+//   正支：(c-CENTER) ≤ 255，× gain ≤ 255*255 = 65025 ⇒ 16bit 不溢出；
+//         >>4 后 ≤ 4064，+CENTER+ADD ≤ 4319 ⇒ 17bit 足够，饱和判据 v>255 一比较即可。
+//   负支：v = CENTER+ADD - (t*gain>>4)，t ≤ 128 ⇒ t*gain ≤ 32640 ⇒ 15bit；
+//         判 v<0 即饱和到 0。
+//   Δ：|Δ| ≤ 255 ⇒ 9bit（符号+幅度分开表示，全程无符号算术 ⇒ TD 不会踩有符号坑）
+//
+// 【流水线：固定 3 拍】de/hs/vs 与像素**同延 3 拍**（灰度 2 + 变换/输出 1）
+//   thr_in 延 2 拍（= 总延时-1），到变换那一级才与像素相遇（与算法3/4 同一纪律）。
+//=============================================================================
+// 来源：算法5交付包 algo_level 核心，保持原线性变换公式，改接工程 RGB888 灰度接口。
+// 流水延迟：灰度 2 级 + 变换/输出 1 级，共 3 级，thr_in 与对应像素对齐。
+`timescale 1ns/1ps
+
+module algo_level #(
+    parameter GRAY_MODE  = 0,       // 内部灰度权值模式（见 algo_gray.v）
+    parameter CENTER     = 0,       // 0 = 亮度增强；128 = 对比度增强
+    parameter ADD        = 0,       // 加性偏移（0~127，编译期；默认 0）
+    parameter GAIN_SHIFT = 4,       // 增益定点：gain = thr_in / 2^GAIN_SHIFT
+    parameter RGB_MODE   = 0        // 0 = Δ 色差保持（默认，1 个乘法器）；1 = 三通道各自乘 gain
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        hs_in,
+    input  wire        vs_in,
+    input  wire [7:0]  thr_in,      // ★ Q4.4 增益（16 = ×1.0）
+
+    output reg  [23:0] rgb_out,
+    output reg  [7:0]  y_out,
+    output reg         bin_out,     // ★ 本算法族无阈值语义 ⇒ 复用为「裁剪或亮度触及负向0边界标志」
+    output reg         de_out,
+    output reg         hs_out,
+    output reg         vs_out
+);
+
+    localparam [7:0]  C8   = CENTER;            // 中心点（0 或 128）
+    localparam [15:0] CADD = CENTER + ADD;      // 中心 + 偏移（≥0）
+
+    //---------------- RGB888 拆分（接口与现有 RGB888 版 algo_gray 一致）----------------
+    wire [7:0] r8 = rgb_in[23:16];
+    wire [7:0] g8 = rgb_in[15:8];
+    wire [7:0] b8 = rgb_in[7:0];
+
+    //---------------- 灰度（例化算法2，2 拍）----------------
+    wire [7:0]  y_g;
+    wire        de_g, hs_g, vs_g;
+    wire [23:0] rgb_g_unused;
+
+    algo_gray #(.GRAY_MODE (GRAY_MODE)) u_gray (
+        .clk     (clk),    .rst_n  (rst_n),
+        .rgb_in  (rgb_in),
+        .de_in   (de_in),  .hs_in  (hs_in), .vs_in (vs_in),
+        .rgb_out (rgb_g_unused),
+        .y_out   (y_g),
+        .de_out  (de_g),   .hs_out (hs_g),  .vs_out (vs_g)
+    );
+
+    //---------------- 增益流水（延 2 拍 = 总延时 3 − 1）----------------
+    reg [7:0] thr_s1, thr_s2;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin thr_s1 <= 8'd0; thr_s2 <= 8'd0; end
+        else        begin thr_s1 <= thr_in; thr_s2 <= thr_s1; end
+    end
+
+    //---------------- 单通道线性变换（组合；全程无符号算术）----------------
+    //   返回 {裁剪/负向0边界标志, 结果}；沿用原包v>=CADD的边界语义
+    function [8:0] xform;
+        input [7:0] c;
+        input [7:0] g;
+        reg [15:0] t, p;
+        reg [17:0] v, w;
+        begin
+            if (CENTER == 0) begin
+                p = c * g;                                  // ≤ 65025 ⇒ 16bit
+                v = (p >> GAIN_SHIFT) + CADD;
+                xform = (v > 18'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
+            end else begin
+                if (c >= C8) begin                          // 正支：向上拉伸
+                    t = c - C8;
+                    p = t * g;
+                    v = (p >> GAIN_SHIFT) + CADD;
+                    xform = (v > 18'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
+                end else begin                              // 负支：向下压
+                    t = C8 - c;
+                    p = t * g;
+                    v = p >> GAIN_SHIFT;
+                    w = (v >= CADD) ? 18'd0 : (CADD - v);
+                    xform = (v >= CADD) ? {1'b1, 8'h00} : {1'b0, w[7:0]};
+                end
+            end
+        end
+    endfunction
+
+    //---------------- 通道加常量偏移（用于 Δ 色差保持路径）----------------
+    function [8:0] dadd;
+        input [7:0] c;
+        input       sgn;        // 1 = 减
+        input [7:0] mag;        // 幅度
+        reg [8:0]   v;
+        begin
+            if (sgn) dadd = (mag > c) ? {1'b1, 8'h00} : {1'b0, (c - mag)};
+            else begin
+                v = {1'b0, c} + mag;
+                dadd = (v > 9'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
+            end
+        end
+    endfunction
+
+    //---------------- 通道延迟 2 拍（第 3 拍与 Y' 同拍）----------------
+    reg [7:0] r8a, g8a, b8a;        // 第 1 拍
+    reg [7:0] r8b, g8b, b8b;        // 第 2 拍
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            r8a <= 8'd0; g8a <= 8'd0; b8a <= 8'd0;
+            r8b <= 8'd0; g8b <= 8'd0; b8b <= 8'd0;
+        end else begin
+            r8a <= r8; g8a <= g8; b8a <= b8;
+            r8b <= r8a; g8b <= g8a; b8b <= b8a;
+        end
+    end
+
+    //---------------- 第 3 拍：变换 + 色差保持 + 输出登记 ----------------
+    wire [8:0] yx  = xform(y_g, thr_s2);        // {饱和, Y'}
+    wire [7:0] yp  = yx[7:0];
+    wire       ycl = yx[8];
+
+    wire       dsgn = (y_g > yp);               // Δ = yp - y_g
+    wire [7:0] dmag = dsgn ? (y_g - yp) : (yp - y_g);
+
+    wire [8:0] rx = (RGB_MODE == 0) ? dadd(r8b, dsgn, dmag) : xform(r8b, thr_s2);
+    wire [8:0] gx = (RGB_MODE == 0) ? dadd(g8b, dsgn, dmag) : xform(g8b, thr_s2);
+    wire [8:0] bx = (RGB_MODE == 0) ? dadd(b8b, dsgn, dmag) : xform(b8b, thr_s2);
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 24'd0;
+            y_out   <= 8'd0;
+            bin_out <= 1'b0;
+            de_out  <= 1'b0;
+            hs_out  <= 1'b0;
+            vs_out  <= 1'b0;
+        end else begin
+            y_out   <= yp;
+            rgb_out <= {rx[7:0], gx[7:0], bx[7:0]};
+            bin_out <= ycl | rx[8] | gx[8] | bx[8];     // 饱和截断标志
+            de_out  <= de_g;
+            hs_out  <= hs_g;
+            vs_out  <= vs_g;
+        end
+    end
+
+endmodule
+
--- v8/user_source/algorithms/algo_morph.v
+++ fusion/user_source/algorithms/algo_morph.v
@@ -0,0 +1,102 @@
+// 算法6：3x3 形态学腐蚀/膨胀，RGB888 输入，灰度 min/max 输出。
+// 四级流水：algo_gray(2) + line_buffer_3x3(1) + 形态学输出寄存(1)。
+// 比较树仍在单周期内完成；目标时钟 75 MHz 时须以综合/布局布线时序报告确认。
+`timescale 1ns/1ps
+
+module algo_morph #(
+    parameter GRAY_MODE   = 0,
+    parameter DW          = 8,
+    parameter BIN_INPUT   = 0,
+    parameter MORPH_OP    = 1,
+    parameter OP_FROM_THR = 1,
+    parameter SE_CROSS    = 0,
+    parameter BORDER      = 1,
+    parameter LB_W        = 1280,
+    parameter LB_DEPTH    = 2048,
+    parameter LB_AW       = 11,
+    parameter VS_ACTIVE_LOW = 0
+)(
+    input  wire        clk,
+    input  wire        rst_n,
+    input  wire [23:0] rgb_in,
+    input  wire        de_in,
+    input  wire        hs_in,
+    input  wire        vs_in,
+    input  wire [7:0]  thr_in,
+    output reg  [23:0] rgb_out,
+    output reg  [7:0]  y_out,
+    output reg         bin_out,
+    output reg         de_out,
+    output reg         hs_out,
+    output reg         vs_out
+);
+    wire [7:0] y_g;
+    wire de_g, hs_g, vs_g;
+
+    algo_gray #(.GRAY_MODE(GRAY_MODE)) u_gray (
+        .clk(clk), .rst_n(rst_n), .rgb_in(rgb_in),
+        .de_in(de_in), .hs_in(hs_in), .vs_in(vs_in),
+        .rgb_out(), .y_out(y_g), .de_out(de_g), .hs_out(hs_g), .vs_out(vs_g)
+    );
+
+    reg [7:0] thr_s1, thr_s2, thr_s3;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            thr_s1 <= 0; thr_s2 <= 0; thr_s3 <= 0;
+        end else begin
+            thr_s1 <= thr_in;
+            thr_s2 <= thr_s1;
+            thr_s3 <= thr_s2;
+        end
+    end
+
+    wire [7:0] bin_thr = {thr_s2[7:1], 1'b0};
+    wire y_bin = (y_g >= bin_thr);
+    wire [DW-1:0] din_lb = (DW == 1) ? y_bin :
+                            (BIN_INPUT ? (y_bin ? 8'hff : 8'h00) : y_g);
+
+    wire [DW-1:0] p00, p01, p02, p10, p11, p12, p20, p21, p22;
+    wire de_w, hs_w, vs_w;
+    line_buffer_3x3 #(
+        .DW(DW), .LB_W(LB_W), .LB_DEPTH(LB_DEPTH), .LB_AW(LB_AW),
+        .BORDER(BORDER), .VS_ACTIVE_LOW(VS_ACTIVE_LOW)
+    ) u_lb (
+        .clk(clk), .rst_n(rst_n), .din(din_lb), .de_in(de_g), .hs_in(hs_g), .vs_in(vs_g),
+        .p00(p00), .p01(p01), .p02(p02), .p10(p10), .p11(p11), .p12(p12),
+        .p20(p20), .p21(p21), .p22(p22),
+        .de_out(de_w), .hs_out(hs_w), .vs_out(vs_w), .col_out(), .row_out()
+    );
+
+    wire op = OP_FROM_THR ? thr_s3[0] : MORPH_OP[0];
+    function [DW-1:0] f;
+        input [DW-1:0] a, b;
+        begin
+            f = op ? ((a > b) ? a : b) : ((a < b) ? a : b);
+        end
+    endfunction
+
+    wire [DW-1:0] res;
+    generate
+        if (SE_CROSS == 0) begin : g_square
+            wire [DW-1:0] r1=f(p00,p01), r2=f(p02,p10), r3=f(p11,p12), r4=f(p20,p21);
+            wire [DW-1:0] s1=f(r1,r2), s2=f(r3,r4), t1=f(s1,s2);
+            assign res=f(t1,p22);
+        end else begin : g_cross
+            wire [DW-1:0] c1=f(p01,p21), c2=f(p10,p12);
+            assign res=f(f(c1,c2),p11);
+        end
+    endgenerate
+
+    wire [7:0] res8 = (DW == 1) ? {8{res[0]}} : res;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 0; y_out <= 0; bin_out <= 0;
+            de_out <= 0; hs_out <= 0; vs_out <= 0;
+        end else begin
+            y_out <= res8;
+            rgb_out <= {res8,res8,res8};
+            bin_out <= |res8;
+            de_out <= de_w; hs_out <= hs_w; vs_out <= vs_w;
+        end
+    end
+endmodule
--- v8/user_source/algorithms/algo_motion.v
+++ fusion/user_source/algorithms/algo_motion.v
@@ -0,0 +1,255 @@
+`timescale 1ns/1ps
+// 算法11：旧模式首像素采样；生产均值模式覆盖块内全部像素。
+// rgb_in/y_in/sync需在输入端已经对齐；算法仓复用 algo_gray 的两拍输出。
+module algo_motion #(
+    parameter integer IMG_WIDTH = 1280,
+    parameter integer IMG_HEIGHT = 720,
+    parameter integer DS_LOG2 = 4,
+    parameter integer DIFF_THR = 32,
+    parameter integer MOTION_CNT = 1000,
+    parameter integer VS_ACTIVE_LOW = 0,
+    parameter integer STATUS_OSD = 1,
+    parameter integer OSD_W = 48,
+    parameter integer OSD_H = 32,
+    parameter integer OSD_MARGIN = 8,
+    parameter integer BLOCK_MEAN_MODE = 0
+)(
+    input wire clk,
+    input wire rst_n,
+    input wire enable_in,
+    input wire [23:0] rgb_in,
+    input wire [7:0] y_in,
+    input wire de_in,
+    input wire hs_in,
+    input wire vs_in,
+    input wire [7:0] threshold_in,
+    output reg [23:0] rgb_out,
+    output reg [7:0] mask_out,
+    output reg bin_out,
+    output reg motion_detected,
+    output reg [((IMG_WIDTH*IMG_HEIGHT < 2) ? 1 : $clog2(IMG_WIDTH*IMG_HEIGHT+1))-1:0] motion_pixel_cnt,
+    output reg ref_ready,
+    output reg de_out,
+    output reg hs_out,
+    output reg vs_out
+);
+    localparam integer TOTAL_PIXELS = IMG_WIDTH * IMG_HEIGHT;
+    localparam integer COUNT_W = (TOTAL_PIXELS < 2) ? 1 : $clog2(TOTAL_PIXELS + 1);
+    localparam integer BLOCK_SIZE = (1 << DS_LOG2);
+    localparam integer BLOCKS_PER_ROW = (IMG_WIDTH + BLOCK_SIZE - 1) / BLOCK_SIZE;
+    localparam integer REF_WORDS = BLOCKS_PER_ROW * IMG_HEIGHT;
+    localparam integer ADDR_W = (REF_WORDS < 2) ? 1 : $clog2(REF_WORDS);
+    localparam integer X_W = (IMG_WIDTH < 2) ? 1 : $clog2(IMG_WIDTH);
+    localparam integer Y_W = (IMG_HEIGHT < 2) ? 1 : $clog2(IMG_HEIGHT);
+    localparam integer BLOCK_POS_W = (BLOCK_SIZE < 2) ? 1 : $clog2(BLOCK_SIZE);
+    localparam integer SUM_W = 8 + DS_LOG2;
+    localparam integer TAIL_LEN = (IMG_WIDTH % BLOCK_SIZE == 0) ? BLOCK_SIZE : IMG_WIDTH % BLOCK_SIZE;
+    localparam integer OSD_X = (IMG_WIDTH > OSD_W + OSD_MARGIN) ? IMG_WIDTH - OSD_W - OSD_MARGIN : 0;
+    localparam [23:0] MOTION_COLOR = 24'hFF0000;
+    localparam [23:0] STATUS_COLOR = 24'h00FF00;
+
+    reg vs_active_d;
+    wire vs_active = VS_ACTIVE_LOW ? ~vs_in : vs_in;
+    wire vs_rise = vs_active & ~vs_active_d;
+
+    reg frame_started;
+    reg frame_good;
+    // 20位计数可表示720p的921600个像素，不会像19位计数那样溢出。
+    reg [COUNT_W-1:0] frame_pixel_count;
+    reg [COUNT_W-1:0] frame_motion_count;
+    reg [X_W-1:0] x_pos;
+    reg [Y_W-1:0] y_pos;
+    reg [BLOCK_POS_W-1:0] block_pos;
+    reg [ADDR_W-1:0] block_addr;
+    reg [7:0] sample_hold;
+    reg block_motion;
+    reg [SUM_W-1:0] block_sum;
+
+    // Mean mode stores {previous motion flag, mean Y}. The flag is displayed
+    // at the SAME position next frame, so no horizontal shift or extra pixel
+    // latency is introduced. Legacy mode folds away the unused ninth bit.
+    // RAM is deliberately not reset; ref_ready masks it until a full warmup.
+    // 块末写本帧样本并预读下一地址，使下一块首像素可直接比较，避免同址读写。
+    reg [8:0] ref_ram [0:REF_WORDS-1];
+    reg [8:0] ref_q;
+
+    wire pixel_valid = enable_in && frame_started && !vs_rise && de_in &&
+                       (frame_pixel_count < TOTAL_PIXELS);
+    wire block_first = (block_pos == 0);
+    wire block_last = (block_pos == BLOCK_SIZE-1) || (x_pos == IMG_WIDTH-1);
+    wire block_write = pixel_valid && block_last;
+    wire [ADDR_W-1:0] next_addr = (block_addr == REF_WORDS-1) ? {ADDR_W{1'b0}} : block_addr + 1'b1;
+    // VS边沿强制预取地址0，保证只有一个空白时钟的帧也能正确比较首块。
+    wire [ADDR_W-1:0] ram_read_addr = vs_rise ? {ADDR_W{1'b0}} :
+                                      (block_write ? next_addr : block_addr);
+    wire [7:0] sample_to_write = (block_first && block_last) ? y_in : sample_hold;
+    wire [8:0] delta = (y_in >= ref_q[7:0]) ? ({1'b0,y_in}-{1'b0,ref_q[7:0]}) : ({1'b0,ref_q[7:0]}-{1'b0,y_in});
+    wire [7:0] active_threshold = (threshold_in == 0) ? DIFF_THR[7:0] : threshold_in;
+    wire first_sample_motion = ref_ready && (delta >= {1'b0,active_threshold});
+    wire [SUM_W-1:0] sum_including_pixel = block_first ? y_in : block_sum + y_in;
+    // TAIL_LEN is a nonzero elaboration constant. Production width 1280 has
+    // no partial block, so synthesis keeps only the power-of-two shift.
+    wire [7:0] current_mean = ((TAIL_LEN != BLOCK_SIZE) && (x_pos == IMG_WIDTH-1)) ?
+        (({1'b0,sum_including_pixel} + TAIL_LEN/2) / TAIL_LEN) :
+        (({1'b0,sum_including_pixel} + BLOCK_SIZE/2) >> DS_LOG2);
+    wire [8:0] mean_delta = (current_mean >= ref_q[7:0]) ?
+        ({1'b0,current_mean}-{1'b0,ref_q[7:0]}) : ({1'b0,ref_q[7:0]}-{1'b0,current_mean});
+    wire mean_motion = ref_ready && (mean_delta >= {1'b0,active_threshold});
+    wire current_motion = BLOCK_MEAN_MODE ? (ref_ready && ref_q[8]) :
+                          (block_first ? first_sample_motion : block_motion);
+    wire [8:0] record_to_write = BLOCK_MEAN_MODE ? {mean_motion,current_mean} : {1'b0,sample_to_write};
+    wire [COUNT_W-1:0] block_pixel_count = ((TAIL_LEN != BLOCK_SIZE) && (x_pos == IMG_WIDTH-1)) ? TAIL_LEN : BLOCK_SIZE;
+
+    always @(posedge clk) begin
+        if (enable_in && block_write) begin
+            ref_ram[block_addr] <= record_to_write;
+        end
+        if (REF_WORDS == 1 && enable_in && block_write) begin
+            // Defined next-frame reference for the degenerate one-word image.
+            ref_q <= record_to_write;
+        end else begin
+            ref_q <= ref_ram[ram_read_addr];
+        end
+    end
+
+    // 只在 VS 有效沿发布上一帧结果；缺失/超额像素的帧清除参考有效标志。
+    // 关闭本算法后不写RAM，重新启用必须等到新VS并完整写入一帧。
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            vs_active_d <= 1'b0;
+            frame_started <= 1'b0;
+            frame_good <= 1'b0;
+            frame_pixel_count <= {COUNT_W{1'b0}};
+            frame_motion_count <= {COUNT_W{1'b0}};
+            x_pos <= {X_W{1'b0}};
+            y_pos <= {Y_W{1'b0}};
+            block_pos <= {BLOCK_POS_W{1'b0}};
+            block_addr <= {ADDR_W{1'b0}};
+            sample_hold <= 8'd0;
+            block_motion <= 1'b0;
+            block_sum <= 0;
+            motion_pixel_cnt <= {COUNT_W{1'b0}};
+            motion_detected <= 1'b0;
+            ref_ready <= 1'b0;
+        end else begin
+            vs_active_d <= vs_active;
+
+            if (!enable_in) begin
+                frame_started <= 1'b0;
+                frame_good <= 1'b0;
+                frame_pixel_count <= {COUNT_W{1'b0}};
+                frame_motion_count <= {COUNT_W{1'b0}};
+                x_pos <= {X_W{1'b0}};
+                y_pos <= {Y_W{1'b0}};
+                block_pos <= {BLOCK_POS_W{1'b0}};
+                block_addr <= {ADDR_W{1'b0}};
+                block_motion <= 1'b0;
+                block_sum <= 0;
+                motion_pixel_cnt <= {COUNT_W{1'b0}};
+                motion_detected <= 1'b0;
+                ref_ready <= 1'b0;
+            end else if (vs_rise) begin
+                if (frame_started && frame_good && (frame_pixel_count == TOTAL_PIXELS)) begin
+                    motion_pixel_cnt <= frame_motion_count;
+                    motion_detected <= (frame_motion_count >= MOTION_CNT);
+                    ref_ready <= 1'b1;
+                end else begin
+                    motion_pixel_cnt <= {COUNT_W{1'b0}};
+                    motion_detected <= 1'b0;
+                    ref_ready <= 1'b0;
+                end
+                frame_started <= 1'b1;
+                frame_good <= 1'b1;
+                frame_pixel_count <= {COUNT_W{1'b0}};
+                frame_motion_count <= {COUNT_W{1'b0}};
+                x_pos <= {X_W{1'b0}};
+                y_pos <= {Y_W{1'b0}};
+                block_pos <= {BLOCK_POS_W{1'b0}};
+                block_addr <= {ADDR_W{1'b0}};
+                block_motion <= 1'b0;
+                block_sum <= 0;
+            end else if (de_in && frame_started) begin
+                if (frame_pixel_count < TOTAL_PIXELS) begin
+                    frame_pixel_count <= frame_pixel_count + 1'b1;
+                    if (block_first) begin
+                        sample_hold <= y_in;
+                        block_motion <= first_sample_motion;
+                    end
+                    block_sum <= sum_including_pixel;
+                    if (BLOCK_MEAN_MODE) begin
+                        if (block_last && mean_motion)
+                            frame_motion_count <= frame_motion_count + block_pixel_count;
+                    end else if (current_motion)
+                        frame_motion_count <= frame_motion_count + 1'b1;
+
+                    if (block_last) begin
+                        block_pos <= {BLOCK_POS_W{1'b0}};
+                        block_addr <= next_addr;
+                    end else begin
+                        block_pos <= block_pos + 1'b1;
+                    end
+                    if (x_pos == IMG_WIDTH-1) begin
+                        x_pos <= {X_W{1'b0}};
+                        if (y_pos == IMG_HEIGHT-1)
+                            y_pos <= {Y_W{1'b0}};
+                        else
+                            y_pos <= y_pos + 1'b1;
+                    end else begin
+                        x_pos <= x_pos + 1'b1;
+                    end
+                end else begin
+                    frame_good <= 1'b0;
+                end
+            end
+        end
+    end
+
+    // 两级寄存流水线：RGB、掩膜和同步信号保持同一拍对齐。
+    // Mean mode reads last frame's per-block decisions. Frame-level status and
+    // the red mask therefore both describe the last complete measurement.
+    reg [23:0] rgb_d1;
+    reg [7:0] mask_d1;
+    reg de_d1, hs_d1, vs_d1;
+    reg motion_d1;
+    reg [X_W-1:0] x_d1;
+    reg [Y_W-1:0] y_d1;
+    wire status_area = STATUS_OSD && (IMG_WIDTH >= OSD_W + OSD_MARGIN) &&
+                       (IMG_HEIGHT >= OSD_H + OSD_MARGIN) &&
+                       (x_d1 >= OSD_X) && (x_d1 < OSD_X + OSD_W) &&
+                       (y_d1 >= OSD_MARGIN) && (y_d1 < OSD_MARGIN + OSD_H);
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_d1 <= 24'd0;
+            mask_d1 <= 8'd0;
+            de_d1 <= 1'b0;
+            hs_d1 <= 1'b0;
+            vs_d1 <= 1'b0;
+            motion_d1 <= 1'b0;
+            x_d1 <= {X_W{1'b0}};
+            y_d1 <= {Y_W{1'b0}};
+            rgb_out <= 24'd0;
+            mask_out <= 8'd0;
+            bin_out <= 1'b0;
+            de_out <= 1'b0;
+            hs_out <= 1'b0;
+            vs_out <= 1'b0;
+        end else begin
+            rgb_d1 <= rgb_in;
+            mask_d1 <= (pixel_valid && current_motion) ? 8'hFF : 8'h00;
+            motion_d1 <= pixel_valid && current_motion;
+            de_d1 <= de_in;
+            hs_d1 <= hs_in;
+            vs_d1 <= vs_in;
+            x_d1 <= x_pos;
+            y_d1 <= y_pos;
+            rgb_out <= status_area && motion_detected ? STATUS_COLOR :
+                       (motion_d1 ? MOTION_COLOR : rgb_d1);
+            mask_out <= mask_d1;
+            bin_out <= |mask_d1;
+            de_out <= de_d1;
+            hs_out <= hs_d1;
+            vs_out <= vs_d1;
+        end
+    end
+endmodule
--- v8/user_source/algorithms/algo_passthrough.v
+++ fusion/user_source/algorithms/algo_passthrough.v
@@ -0,0 +1,9 @@
+`timescale 1ns/1ps
+// 模块作用：原图直通分支，RGB 与 DE/HS/VS 同步寄存一次，总延迟 1 级。
+// 名称为直通，但不是零延迟连线；算法库还会补齐到公共延迟。
+module algo_passthrough(input wire clk,input wire rst_n,input wire [23:0] rgb_in,input wire de_in,input wire hs_in,input wire vs_in,output reg [23:0] rgb_out,output reg de_out,output reg hs_out,output reg vs_out);
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin rgb_out<=0; de_out<=0; hs_out<=0; vs_out<=0; end
+  else begin rgb_out<=rgb_in; de_out<=de_in; hs_out<=hs_in; vs_out<=vs_in; end
+ end
+endmodule
--- v8/user_source/algorithms/algo_polar_core.v
+++ fusion/user_source/algorithms/algo_polar_core.v
@@ -0,0 +1,191 @@
+`timescale 1ns/1ps
+// 算法7：四角度光强同时输入，计算 DoLP 与 AoP；每拍可接受一个坐标。
+// i0/i45/i90/i135 必须来自同一位置、相同曝光的四次检偏观测。
+// DoLP 编码 floor(256*偏振度)，饱和255；AoP 编码[-90,+90]，128代表0度。
+// 按算法8交付包中更新的算法7扩展RGB/亮度携带；适配本工程四路并行RGB888。
+// 数学路径沿用算法7交付包：13位有符号Q2输入×4、12级CORDIC、mag_q4近似弱光门限。
+// 弱光AoP门限使用CORDIC近似幅值；此实现不承诺1 LSB精度。
+// rgb_unpol_out是四角度RGB的整数平均，名称沿用交付接口，不等同于真实去反光图。
+// y_unpol_out=(i0+i90)/2；光强与RGB样本必须来自相同坐标/角度且已配准。
+// 流水线25级寄存器（输入采样边沿到输出更新相隔24个时钟）。
+module algo_polar_core #(
+    parameter integer DOLP_S0_MIN=16,
+    parameter integer AOP_MAG_MIN=8
+)(
+    input wire clk,rst_n,
+    input wire [7:0] i0,i45,i90,i135,
+    input wire [23:0] rgb0,rgb45,rgb90,rgb135,
+    input wire de_in,hs_in,vs_in,
+    output reg [7:0] dolp_out,aop_out,
+    output reg [23:0] rgb_unpol_out,
+    output reg [7:0] y_unpol_out,
+    output wire de_out,hs_out,vs_out
+);
+    reg [9:0] s0;
+    reg signed [9:0] s1,s2;
+    function [7:0] mean4(input [7:0] a,b,c,d);
+        reg [9:0] sum;
+        begin
+            sum={2'b0,a}+{2'b0,b}+{2'b0,c}+{2'b0,d};
+            mean4=sum[9:2];
+        end
+    endfunction
+    reg [23:0] s_rgb;
+    reg v0;
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n)begin s0<=0;s1<=0;s2<=0;s_rgb<=0;v0<=0;end
+        else begin
+            v0<=de_in;
+            if(de_in)begin
+                s_rgb<={mean4(rgb0[23:16],rgb45[23:16],rgb90[23:16],rgb135[23:16]),
+                        mean4(rgb0[15:8],rgb45[15:8],rgb90[15:8],rgb135[15:8]),
+                        mean4(rgb0[7:0],rgb45[7:0],rgb90[7:0],rgb135[7:0])};
+                s0<={2'b0,i0}+{2'b0,i90};
+                s1<=$signed({2'b0,i0})-$signed({2'b0,i90});
+                s2<=$signed({2'b0,i45})-$signed({2'b0,i135});
+            end
+        end
+    end
+    function [15:0] atab(input integer i);
+        begin
+            case(i)
+                0:atab=1024;1:atab=605;2:atab=319;3:atab=162;
+                4:atab=81;5:atab=41;6:atab=20;7:atab=10;
+                8:atab=5;9:atab=3;10:atab=1;11:atab=1;
+                default:atab=0;
+            endcase
+        end
+    endfunction
+    wire [7:0] s1_abs=s1[9]?(~s1[7:0]+8'd1):s1[7:0];
+    // 交付包原始位宽：13位有符号Q2输入（Stokes量预放大×4）。
+    reg signed [12:0] cx[0:12],cy[0:12];
+    reg signed [15:0] cz[0:12];
+    reg [9:0] cs0[0:12];
+    reg [1:0] sign_pair[0:12];
+    reg cv[0:12];
+    reg [23:0] c_rgb[0:12]; // 平均RGB与同一像素沿CORDIC逐级携带。
+    reg czv[0:12]; // 零向量标志与同一像素的CORDIC结果逐级对齐。
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin cx[0]<=0;cy[0]<=0;cz[0]<=0;cs0[0]<=0;sign_pair[0]<=0;cv[0]<=0;czv[0]<=0;c_rgb[0]<=0;end
+        else begin
+            cv[0]<=v0;
+            if(v0)begin
+                czv[0]<=(s1==0)&&(s2==0);
+                c_rgb[0]<=s_rgb;
+                cx[0]<={3'b0,s1_abs,2'b0};
+                cy[0]<=$signed({s2[9],s2,2'b0});
+                cz[0]<=0;cs0[0]<=s0;sign_pair[0]<={s1[9],s2[9]};
+            end
+        end
+    end
+    genvar g;
+    generate for(g=0;g<12;g=g+1)begin:g_cordic
+        wire signed [12:0] xs=cx[g]>>>g;
+        wire signed [12:0] ys=cy[g]>>>g;
+        always @(posedge clk or negedge rst_n)begin
+            if(!rst_n)begin cx[g+1]<=0;cy[g+1]<=0;cz[g+1]<=0;cs0[g+1]<=0;sign_pair[g+1]<=0;cv[g+1]<=0;czv[g+1]<=0;c_rgb[g+1]<=0;end
+            else begin
+                cv[g+1]<=cv[g];
+                if(cv[g])begin
+                    czv[g+1]<=czv[g];
+                    c_rgb[g+1]<=c_rgb[g];
+                    cs0[g+1]<=cs0[g];sign_pair[g+1]<=sign_pair[g];
+                    if(xs==0 && ys==0)begin
+                        cx[g+1]<=cx[g];cy[g+1]<=cy[g];cz[g+1]<=cz[g];
+                    end else if(cy[g]>0)begin
+                        cx[g+1]<=cx[g]+ys;cy[g+1]<=cy[g]-xs;
+                        cz[g+1]<=cz[g]+$signed(atab(g));
+                    end else begin
+                        cx[g+1]<=cx[g]-ys;cy[g+1]<=cy[g]+xs;
+                        cz[g+1]<=cz[g]-$signed(atab(g));
+                    end
+                end
+            end
+        end
+    end endgenerate
+    // 交付包的24位乘法与mag_q4截取；CORDIC幅值为近似值。
+    wire [23:0] mag_mul={11'b0,cx[12]}*16'd622;
+    wire [12:0] mag_q4=mag_mul[20:8];
+    wire signed [15:0] half_angle=cz[12]>>>1;
+    wire signed [15:0] phi=sign_pair[12][1]?
+        (sign_pair[12][0]?(-16'sd2048-half_angle):(16'sd2048-half_angle)):half_angle;
+    wire signed [15:0] folded=(phi>2048)?(phi-16'sd4096):
+        ((phi<=-2048)?(phi+16'sd4096):phi);
+    wire [15:0] aop_sum=folded+16'sd2056;
+    wire [15:0] shifted_angle=aop_sum>>>4;
+    wire aop_weak=(mag_q4<(AOP_MAG_MIN<<4));
+    wire [7:0] angle8=czv[12]?8'd128:(aop_weak?8'd128:
+        ((shifted_angle>255)?8'd255:shifted_angle[7:0]));
+    reg [16:0] numerator;
+    reg [9:0] denominator;
+    reg [7:0] aop;
+    reg [23:0] rgb_ref;
+    reg [7:0] y_ref;
+    reg v1;
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin numerator<=0;denominator<=0;aop<=128;rgb_ref<=0;y_ref<=0;v1<=0;end
+        else begin
+            v1<=cv[12];
+            if(cv[12])begin rgb_ref<=c_rgb[12];y_ref<=cs0[12]>>1;numerator<={mag_q4,4'b0};denominator<=cs0[12];aop<=angle8;end
+        end
+    end
+    // 8级流水试减，不使用通用除法器。每个像素带自己的除数和保护标志。
+    reg [16:0] remainder[0:8];
+    reg [7:0] quotient[0:8],angle_pipe[0:8];
+    reg [9:0] den[0:8];
+    reg [23:0] rgb_pipe[0:8];
+    reg [7:0] y_pipe[0:8];
+    reg dv[0:8],overflow[0:8],weak_signal[0:8];
+    wire [17:0] limit=({8'b0,denominator}<<8)-{8'b0,denominator};
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin
+            remainder[0]<=0;quotient[0]<=0;den[0]<=0;dv[0]<=0;
+            overflow[0]<=0;weak_signal[0]<=0;angle_pipe[0]<=128;rgb_pipe[0]<=0;y_pipe[0]<=0;
+        end else begin
+            dv[0]<=v1;
+            if(v1)begin
+                rgb_pipe[0]<=rgb_ref;y_pipe[0]<=y_ref;
+                remainder[0]<=numerator;quotient[0]<=0;den[0]<=denominator;
+                overflow[0]<=({1'b0,numerator}>limit);
+                // 即使关闭弱光门限，零分母也必须无条件输出0。
+                weak_signal[0]<=(denominator==0)||(denominator<DOLP_S0_MIN);angle_pipe[0]<=aop;
+            end
+        end
+    end
+    generate for(g=0;g<8;g=g+1)begin:g_div
+        wire [16:0] trial={7'b0,den[g]}<<(7-g);
+        always @(posedge clk or negedge rst_n)begin
+            if(!rst_n)begin
+                remainder[g+1]<=0;quotient[g+1]<=0;den[g+1]<=0;dv[g+1]<=0;
+                overflow[g+1]<=0;weak_signal[g+1]<=0;angle_pipe[g+1]<=128;rgb_pipe[g+1]<=0;y_pipe[g+1]<=0;
+            end else begin
+                dv[g+1]<=dv[g];
+                if(dv[g])begin
+                    rgb_pipe[g+1]<=rgb_pipe[g];y_pipe[g+1]<=y_pipe[g];
+                    den[g+1]<=den[g];overflow[g+1]<=overflow[g];weak_signal[g+1]<=weak_signal[g];
+                    angle_pipe[g+1]<=angle_pipe[g];
+                    if(remainder[g]>=trial)begin
+                        remainder[g+1]<=remainder[g]-trial;
+                        quotient[g+1]<={quotient[g][6:0],1'b1};
+                    end else begin
+                        remainder[g+1]<=remainder[g];quotient[g+1]<={quotient[g][6:0],1'b0};
+                    end
+                end
+            end
+        end
+    end endgenerate
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin dolp_out<=0;aop_out<=128;rgb_unpol_out<=0;y_unpol_out<=0;end
+        else if(dv[8])begin
+            rgb_unpol_out<=rgb_pipe[8];y_unpol_out<=y_pipe[8];
+            dolp_out<=weak_signal[8]?8'd0:(overflow[8]?8'd255:quotient[8]);aop_out<=angle_pipe[8];
+        end
+    end
+    // HS/VS消隐电平也逐拍延迟；不能只在有效像素时传同步信号。
+    reg [24:0] dp,hp,vp;
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin dp<=0;hp<=0;vp<=0;end
+        else begin dp<={dp[23:0],de_in};hp<={hp[23:0],hs_in};vp<={vp[23:0],vs_in};end
+    end
+    assign de_out=dp[24];assign hs_out=hp[24];assign vs_out=vp[24];
+endmodule
--- v8/user_source/algorithms/algo_polar_fusion.v
+++ fusion/user_source/algorithms/algo_polar_fusion.v
@@ -0,0 +1,51 @@
+`timescale 1ns/1ps
+// 算法7→8共用一套偏振核。四角度RGB与光强必须同坐标、同曝光并同步提交。
+// 原始偏振结果25级，融合27级；同步电平含消隐期逐拍传递。
+// 由polar_block_engine在DDR时钟域提交四张快照的同坐标像素，结果写回DDR供HDMI显示。
+module algo_polar_fusion #(
+    parameter integer DOLP_S0_MIN=16,
+    parameter integer AOP_MAG_MIN=8,
+    parameter FUSION_MODE=0,
+    parameter K_DEF=7'd64,
+    parameter W_RGB=8'd128,W_DOLP=8'd96,W_AOP=8'd32,
+    parameter AOP_HUE=0,
+    parameter BIN_THR=8'd128
+)(
+    input wire clk,rst_n,
+    input wire [7:0] i0,i45,i90,i135,
+    input wire [23:0] rgb0,rgb45,rgb90,rgb135,
+    input wire de_in,hs_in,vs_in,
+    input wire [7:0] thr_in,
+    output wire [23:0] polar_rgb_out,
+    output wire [7:0] polar_y_out,polar_dolp_out,polar_aop_out,
+    output wire polar_de_out,polar_hs_out,polar_vs_out,
+    output wire [23:0] rgb_out,
+    output wire [7:0] y_out,dolp_out,aop_out,
+    output wire bin_out,de_out,hs_out,vs_out
+);
+    algo_polar_core #(.DOLP_S0_MIN(DOLP_S0_MIN),.AOP_MAG_MIN(AOP_MAG_MIN)) u_polar(
+        .clk(clk),.rst_n(rst_n),.i0(i0),.i45(i45),.i90(i90),.i135(i135),
+        .rgb0(rgb0),.rgb45(rgb45),.rgb90(rgb90),.rgb135(rgb135),
+        .de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),
+        .rgb_unpol_out(polar_rgb_out),.y_unpol_out(polar_y_out),
+        .dolp_out(polar_dolp_out),.aop_out(polar_aop_out),
+        .de_out(polar_de_out),.hs_out(polar_hs_out),.vs_out(polar_vs_out));
+    // 每个输入像素携带自己的融合参数；不能把实时thr直接接到25级后的数据。
+    reg [7:0] thr_pipe[0:24];
+    integer k;
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin
+            for(k=0;k<25;k=k+1)thr_pipe[k]<=0;
+        end else begin
+            thr_pipe[0]<=thr_in;
+            for(k=1;k<25;k=k+1)thr_pipe[k]<=thr_pipe[k-1];
+        end
+    end
+    algo_fusion #(.FUSION_MODE(FUSION_MODE),.K_DEF(K_DEF),.W_RGB(W_RGB),
+        .W_DOLP(W_DOLP),.W_AOP(W_AOP),.AOP_HUE(AOP_HUE),.BIN_THR(BIN_THR)) u_fusion(
+        .clk(clk),.rst_n(rst_n),.rgb_unpol_in(polar_rgb_out),.y_unpol_in(polar_y_out),
+        .dolp_in(polar_dolp_out),.aop_in(polar_aop_out),
+        .vin(polar_de_out),.hs_in(polar_hs_out),.vs_in(polar_vs_out),.thr_in(thr_pipe[24]),
+        .rgb_out(rgb_out),.y_out(y_out),.dolp_out(dolp_out),.aop_out(aop_out),.bin_out(bin_out),
+        .de_out(de_out),.hs_out(hs_out),.vs_out(vs_out));
+endmodule
--- v8/user_source/algorithms/algo_sobel.v
+++ fusion/user_source/algorithms/algo_sobel.v
@@ -0,0 +1,47 @@
+`timescale 1ns/1ps
+// 模块作用：灰度化→3×3 行窗口→有符号梯度→幅值阈值，输出黑白边缘。
+// 总流水延迟 5 级；行缓存另需图像历史，窗口中心为当前输入位置左上方一像素。
+module algo_sobel #(parameter IMG_WIDTH=1280,parameter LB_DEPTH=2048,parameter LB_AW=11,parameter EDGE_THRESHOLD=8'd32,parameter VS_ACTIVE_LOW=0,parameter BORDER=1,parameter DYNAMIC_THRESHOLD=0)(input wire clk,input wire rst_n,input wire [23:0] rgb_in,input wire [7:0] threshold_in,input wire de_in,input wire hs_in,input wire vs_in,output reg [23:0] rgb_out,output reg de_out,output reg hs_out,output reg vs_out);
+ wire [23:0] gray_rgb;wire [7:0] y;wire de_g,hs_g,vs_g;
+ algo_gray u_gray(.clk(clk),.rst_n(rst_n),.rgb_in(rgb_in),.de_in(de_in),.hs_in(hs_in),.vs_in(vs_in),.rgb_out(gray_rgb),.y_out(y),.de_out(de_g),.hs_out(hs_g),.vs_out(vs_g));
+ // p00～p22 按上、中、下三行排列；p22 是当前像素，p11 是窗口中心。
+ wire [7:0] p00,p01,p02,p10,p11,p12,p20,p21,p22;wire de_w,hs_w,vs_w;
+ line_buffer_3x3 #(.DW(8),.LB_W(IMG_WIDTH),.LB_DEPTH(LB_DEPTH),.LB_AW(LB_AW),.BORDER(BORDER),.VS_ACTIVE_LOW(VS_ACTIVE_LOW)) u_window(.clk(clk),.rst_n(rst_n),.din(y),.de_in(de_g),.hs_in(hs_g),.vs_in(vs_g),.p00(p00),.p01(p01),.p02(p02),.p10(p10),.p11(p11),.p12(p12),.p20(p20),.p21(p21),.p22(p22),.de_out(de_w),.hs_out(hs_w),.vs_out(vs_w),.col_out(),.row_out());
+ // Sobel 核的两侧按 1、2、1 加权。10 位无符号和可容纳最大 1020。
+ wire [9:0] right_sum={2'b0,p02}+({2'b0,p12}<<1)+{2'b0,p22};
+ wire [9:0] left_sum={2'b0,p00}+({2'b0,p10}<<1)+{2'b0,p20};
+ wire [9:0] top_sum={2'b0,p00}+({2'b0,p01}<<1)+{2'b0,p02};
+ wire [9:0] bottom_sum={2'b0,p20}+({2'b0,p21}<<1)+{2'b0,p22};
+ // 差值可为负，需 11 位有符号数；gy 采用上行减下行，取绝对值后方向符号不影响结果。
+ wire signed [10:0] gx={1'b0,right_sum}-{1'b0,left_sum};
+ wire signed [10:0] gy={1'b0,top_sum}-{1'b0,bottom_sum};
+ reg signed [10:0] gx_r,gy_r;reg de_r,hs_r,vs_r;
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin gx_r<=0;gy_r<=0;de_r<=0;hs_r<=0;vs_r<=0;end
+  else begin gx_r<=gx;gy_r<=gy;de_r<=de_w;hs_r<=hs_w;vs_r<=vs_w;end
+ end
+ // 负数取二进制补码得到绝对值，再用 |Gx|+|Gy| 近似梯度幅值。
+ wire [10:0] abs_x=gx_r[10]?(~gx_r+11'd1):gx_r[10:0];
+ wire [10:0] abs_y=gy_r[10]?(~gy_r+11'd1):gy_r[10:0];
+ wire [10:0] magnitude=abs_x+abs_y;
+ // magnitude[10:3] 相当于右移 3 位，再与 EDGE_THRESHOLD 比较。
+ // 输出只有黑/白；阈值越高，通常保留的边缘越少。
+ // 输入阈值经过四拍，与灰度两拍、窗口一拍、梯度一拍对应；最终输出仍为五拍。
+ reg [7:0] threshold_pipe [0:3];
+ integer threshold_i;
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin
+   for(threshold_i=0;threshold_i<4;threshold_i=threshold_i+1)
+    threshold_pipe[threshold_i]<=EDGE_THRESHOLD;
+  end else begin
+   threshold_pipe[0]<=threshold_in;
+   for(threshold_i=1;threshold_i<4;threshold_i=threshold_i+1)
+    threshold_pipe[threshold_i]<=threshold_pipe[threshold_i-1];
+  end
+ end
+ wire edge_on=(magnitude[10:3]>=(DYNAMIC_THRESHOLD ? threshold_pipe[3] : EDGE_THRESHOLD));
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin rgb_out<=0;de_out<=0;hs_out<=0;vs_out<=0;end
+  else begin rgb_out<=edge_on?24'hFFFFFF:24'h000000;de_out<=de_r;hs_out<=hs_r;vs_out<=vs_r;end
+ end
+endmodule
--- v8/user_source/algorithms/algo_track.v
+++ fusion/user_source/algorithms/algo_track.v
@@ -0,0 +1,184 @@
+`timescale 1ns/1ps
+
+// RGB888 adapter for the project stream. Coordinates advance only on DE pixels.
+// 算法12：复用颜色检测框，按帧平滑位置；丢失时短暂保留黄虚线框。
+// 不存储图像帧，当前RGB与同步固定延迟2拍；坐标位宽适配1280×720。
+// Pixel outputs are delayed two clocks; VS rising is delayed two clocks before
+// one tracking update, after algo_color_detect has published its frame bbox.
+module algo_track #(
+    parameter integer IMG_WIDTH = 1280,
+    parameter integer IMG_HEIGHT = 720,
+    parameter integer XW = (IMG_WIDTH <= 1) ? 1 : $clog2(IMG_WIDTH),
+    parameter integer YW = (IMG_HEIGHT <= 1) ? 1 : $clog2(IMG_HEIGHT),
+    parameter integer DET_XW = XW,
+    parameter integer DET_YW = YW,
+    parameter integer SMOOTH_SHIFT = 2,
+    parameter integer LOST_MAX = 15,
+    parameter integer SNAP_DIST = 64,
+    parameter integer BOX_W = 2,
+    parameter [23:0] BOX_COLOR = 24'h00FF00,
+    parameter [23:0] LOST_COLOR = 24'hFFFF00,
+    parameter integer HOLD_DASH = 1,
+    parameter integer OSD_EN = 1,
+    parameter integer OSD_W = 40,
+    parameter integer OSD_H = 24,
+    parameter integer OSD_MARGIN = 8,
+    parameter [23:0] OSD_COLOR = 24'h00FF00,
+    parameter integer HINT_EN = 0,
+    parameter [23:0] HINT_COLOR = 24'hFFFF00,
+    parameter integer HINT_W = 24,
+    parameter integer HINT_H = 24,
+    parameter integer VS_ACTIVE_LOW = 0
+)(
+    input wire clk, rst_n,
+    input wire [23:0] rgb_in,
+    input wire de_in, hs_in, vs_in,
+    input wire enable_in,
+    input wire [DET_XW-1:0] det_x_min, det_x_max,
+    input wire [DET_YW-1:0] det_y_min, det_y_max,
+    input wire det_valid,
+    input wire mot_in,
+    output reg [XW-1:0] trk_x_min, trk_x_max,
+    output reg [YW-1:0] trk_y_min, trk_y_max,
+    output reg trk_valid,
+    output reg [4:0] lost_cnt,
+    output reg update_out,
+    output reg [23:0] rgb_out,
+    output reg [7:0] y_out,
+    output reg bin_out, de_out, hs_out, vs_out
+);
+
+    localparam integer CW = (XW > YW) ? XW+2 : YW+2;
+    reg [XW-1:0] xc, x1;
+    reg [YW-1:0] yc, y1;
+    reg vs_active_q, vs_d1, vs_d2;
+    reg [23:0] rgb1;
+    reg de1, hs1, vs1;
+    reg holding;
+    wire vs_active = VS_ACTIVE_LOW ? ~vs_in : vs_in;
+    wire vs_rise = vs_active & ~vs_active_q;
+    // VS只取有效沿并延后2拍：等待颜色核在第1拍发布刚完成帧的bbox。
+    wire frame_event = vs_d2 & ~vs_d1;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            xc <= 0; yc <= 0; vs_active_q <= 0;
+            vs_d1 <= 0; vs_d2 <= 0;
+            rgb1 <= 0;
+            x1 <= 0; y1 <= 0;
+            de1 <= 0; hs1 <= 0; vs1 <= 0;
+        end else begin
+            vs_active_q <= vs_active;
+            vs_d1 <= vs_rise;
+            vs_d2 <= vs_d1;
+            if (vs_rise) begin
+                xc <= 0;
+                yc <= 0;
+            end else if (de_in) begin
+                if (xc == IMG_WIDTH-1) begin
+                    xc <= 0;
+                    if (yc == IMG_HEIGHT-1) yc <= 0;
+                    else yc <= yc + 1'b1;
+                end else xc <= xc + 1'b1;
+            end
+            rgb1 <= rgb_in;
+            x1 <= xc; y1 <= yc;
+            de1 <= de_in; hs1 <= hs_in; vs1 <= vs_in;
+        end
+    end
+
+    // State and publication strobe become visible together after this edge.
+    always @(posedge clk or negedge rst_n)
+        if(!rst_n) update_out<=0; else update_out<=frame_event;
+
+    // 四舍五入的1/4步进；极小位移可能舍入为0，大位移由SNAP_DIST直接吸附。
+    function [XW-1:0] blend_x;
+        input [XW-1:0] tk, dt;
+        reg signed [CW-1:0] delta;
+        reg [CW-1:0] mag, step;
+        begin
+            delta = $signed({1'b0,dt}) - $signed({1'b0,tk});
+            mag = delta[CW-1] ? -delta : delta;
+            if (SMOOTH_SHIFT == 0) step = mag;
+            else step = (mag + (1 << (SMOOTH_SHIFT-1))) >> SMOOTH_SHIFT;
+            blend_x = delta[CW-1] ? tk - step[XW-1:0] : tk + step[XW-1:0];
+        end
+    endfunction
+    function [YW-1:0] blend_y;
+        input [YW-1:0] tk, dt;
+        reg signed [CW-1:0] delta;
+        reg [CW-1:0] mag, step;
+        begin
+            delta = $signed({1'b0,dt}) - $signed({1'b0,tk});
+            mag = delta[CW-1] ? -delta : delta;
+            if (SMOOTH_SHIFT == 0) step = mag;
+            else step = (mag + (1 << (SMOOTH_SHIFT-1))) >> SMOOTH_SHIFT;
+            blend_y = delta[CW-1] ? tk - step[YW-1:0] : tk + step[YW-1:0];
+        end
+    endfunction
+
+    wire det_in_range = (det_x_min <= det_x_max) && (det_y_min <= det_y_max) &&
+                        (det_x_max < IMG_WIDTH) && (det_y_max < IMG_HEIGHT);
+    wire [XW:0] det_cx = ({1'b0,det_x_min} + {1'b0,det_x_max}) >> 1;
+    wire [YW:0] det_cy = ({1'b0,det_y_min} + {1'b0,det_y_max}) >> 1;
+    wire [XW:0] trk_cx = ({1'b0,trk_x_min} + {1'b0,trk_x_max}) >> 1;
+    wire [YW:0] trk_cy = ({1'b0,trk_y_min} + {1'b0,trk_y_max}) >> 1;
+    wire [XW:0] dx = det_cx >= trk_cx ? det_cx-trk_cx : trk_cx-det_cx;
+    wire [YW:0] dy = det_cy >= trk_cy ? det_cy-trk_cy : trk_cy-det_cy;
+    wire snap = SNAP_DIST != 0 && (dx > SNAP_DIST || dy > SNAP_DIST);
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            trk_x_min <= 0; trk_x_max <= 0; trk_y_min <= 0; trk_y_max <= 0;
+            trk_valid <= 0; lost_cnt <= 0; holding <= 0;
+        end else if (!enable_in) begin
+            trk_x_min <= 0; trk_x_max <= 0; trk_y_min <= 0; trk_y_max <= 0;
+            trk_valid <= 0; lost_cnt <= 0; holding <= 0;
+        end else if (frame_event) begin
+            if (det_valid && det_in_range) begin
+                if (!trk_valid || snap) begin
+                    trk_x_min <= det_x_min; trk_x_max <= det_x_max;
+                    trk_y_min <= det_y_min; trk_y_max <= det_y_max;
+                end else begin
+                    trk_x_min <= blend_x(trk_x_min, det_x_min);
+                    trk_x_max <= blend_x(trk_x_max, det_x_max);
+                    trk_y_min <= blend_y(trk_y_min, det_y_min);
+                    trk_y_max <= blend_y(trk_y_max, det_y_max);
+                end
+                trk_valid <= 1; lost_cnt <= 0; holding <= 0;
+            end else if (trk_valid) begin
+                // 本次是第LOST_MAX个连续无效框，立即清框，避免多保留一帧。
+                if (lost_cnt >= LOST_MAX-1) begin
+                    trk_valid <= 0; lost_cnt <= 0; holding <= 0;
+                end else begin
+                    lost_cnt <= lost_cnt + 1'b1; holding <= 1;
+                end
+            end
+        end
+    end
+
+    wire in_span = enable_in && trk_valid && x1 >= trk_x_min && x1 <= trk_x_max &&
+                   y1 >= trk_y_min && y1 <= trk_y_max;
+    wire edge_on = (x1-trk_x_min < BOX_W) || (trk_x_max-x1 < BOX_W) ||
+                   (y1-trk_y_min < BOX_W) || (trk_y_max-y1 < BOX_W);
+    wire dash_on = ~((x1[1] ^ y1[1]) & 1'b1);
+    wire draw_box = in_span && edge_on && (!(HOLD_DASH && holding) || dash_on);
+    wire [XW:0] osd_x0 = IMG_WIDTH - OSD_W - OSD_MARGIN;
+    wire in_osd = x1 >= osd_x0 && x1 < osd_x0 + OSD_W &&
+                  y1 >= OSD_MARGIN && y1 < OSD_MARGIN + OSD_H;
+    wire in_hint = HINT_EN && mot_in && x1 < HINT_W && y1 < HINT_H;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            rgb_out <= 0; y_out <= 0; bin_out <= 0;
+            de_out <= 0; hs_out <= 0; vs_out <= 0;
+        end else begin
+            rgb_out <= (draw_box ? (holding ? LOST_COLOR : BOX_COLOR) : rgb1);
+            if (enable_in && OSD_EN && trk_valid && in_osd) rgb_out <= OSD_COLOR;
+            else if (enable_in && in_hint) rgb_out <= HINT_COLOR;
+            y_out <= in_span ? 8'hff : 8'h00;
+            bin_out <= in_span;
+            de_out <= de1; hs_out <= hs1; vs_out <= vs1;
+        end
+    end
+endmodule
--- v8/user_source/algorithms/ddr_recovery_supervisor.v
+++ fusion/user_source/algorithms/ddr_recovery_supervisor.v
@@ -0,0 +1,78 @@
+`timescale 1ns/1ps
+// This supervisor survives DDR/PHY clock loss. Only SW0/POR resets its retry budget.
+module ddr_recovery_supervisor #(
+ parameter integer RESET_CYCLES=50000,
+ parameter integer CAL_TIMEOUT_CYCLES=50000000,
+ parameter integer HEARTBEAT_TIMEOUT_CYCLES=5000000
+)(
+ input wire clk,por_n,base_ready,calibrated,ddr_fault,ddr_heartbeat,
+ output wire controller_reset_n,clients_reset_n,
+ output wire [1:0] status
+);
+ localparam BOOT=0,CALIBRATE=1,RUN=2,RESTART=3,LOCKED=4;
+ localparam RW=(RESET_CYCLES<2)?1:$clog2(RESET_CYCLES);
+ localparam CW=(CAL_TIMEOUT_CYCLES<2)?1:$clog2(CAL_TIMEOUT_CYCLES);
+ localparam HW=(HEARTBEAT_TIMEOUT_CYCLES<2)?1:$clog2(HEARTBEAT_TIMEOUT_CYCLES);
+ reg[2:0]state;
+ reg retry_used,heartbeat_seen;
+ reg[RW-1:0]reset_count;
+ reg[CW-1:0]cal_count;
+ reg[HW-1:0]heartbeat_count;
+ reg[2:0]cal_high_count,cal_low_count;
+ (* async_reg="true" *) reg ready_1,ready_2,cal_1,cal_2,fault_1,fault_2,hb_1,hb_2;
+ always @(posedge clk or negedge por_n)
+  if(!por_n)begin ready_1<=0;ready_2<=0;cal_1<=0;cal_2<=0;fault_1<=0;fault_2<=0;hb_1<=0;hb_2<=0;end
+  else begin
+   ready_1<=base_ready;ready_2<=ready_1;cal_1<=calibrated;cal_2<=cal_1;
+   fault_1<=ddr_fault;fault_2<=fault_1;hb_1<=ddr_heartbeat;hb_2<=hb_1;
+  end
+ assign controller_reset_n=por_n && ready_2 && (state==CALIBRATE || state==RUN);
+ assign clients_reset_n=controller_reset_n && state==RUN;
+ assign status=(state==LOCKED)?2'd2:(state==RUN)?2'd0:2'd1;
+ always @(posedge clk or negedge por_n)begin
+  if(!por_n)begin
+   state<=BOOT;retry_used<=0;reset_count<=0;cal_count<=0;
+   heartbeat_count<=0;heartbeat_seen<=0;cal_high_count<=0;cal_low_count<=0;
+  end else if(state==LOCKED)begin
+   state<=LOCKED;
+  end else if(!ready_2)begin
+   state<=BOOT;reset_count<=0;cal_count<=0;heartbeat_count<=0;
+   cal_high_count<=0;cal_low_count<=0;heartbeat_seen<=hb_2;
+  end else begin
+   case(state)
+    BOOT,RESTART:begin
+     cal_count<=0;cal_high_count<=0;cal_low_count<=0;
+     heartbeat_count<=0;heartbeat_seen<=hb_2;
+     if(reset_count==RESET_CYCLES-1)begin state<=CALIBRATE;reset_count<=0;end
+     else reset_count<=reset_count+1'b1;
+    end
+    CALIBRATE:begin
+     heartbeat_seen<=hb_2;heartbeat_count<=0;
+     if(cal_2)begin
+      if(cal_high_count==3)begin state<=RUN;cal_high_count<=0;cal_low_count<=0;end
+      else cal_high_count<=cal_high_count+1'b1;
+     end else cal_high_count<=0;
+     if(cal_count==CAL_TIMEOUT_CYCLES-1)begin
+      cal_high_count<=0;reset_count<=0;
+      if(retry_used)state<=LOCKED;
+      else begin retry_used<=1;state<=RESTART;end
+     end else cal_count<=cal_count+1'b1;
+    end
+    RUN:begin
+     cal_count<=0;
+     if(cal_2)cal_low_count<=0;
+     else if(cal_low_count!=4)cal_low_count<=cal_low_count+1'b1;
+     if(hb_2!=heartbeat_seen)begin heartbeat_seen<=hb_2;heartbeat_count<=0;end
+     else if(heartbeat_count!=HEARTBEAT_TIMEOUT_CYCLES-1)heartbeat_count<=heartbeat_count+1'b1;
+     if(fault_2 || cal_low_count==3 || heartbeat_count==HEARTBEAT_TIMEOUT_CYCLES-1)begin
+      reset_count<=0;cal_high_count<=0;
+      if(retry_used)state<=LOCKED;
+      else begin retry_used<=1;state<=RESTART;end
+     end
+    end
+    LOCKED:; // Both controller and clients stay reset; HDMI/OSD remain alive.
+    default:state<=LOCKED;
+   endcase
+  end
+ end
+endmodule
--- v8/user_source/algorithms/frame_mailbox_cdc.v
+++ fusion/user_source/algorithms/frame_mailbox_cdc.v
@@ -0,0 +1,28 @@
+`timescale 1ns/1ps
+// Event mailbox: unlike a state synchronizer, equal consecutive payloads are events.
+// Both sides share an asynchronous reset source; each domain releases it locally.
+module frame_mailbox_cdc #(parameter WIDTH=16)(
+ input wire src_clk,src_rst_n,src_valid,
+ input wire[WIDTH-1:0]src_data,
+ output wire src_ready,
+ input wire dst_clk,dst_rst_n,
+ output reg dst_valid,
+ output reg[WIDTH-1:0]dst_data
+);
+ reg[WIDTH-1:0]payload;
+ reg request,acknowledge;
+ (* async_reg="true" *) reg ack_1,ack_2,req_1,req_2;
+ assign src_ready=(ack_2==request);
+ always @(posedge src_clk or negedge src_rst_n)
+  if(!src_rst_n)begin payload<=0;request<=0;ack_1<=0;ack_2<=0;end
+  else begin
+   ack_1<=acknowledge;ack_2<=ack_1;
+   if(src_valid && src_ready)begin payload<=src_data;request<=~request;end
+  end
+ always @(posedge dst_clk or negedge dst_rst_n)
+  if(!dst_rst_n)begin dst_valid<=0;dst_data<=0;req_1<=0;req_2<=0;acknowledge<=0;end
+  else begin
+   req_1<=request;req_2<=req_1;dst_valid<=0;
+   if(req_2!=acknowledge)begin dst_data<=payload;dst_valid<=1;acknowledge<=req_2;end
+  end
+endmodule
--- v8/user_source/algorithms/key_mode_ctrl.v
+++ fusion/user_source/algorithms/key_mode_ctrl.v
@@ -0,0 +1,257 @@
+`timescale 1ns/1ps
+
+// 两级同步、连续稳定消抖、双键仲裁，以及模式/阈值按键控制。
+// KEY0/KEY1 低有效；SW1（threshold_edit）高电平选择阈值、增益或偏振操作。
+module key_mode_ctrl #(
+    parameter integer CLK_HZ = 75000000,
+    parameter integer DEBOUNCE_MS = 20,
+    parameter integer ALGO_COUNT = 4,
+    parameter integer DEBOUNCE_CYCLES = 0,
+    parameter integer ENABLE_THRESHOLD_CONTROL = 0,
+    parameter integer ENABLE_POLAR_CONTROL = 0,
+    parameter integer BIN_THRESHOLD = 128,
+    parameter integer EDGE_THRESHOLD = 32,
+    parameter integer THRESHOLD_STEP = 1,
+    parameter integer BRIGHT_GAIN = 24,
+    parameter integer CONTRAST_GAIN = 24,
+    parameter integer GAIN_STEP = 1,
+    parameter integer EXTERNAL_EDIT_MODE = 0,
+    parameter integer MOTION_THRESHOLD = 8,
+    parameter integer ENABLE_MOTION_THRESHOLD_CONTROL = 0
+) (
+    input wire clk,
+    input wire rst_n,
+    input wire key0_n,
+    input wire key1_n,
+    input wire frame_commit,
+    output reg [3:0] mode_pending,
+    output reg [3:0] mode_active,
+    input wire threshold_edit,
+    input wire [3:0] edit_mode_in,
+    output wire threshold_edit_active,
+    output reg [7:0] bin_threshold_active,
+    output reg [7:0] edge_threshold_active,
+    output reg [7:0] bright_gain_active,
+    output reg [7:0] contrast_gain_active,
+    output reg polar_capture_pulse,
+    output reg polar_restart_pulse,
+    output reg [7:0] motion_threshold_active
+);
+
+    // 64 位中间乘积避免频率与毫秒相乘时溢出；仿真可直接覆盖周期数。
+    localparam [63:0] DB_CYCLES_WIDE =
+        (64'd1 * CLK_HZ * DEBOUNCE_MS + 999) / 1000;
+    localparam integer DB_CYCLES = (DEBOUNCE_CYCLES > 0) ?
+        DEBOUNCE_CYCLES : ((DB_CYCLES_WIDE < 1) ? 1 : DB_CYCLES_WIDE);
+    localparam integer ARB_CYCLES = DB_CYCLES + 2;
+    localparam integer DB_CNT_W = (DB_CYCLES <= 1) ? 1 : $clog2(DB_CYCLES + 1);
+    localparam integer ARB_CNT_W = (ARB_CYCLES <= 1) ? 1 : $clog2(ARB_CYCLES + 1);
+
+    reg [1:0] key0_sync, key1_sync, selector_sync;
+    reg key0_released, key1_released, selector_confirmed;
+    reg [DB_CNT_W-1:0] key0_count, key1_count, selector_count;
+    reg armed, arbitration_active, arbitration_suppressed, arbitration_previous;
+    reg arbitration_selector_sample, arbitration_selector_confirmed;
+    reg [3:0] arbitration_mode;
+    reg [ARB_CNT_W-1:0] arbitration_count;
+    reg [7:0] bin_threshold_pending, edge_threshold_pending;
+    reg [7:0] bright_gain_pending, contrast_gain_pending;
+    reg [7:0] motion_threshold_pending;
+
+    wire [3:0] event_mode;
+    wire [3:0] control_mode = EXTERNAL_EDIT_MODE ? edit_mode_in : mode_active;
+    // 本拍双键已按下，或另一键恰在事件采样沿完成消抖时，抑制本次动作。
+    wire key0_press_completes = key0_released && !key0_sync[1] && (key0_count == DB_CYCLES - 1);
+    wire key1_press_completes = key1_released && !key1_sync[1] && (key1_count == DB_CYCLES - 1);
+    wire two_key_press_at_event =
+        (!key0_released || key0_press_completes) &&
+        (!key1_released || key1_press_completes);
+
+    wire press_event = arbitration_active &&
+        (arbitration_count == {{(ARB_CNT_W-1){1'b0}}, 1'b1}) &&
+        !arbitration_suppressed && !two_key_press_at_event &&
+        (selector_sync[1] == arbitration_selector_sample) &&
+        (selector_confirmed == arbitration_selector_confirmed) &&
+        // 算法切换允许已有pending模式在仲裁期间先提交；参数编辑锁定目标显示模式。
+        (!ENABLE_THRESHOLD_CONTROL || !arbitration_selector_confirmed ||
+         (control_mode == arbitration_mode));
+    wire mode_event = press_event &&
+        (!ENABLE_THRESHOLD_CONTROL || !arbitration_selector_confirmed);
+    wire polar_event = press_event && ENABLE_POLAR_CONTROL &&
+        arbitration_selector_confirmed && (arbitration_mode >= 4'd9) && (arbitration_mode <= 4'd12);
+    wire threshold_event = press_event && ENABLE_THRESHOLD_CONTROL &&
+        arbitration_selector_confirmed &&
+        ((arbitration_mode == 4'd2) || (arbitration_mode == 4'd3) ||
+         (arbitration_mode == 4'd4) || (arbitration_mode == 4'd5));
+    wire motion_threshold_event = press_event && ENABLE_MOTION_THRESHOLD_CONTROL &&
+        arbitration_selector_confirmed && (arbitration_mode == 4'd14);
+    wire [7:0] motion_threshold_next = !motion_threshold_event ? motion_threshold_pending :
+        (arbitration_previous ?
+            ((motion_threshold_pending <= 8'd1) ? 8'd1 : motion_threshold_pending - 8'd1) :
+            ((motion_threshold_pending >= 8'd255) ? 8'd255 : motion_threshold_pending + 8'd1));
+    wire [7:0] bin_threshold_next = !threshold_event || arbitration_mode != 4'd2 ?
+        bin_threshold_pending :
+        (arbitration_previous ?
+            ((bin_threshold_pending < THRESHOLD_STEP) ? 8'd0 :
+             bin_threshold_pending - THRESHOLD_STEP) :
+            ((bin_threshold_pending > (255 - THRESHOLD_STEP)) ? 8'hff :
+             bin_threshold_pending + THRESHOLD_STEP));
+    wire [7:0] edge_threshold_next = !threshold_event || arbitration_mode != 4'd3 ?
+        edge_threshold_pending :
+        (arbitration_previous ?
+            ((edge_threshold_pending < THRESHOLD_STEP) ? 8'd0 :
+             edge_threshold_pending - THRESHOLD_STEP) :
+            ((edge_threshold_pending > (255 - THRESHOLD_STEP)) ? 8'hff :
+             edge_threshold_pending + THRESHOLD_STEP));
+    // algo_bright/algo_contrast 的 thr_in 是 Q4.4 增益；24 表示 1.5 倍。
+    wire [7:0] bright_gain_next = !threshold_event || arbitration_mode != 4'd4 ?
+        bright_gain_pending :
+        (arbitration_previous ?
+            ((bright_gain_pending < GAIN_STEP) ? 8'd0 :
+             bright_gain_pending - GAIN_STEP) :
+            ((bright_gain_pending > (255 - GAIN_STEP)) ? 8'hff :
+             bright_gain_pending + GAIN_STEP));
+    wire [7:0] contrast_gain_next = !threshold_event || arbitration_mode != 4'd5 ?
+        contrast_gain_pending :
+        (arbitration_previous ?
+            ((contrast_gain_pending < GAIN_STEP) ? 8'd0 :
+             contrast_gain_pending - GAIN_STEP) :
+            ((contrast_gain_pending > (255 - GAIN_STEP)) ? 8'hff :
+             contrast_gain_pending + GAIN_STEP));
+
+    assign threshold_edit_active = ENABLE_THRESHOLD_CONTROL ? selector_confirmed : 1'b0;
+    assign event_mode = mode_event ?
+        (arbitration_previous ?
+            ((mode_pending == 0) ? (ALGO_COUNT - 1) : (mode_pending - 1'b1)) :
+            ((mode_pending == (ALGO_COUNT - 1)) ? 4'd0 : (mode_pending + 1'b1))) :
+        mode_pending;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            key0_sync <= 2'b11;
+            key1_sync <= 2'b11;
+            selector_sync <= 2'b00;
+            key0_released <= 1'b1;
+            key1_released <= 1'b1;
+            selector_confirmed <= 1'b0;
+            key0_count <= {DB_CNT_W{1'b0}};
+            key1_count <= {DB_CNT_W{1'b0}};
+            selector_count <= {DB_CNT_W{1'b0}};
+            armed <= 1'b1;
+            arbitration_active <= 1'b0;
+            arbitration_suppressed <= 1'b0;
+            arbitration_previous <= 1'b0;
+            arbitration_selector_sample <= 1'b0;
+            arbitration_selector_confirmed <= 1'b0;
+            arbitration_mode <= 4'd0;
+            arbitration_count <= {ARB_CNT_W{1'b0}};
+            mode_pending <= 4'd0;
+            mode_active <= 4'd0;
+            bin_threshold_pending <= BIN_THRESHOLD;
+            edge_threshold_pending <= EDGE_THRESHOLD;
+            bright_gain_pending <= BRIGHT_GAIN;
+            contrast_gain_pending <= CONTRAST_GAIN;
+            motion_threshold_pending <= MOTION_THRESHOLD;
+            bin_threshold_active <= BIN_THRESHOLD;
+            edge_threshold_active <= EDGE_THRESHOLD;
+            bright_gain_active <= BRIGHT_GAIN;
+            contrast_gain_active <= CONTRAST_GAIN;
+            motion_threshold_active <= MOTION_THRESHOLD;
+            polar_capture_pulse <= 1'b0;
+            polar_restart_pulse <= 1'b0;
+        end else begin
+            polar_capture_pulse <= 1'b0;
+            polar_restart_pulse <= 1'b0;
+            key0_sync <= {key0_sync[0], key0_n};
+            key1_sync <= {key1_sync[0], key1_n};
+            selector_sync <= {selector_sync[0],
+                              ENABLE_THRESHOLD_CONTROL ? threshold_edit : 1'b0};
+
+            if (key0_sync[1] == key0_released) key0_count <= 0;
+            else if (key0_count == DB_CYCLES - 1) begin
+                key0_released <= key0_sync[1];
+                key0_count <= 0;
+            end else key0_count <= key0_count + 1'b1;
+
+            if (key1_sync[1] == key1_released) key1_count <= 0;
+            else if (key1_count == DB_CYCLES - 1) begin
+                key1_released <= key1_sync[1];
+                key1_count <= 0;
+            end else key1_count <= key1_count + 1'b1;
+
+            // SW1 使用与按键相同的同步级数和连续稳定消抖。
+            if (!ENABLE_THRESHOLD_CONTROL || selector_sync[1] == selector_confirmed)
+                selector_count <= 0;
+            else if (selector_count == DB_CYCLES - 1) begin
+                selector_confirmed <= selector_sync[1];
+                selector_count <= 0;
+            end else selector_count <= selector_count + 1'b1;
+
+            // 锁存选择开关和当前显示模式；窗口内任何变化都会粘滞抑制本次动作。
+            if (armed && !arbitration_active && (!key0_released || !key1_released)) begin
+                armed <= 1'b0;
+                if (key0_released ^ key1_released) begin
+                    arbitration_active <= 1'b1;
+                    arbitration_suppressed <= 1'b0;
+                    arbitration_previous <= !key0_released;
+                    arbitration_selector_sample <= selector_sync[1];
+                    arbitration_selector_confirmed <= selector_confirmed;
+                    arbitration_mode <= control_mode;
+                    arbitration_count <= ARB_CYCLES;
+                end else begin
+                    arbitration_active <= 1'b0;
+                    arbitration_suppressed <= 1'b1;
+                end
+            end else if (arbitration_active) begin
+                if (armed && (!key0_released || !key1_released)) begin
+                    armed <= 1'b0;
+                    arbitration_suppressed <= 1'b1;
+                end
+                if ((!key0_released && !key1_released) ||
+                    (selector_sync[1] != arbitration_selector_sample) ||
+                    (selector_confirmed != arbitration_selector_confirmed) ||
+                    (ENABLE_THRESHOLD_CONTROL && arbitration_selector_confirmed &&
+                     (control_mode != arbitration_mode)))
+                    arbitration_suppressed <= 1'b1;
+                if (arbitration_count != 0)
+                    arbitration_count <= arbitration_count - 1'b1;
+                else arbitration_active <= 1'b0;
+            end
+
+            if (!key0_released && !key1_released)
+                arbitration_suppressed <= 1'b1;
+
+            if (key0_released && key1_released) begin
+                armed <= 1'b1;
+                if (!arbitration_active) begin
+                    arbitration_suppressed <= 1'b0;
+                    arbitration_count <= {ARB_CNT_W{1'b0}};
+                end
+            end
+
+            if (mode_event) mode_pending <= event_mode;
+            if (frame_commit) mode_active <= event_mode;
+            // SW1=1 时极化模式的 KEY3/KEY2 在消抖和仲裁完成后各发单拍命令。
+            if (polar_event && !arbitration_previous) polar_capture_pulse <= 1'b1;
+            if (polar_event &&  arbitration_previous) polar_restart_pulse <= 1'b1;
+
+            if (threshold_event && arbitration_mode == 4'd2)
+                bin_threshold_pending <= bin_threshold_next;
+            if (threshold_event && arbitration_mode == 4'd3)
+                edge_threshold_pending <= edge_threshold_next;
+            if (threshold_event && arbitration_mode == 4'd4)
+                bright_gain_pending <= bright_gain_next;
+            if (threshold_event && arbitration_mode == 4'd5)
+                contrast_gain_pending <= contrast_gain_next;
+            if (motion_threshold_event)
+                motion_threshold_pending <= motion_threshold_next;
+            if (frame_commit) begin
+                bin_threshold_active <= bin_threshold_next;
+                edge_threshold_active <= edge_threshold_next;
+                bright_gain_active <= bright_gain_next;
+                contrast_gain_active <= contrast_gain_next;
+                motion_threshold_active <= motion_threshold_next;
+            end
+        end
+    end
+endmodule
--- v8/user_source/algorithms/line_buffer_3x3.v
+++ fusion/user_source/algorithms/line_buffer_3x3.v
@@ -0,0 +1,94 @@
+`timescale 1ns/1ps
+
+// Streaming 3x3 window: two line memories and three horizontal shift rows.
+// 模块作用：两行存储加三组水平移位寄存器，构造连续像素流的 3×3 窗口。
+// 当前窗口只使用已到达像素：行 y-2/y-1/y，列 x-2/x-1/x，不读取未来像素。
+// 每行 DE 必须连续，行长不超过 LB_DEPTH；LB_W 当前未参与行结束判断。
+module line_buffer_3x3 #(parameter DW=8, parameter LB_W=1280, parameter LB_DEPTH=2048, parameter LB_AW=11, parameter BORDER=1, parameter VS_ACTIVE_LOW=0)(
+ input wire clk,input wire rst_n,input wire [DW-1:0] din,input wire de_in,input wire hs_in,input wire vs_in,
+ output wire [DW-1:0] p00,p01,p02,p10,p11,p12,p20,p21,p22,
+ output wire de_out,output wire hs_out,output wire vs_out,output wire [10:0] col_out,output wire [10:0] row_out
+);
+ localparam [DW-1:0] ZERO={DW{1'b0}};
+ // 两块行存储不整体复位，便于推断 RAM；帧首通过有效行判断屏蔽旧数据。
+ reg [DW-1:0] line1[0:LB_DEPTH-1],line2[0:LB_DEPTH-1];
+ reg [DW-1:0] d1,d2;
+ reg [LB_AW-1:0] x;
+ // 同步 RAM 预取下一列；消隐时预取第 0 列，为下一行第一个像素准备历史数据。
+ wire [LB_AW-1:0] read_a=de_in?(x+1'b1):{LB_AW{1'b0}};
+ always @(posedge clk) begin
+  if(de_in) line1[x]<=din;
+  d1<=line1[read_a];
+  if(de_in) line2[x]<=d1;
+  d2<=line2[read_a];
+ end
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) x<=0;
+  else if(de_in) x<=x+1'b1;
+  else x<=0;
+ end
+ // DE 上升沿识别新行；观察到有效 VS 后，下一行从行号 0 开始。
+ // VS_ACTIVE_LOW 决定有效 VS 电平；in_vblank 仅检测 VS 有效电平，不覆盖全部垂直消隐。
+ reg de_prev;
+ reg [10:0] row_idx;
+ reg vs_seen;
+ wire in_vblank=VS_ACTIVE_LOW?~vs_in:vs_in;
+ wire line_start=de_in&~de_prev;
+ wire [10:0] row_now=line_start?(vs_seen?11'd0:row_idx+11'd1):row_idx;
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin de_prev<=0;row_idx<=0;vs_seen<=0;end
+  else begin
+   de_prev<=de_in;
+   if(in_vblank) vs_seen<=1'b1;
+   if(line_start) begin
+    if(vs_seen) begin row_idx<=0;vs_seen<=0;end
+    else row_idx<=row_idx+1'b1;
+   end
+  end
+ end
+ // 前两行不足时按 BORDER 补边：非零复制已有边界像素，0 则补零。
+ wire row1_valid=(row_now>=1);
+ wire row2_valid=(row_now>=2);
+ wire [DW-1:0] row0=din;
+ wire [DW-1:0] row1=row1_valid?d1:(BORDER?row0:ZERO);
+ wire [DW-1:0] row2=row2_valid?d2:(BORDER?(row1_valid?d1:row0):ZERO);
+ // 每组保留三个相邻列。移位只在 DE=1 时进行；行首残留列由后面的 h 函数修正。
+ reg [DW-1:0] s0[0:2],s1[0:2],s2[0:2];
+ reg [LB_AW-1:0] xc;
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin
+   s0[0]<=0;s0[1]<=0;s0[2]<=0;s1[0]<=0;s1[1]<=0;s1[2]<=0;s2[0]<=0;s2[1]<=0;s2[2]<=0;xc<=0;
+  end else begin
+   xc<=x;
+   if(de_in) begin
+    s0[0]<=s0[1];s0[1]<=s0[2];s0[2]<=row0;
+    s1[0]<=s1[1];s1[1]<=s1[2];s1[2]<=row1;
+    s2[0]<=s2[1];s2[1]<=s2[2];s2[2]<=row2;
+   end
+  end
+ end
+ // 左边界处理：第 0 列缺两列，第 1 列缺一列，选择复制边界或补零。
+ function [DW-1:0] h;
+  input [DW-1:0] leftv,midv,rightv;
+  input [1:0] pos;
+  begin
+   case(pos)
+    2'd2:h=rightv;
+    2'd1:h=(xc>=1)?midv:(BORDER?rightv:ZERO);
+    default:h=(xc>=2)?leftv:(BORDER?((xc==1)?midv:rightv):ZERO);
+   endcase
+  end
+ endfunction
+ // 窗口排列：p00 p01 p02 / p10 p11 p12 / p20 p21 p22。
+ // 中心对应 (x-1,y-1)，输出有效时序跟随 (x,y)，与居中卷积相比内容右移、下移各一像素。
+ assign p00=h(s2[0],s2[1],s2[2],0),p01=h(s2[0],s2[1],s2[2],1),p02=h(s2[0],s2[1],s2[2],2);
+ assign p10=h(s1[0],s1[1],s1[2],0),p11=h(s1[0],s1[1],s1[2],1),p12=h(s1[0],s1[1],s1[2],2);
+ assign p20=h(s0[0],s0[1],s0[2],0),p21=h(s0[0],s0[1],s0[2],1),p22=h(s0[0],s0[1],s0[2],2);
+ reg hs_d,vs_d,de_d;
+ always @(posedge clk or negedge rst_n) begin
+  if(!rst_n) begin hs_d<=0;vs_d<=0;de_d<=0;end
+  else begin hs_d<=hs_in;vs_d<=vs_in;de_d<=de_in;end
+ end
+ // 坐标是窗口右下角当前像素的位置，不是中心坐标；输出固定 11 位。
+ assign de_out=de_d,hs_out=hs_d,vs_out=vs_d,col_out={1'b0,xc},row_out=row_idx;
+endmodule
--- v8/user_source/algorithms/line_buffer_3x3_sparse.v
+++ fusion/user_source/algorithms/line_buffer_3x3_sparse.v
@@ -0,0 +1,177 @@
+//=============================================================================
+// 算法9专用稀疏 3x3 窗口缓存；原 line_buffer_3x3.v 保持不变，本模块仅供算法9使用。
+// 核心实例参数：DW=16、LB_W=1280、LB_DEPTH=2048、LB_AW=11，存放 {y,DoLP}。
+// SPARSE_EN=1 时 HS 清列号；vin 空白期间列号和读地址状态保持，支持连续突发及任意长度停顿。
+// VS_ACTIVE_LOW=1：帧消隐区间复位行状态；HS 行首脉冲领先该行首个有效像素一拍。
+// 两行存储器不复位以保留同步 RAM 推断形式；BORDER 可选复制或补零。资源以整机综合实测为准。
+//=============================================================================
+`timescale 1ns/1ps
+
+module line_buffer_3x3_sparse #(
+    parameter DW            = 8,        // 数据位宽：8 = 灰度(Sobel/均值滤波)；1 = 二值(形态学)
+    parameter LB_W          = 640,      // 一行最多多少个有效像素（= IMG_W）
+    parameter LB_DEPTH      = 1024,     // 行缓存深度，必须 >= LB_W+1，建议 2 的幂
+    parameter LB_AW         = 10,       // 地址位宽 = log2(LB_DEPTH)
+    parameter BORDER        = 1,        // 1 = 复制边缘（默认，推荐）；0 = 补零
+    parameter VS_ACTIVE_LOW = 1,        // 1 = vs_in 低有效（与 video_timing 的 tmg_vsync 一致）
+    // ★ 稀疏 de 模式（算法9 的有效像素可成块连续，块间可有任意长度空白）
+    //   稠密模式下"de 无效即把列号清零"是对的；但稀疏模式下 de 每来一个就拉低一次，
+    //   列号会被每个像素复位 ⇒ 行缓存全乱。SPARSE_EN=1 时改为用 hs_in 界定行边界：
+    //     列号只在 hs（行首）清零；de 无效期间保持。hs_in 在稠密模式下没被逻辑使用（只延到 hs_out），
+    //     本文件为算法9专用克隆，不修改或替代普通 line_buffer_3x3。
+    parameter SPARSE_EN     = 0
+)(
+    input  wire          clk,
+    input  wire          rst_n,
+
+    input  wire [DW-1:0] din,           // 输入像素（灰度/二值）
+    input  wire          de_in,         // 有效像素；SPARSE_EN=1 时行内允许任意空白
+    input  wire          hs_in,
+    input  wire          vs_in,
+
+    // ---- 3x3 窗口：p[r][c]，r=0 下(当前行 y)，r=2 上(y-2)；c=2 右(当前列 x)，c=0 左(x-2) ----
+    output wire [DW-1:0] p00, p01, p02, // 上  行 (y-2)
+    output wire [DW-1:0] p10, p11, p12, // 中  行 (y-1)   p11 = 窗口中心(数学上是 (y-1,x-1))
+    output wire [DW-1:0] p20, p21, p22, // 下  行 (y  )   p22 = 当前输入像素
+
+    output wire          de_out,        // 窗口有效（比 de_in 晚 1 拍）
+    output wire          hs_out,
+    output wire          vs_out,
+    output wire [10:0]   col_out,       // 窗口右列(=当前列)的列号，供需要位置的算法用
+    output wire [10:0]   row_out        // 窗口下行的行号(=当前输入行的行号)
+);
+
+    localparam ZERO_DW = {DW{1'b0}};
+
+    //=====================================================================
+    // 行缓存（**不复位**，否则推断不出 BRAM）
+    //=====================================================================
+    reg [DW-1:0] lb1 [0:LB_DEPTH-1];
+    reg [DW-1:0] lb2 [0:LB_DEPTH-1];
+    reg [DW-1:0] d1, d2;
+
+    // 列计数器：de 有效时 0..LB_W-1
+    //   稠密模式（SPARSE_EN=0）：de 无效（行消隐）时清零 —— 这就是"行切换"，不需要行号/行起始信号；
+    //   稀疏模式（SPARSE_EN=1）：只在行首（hs_in）清零，de 无效期间保持（否则每像素复位一次）。
+    reg [LB_AW-1:0] x;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n)      x <= {LB_AW{1'b0}};
+        else if (de_in)  x <= x + 1'b1;
+        else if (SPARSE_EN ? hs_in : 1'b1) x <= {LB_AW{1'b0}};
+    end
+
+    // 读地址前视 1 列。稠密模式消隐时读 0；稀疏模式在 HS 预读第 0 列并在空白时保持地址。
+    //   ★ 稀疏模式必须**在空转周期保持地址**：否则 ra 被反复拉成 0，d1/d2 被 lb1[0]/lb2[0] 覆盖，
+    //     下一个像素的三行数据全错（实测现象：稀疏输出与稠密输出逐像素不同）。
+    //     规则：像素周期用 x+1（前视）；行首(hs)用 0（预装第 0 列，等同稠密期的消隐读）；其余保持。
+    reg  [LB_AW-1:0] ra_h;
+    wire [LB_AW-1:0] ra_dense = de_in ? (x + 1'b1) : {LB_AW{1'b0}};
+    wire [LB_AW-1:0] ra_spars = de_in ? (x + 1'b1) : (hs_in ? {LB_AW{1'b0}} : ra_h);
+    wire [LB_AW-1:0] ra = SPARSE_EN ? ra_spars : ra_dense;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) ra_h <= {LB_AW{1'b0}};
+        else        ra_h <= ra;
+    end
+
+    always @(posedge clk) begin
+        if (de_in) lb1[x] <= din;       // 行缓存1 <- 本行
+        d1 <= lb1[ra];                  // -> 上一行同列
+        if (de_in) lb2[x] <= d1;        // 行缓存2 <- 上一行
+        d2 <= lb2[ra];                  // -> 上上行同列
+    end
+
+    //=====================================================================
+    // 行号：识别"当前输入行的行号"，用于处理图像上边界
+    //   vs 低有效（VS_ACTIVE_LOW=1）期间置位 vs_seen；下一次行起始时把行号清 0。
+    //   这样"vs 之后的第一条有效行"行号恰好是 0（而不是 1）。
+    //=====================================================================
+    reg        de_d1;
+    reg [10:0] row_idx;
+    reg        vs_seen;
+
+    wire in_vblank = VS_ACTIVE_LOW ? ~vs_in : vs_in;
+    // 行起始判定：稠密 = de 上升沿；稀疏 = hs 脉冲（de 是稀疏脉冲，上升沿每像素都有，不能当行首）
+    wire line_start = SPARSE_EN ? hs_in : (de_in & ~de_d1);
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            de_d1    <= 1'b0;
+            row_idx  <= 11'd0;
+            vs_seen  <= 1'b0;
+        end else begin
+            de_d1 <= de_in;
+            if (in_vblank) vs_seen <= 1'b1;
+            if (line_start) begin
+                if (vs_seen) begin row_idx <= 11'd0;        vs_seen <= 1'b0; end
+                else              row_idx <= row_idx + 11'd1;
+            end
+        end
+    end
+
+    // 垂直边界：row1 = y-1、row2 = y-2 是否存在
+    //   ★ 这里必须用**组合**的 row_cur，不能用寄存的 row_idx：
+    //     row_idx <= 0 要到"本行第一个像素那个时钟沿"才生效，
+    //     而三行数据正是在那一拍被装进移位寄存器的 ⇒ 直接用 row_idx 会晚一拍，
+    //     于是本行前两行会误判成"存在"，把上一帧/上一行的残余数据当邻域用（实测出人工边缘）。
+    wire [10:0] row_cur = line_start ? (vs_seen ? 11'd0 : (row_idx + 11'd1)) : row_idx;
+    wire r1_ok = (row_cur >= 11'd1);
+    wire r2_ok = (row_cur >= 11'd2);
+
+    wire [DW-1:0] row0 = din;                                              // y
+    wire [DW-1:0] row1 = r1_ok ? d1 : (BORDER ? row0 : ZERO_DW);           // y-1
+    wire [DW-1:0] row2 = r2_ok ? d2 : (BORDER ? (r1_ok ? d1 : row0) : ZERO_DW); // y-2
+
+    //=====================================================================
+    // 3 列移位寄存器（de_in 门控：消隐期保持，行首自然从 0 列开始）
+    //=====================================================================
+    reg [DW-1:0] s0 [0:2];      // 行 y
+    reg [DW-1:0] s1 [0:2];      // 行 y-1
+    reg [DW-1:0] s2 [0:2];      // 行 y-2
+    reg [LB_AW-1:0] xc;         // 窗口右列的列号（= 列号延迟 1 拍）
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            s0[0] <= ZERO_DW; s0[1] <= ZERO_DW; s0[2] <= ZERO_DW;
+            s1[0] <= ZERO_DW; s1[1] <= ZERO_DW; s1[2] <= ZERO_DW;
+            s2[0] <= ZERO_DW; s2[1] <= ZERO_DW; s2[2] <= ZERO_DW;
+            xc    <= {LB_AW{1'b0}};
+        end else begin
+            xc <= x;
+            if (de_in) begin
+                s0[0] <= s0[1]; s0[1] <= s0[2]; s0[2] <= row0;
+                s1[0] <= s1[1]; s1[1] <= s1[2]; s1[2] <= row1;
+                s2[0] <= s2[1]; s2[1] <= s2[2]; s2[2] <= row2;
+            end
+        end
+    end
+
+    //=====================================================================
+    // 水平边界：窗口右列 = xc（s*[2]），中列 = xc-1（s*[1]），左列 = xc-2（s*[0]）
+    //   xc==0 时"中/左"不存在，xc==1 时"左"不存在；按 BORDER 复制或补零。
+    //=====================================================================
+    assign p02 = s2[2];
+    assign p01 = (xc >= 1) ? s2[1] : (BORDER ? s2[2] : ZERO_DW);
+    assign p00 = (xc >= 2) ? s2[0] : (BORDER ? ((xc == 1) ? s2[1] : s2[2]) : ZERO_DW);
+    assign p12 = s1[2];
+    assign p11 = (xc >= 1) ? s1[1] : (BORDER ? s1[2] : ZERO_DW);
+    assign p10 = (xc >= 2) ? s1[0] : (BORDER ? ((xc == 1) ? s1[1] : s1[2]) : ZERO_DW);
+    assign p22 = s0[2];
+    assign p21 = (xc >= 1) ? s0[1] : (BORDER ? s0[2] : ZERO_DW);
+    assign p20 = (xc >= 2) ? s0[0] : (BORDER ? ((xc == 1) ? s0[1] : s0[2]) : ZERO_DW);
+
+    // 同步头同延时（整个模块固定 1 拍）
+    reg hs_d1, vs_d1;
+
+    assign de_out  = de_d1;
+    assign hs_out  = hs_d1;
+    assign vs_out  = vs_d1;
+    assign col_out = {1'b0, xc};        // 窗口右列列号
+    assign row_out = row_idx;
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin hs_d1 <= 1'b0; vs_d1 <= 1'b0; end
+        else        begin hs_d1 <= hs_in; vs_d1 <= vs_in; end
+    end
+
+endmodule
--- v8/user_source/algorithms/polar_block_engine.v
+++ fusion/user_source/algorithms/polar_block_engine.v
@@ -0,0 +1,404 @@
+`timescale 1ns/1ps
+// 偏振后台块引擎：每次处理16个连续RGB888像素（384 bit / 3个128 bit DDR字）。
+// DDR地址以16 bit为单位，因此相邻128 bit字地址相差8；偏移量由上层按块提供。
+// 只在grant且ready时发出单拍命令。读返回按顺序计数；写后逐字读回全部内容，
+// 用于覆盖DDR命令队列尚未完成物理写入的情况。计算期间释放DDR所有权。
+`include "../ddr_page_map.vh"
+module polar_block_engine #(
+    parameter [24:0] ANGLE0_BASE = `DDR_MAP_ANGLE0_BASE,
+    parameter [24:0] ANGLE45_BASE = `DDR_MAP_ANGLE45_BASE,
+    parameter [24:0] ANGLE90_BASE = `DDR_MAP_ANGLE90_BASE,
+    parameter [24:0] ANGLE135_BASE = `DDR_MAP_ANGLE135_BASE,
+    parameter [24:0] DOLP_BASE = `DDR_MAP_DOLP_BASE,
+    parameter [24:0] AOP_BASE = `DDR_MAP_AOP_BASE,
+    parameter [24:0] FUSION_BASE = `DDR_MAP_FUSION_BASE,
+    parameter integer ENABLE_EDGE = 0,
+    parameter integer IMG_WIDTH = 1280,
+    parameter [24:0] EDGE_BASE = `DDR_MAP_EDGE_BASE,
+    parameter [7:0] EDGE_THRESHOLD = 8'd24,
+    parameter integer VERIFY_MAX_PASSES = 4096,
+    parameter integer BLOCK_LIMIT = 67108864
+)(
+    input wire clk, rst_n, start, op_compute,
+    input wire [24:0] source_addr, dest_addr, block_offset,
+    output wire busy,
+    output reg done, error,
+    output wire request,
+    input wire grant,
+    output reg owner_release,
+    input wire ddr_ready,
+    output wire rd_en, wr_en,
+    output wire [24:0] addr,
+    output wire [127:0] wr_data,
+    input wire rd_valid,
+    input wire [127:0] rd_data,
+    input wire abort_req,
+    output reg abort_ack,
+    output reg reset_required
+);
+    localparam [4:0] ST_IDLE=0, ST_READ_ISSUE=1, ST_READ_WAIT=2,
+        ST_RELEASE_WAIT=3, ST_FEED=4, ST_CORE_WAIT=5, ST_BUILD=6,
+        ST_WRITE_ISSUE=7, ST_VERIFY_ISSUE=8, ST_VERIFY_WAIT=9,
+        ST_FINISH_WAIT=10, ST_ERROR_HOLD=11, ST_PRE_FRAME=12,
+        ST_PRE_GAP=13, ST_PRE_LINE=14, ST_RETRY_RELEASE=15,
+        ST_ABORT_READ_DRAIN=16, ST_ABORT_RELEASE=17, ST_ABORT_LOCAL=18,
+        ST_TERMINAL=19;
+    localparam AFTER_READ_FEED=1'b0, AFTER_READ_WRITE=1'b1;
+    localparam integer VERIFY_W=(VERIFY_MAX_PASSES<2)?1:$clog2(VERIFY_MAX_PASSES+1);
+    localparam integer BLOCK_W=(BLOCK_LIMIT<2)?1:$clog2(BLOCK_LIMIT+1);
+
+    function [23:0] aop_hue;
+        input [7:0] a;
+        reg [7:0] seg,t,fr;
+        begin
+            if      (a < 8'd43)  begin seg=8'd0;t=a;end
+            else if (a < 8'd86)  begin seg=8'd1;t=a-8'd43;end
+            else if (a < 8'd129) begin seg=8'd2;t=a-8'd86;end
+            else if (a < 8'd172) begin seg=8'd3;t=a-8'd129;end
+            else if (a < 8'd215) begin seg=8'd4;t=a-8'd172;end
+            else                 begin seg=8'd5;t=a-8'd215;end
+            fr=(t<<2)+(t<<1);
+            case(seg)
+                8'd0:aop_hue={8'd255,fr,8'd0};
+                8'd1:aop_hue={8'd255-fr,8'd255,8'd0};
+                8'd2:aop_hue={8'd0,8'd255,fr};
+                8'd3:aop_hue={8'd0,8'd255-fr,8'd255};
+                8'd4:aop_hue={fr,8'd0,8'd255};
+                default:aop_hue={8'd255,8'd0,8'd255-fr};
+            endcase
+        end
+    endfunction
+
+    reg [4:0] state;
+    reg compute_latched;
+    reg [24:0] src_latched,dst_latched,offset_latched;
+    reg after_release;
+    reg [4:0] read_total,read_issued,read_returned;
+    reg [3:0] write_total,write_index,verify_issued,verify_returned;
+    reg [VERIFY_W-1:0] verify_attempts;
+    reg [BLOCK_W-1:0] blocks_started;
+    reg abort_seen,abort_after_verify;
+    reg verify_mismatch;
+    wire abort_active=(abort_req===1'b1);
+    wire core_rst_n=rst_n&&(state!=ST_ABORT_LOCAL);
+    reg [4:0] feed_index,raw_count,fused_count;
+    reg [4:0] edge_count;
+    localparam integer BLOCKS_PER_LINE=IMG_WIDTH/16;
+    localparam integer COL_W=(BLOCKS_PER_LINE<2)?1:$clog2(BLOCKS_PER_LINE);
+    reg [COL_W-1:0] column_block;
+    reg compute_frame_start,compute_line_start;
+    // 16拍输入全部送出后，复用为DoLP/AoP/Fusion/Edge；写入及核验重试期间保持不变。
+    reg [383:0] angle0_words,angle45_words,angle90_words,angle135_words;
+    reg [127:0] expected_word;
+    reg [3:0] expected_index;
+
+    wire [23:0] rgb0_in,rgb45_in,rgb90_in,rgb135_in;
+    wire [7:0] i0_in,i45_in,i90_in,i135_in;
+    // 按像素串行移位，避免用feed_index驱动四个384 bit宽动态多路器。
+    assign rgb0_in=angle0_words[383:360];
+    assign rgb45_in=angle45_words[383:360];
+    assign rgb90_in=angle90_words[383:360];
+    assign rgb135_in=angle135_words[383:360];
+    // RGB888绿色字节作为强度；四角度图像必须来自同一固定白平衡/曝光组。
+    assign i0_in=rgb0_in[15:8];
+    assign i45_in=rgb45_in[15:8];
+    assign i90_in=rgb90_in[15:8];
+    assign i135_in=rgb135_in[15:8];
+
+    wire [23:0] polar_rgb_unused,fusion_rgb,edge_rgb;
+    wire [7:0] polar_y,polar_dolp_unused,polar_aop_unused;
+    wire polar_de,polar_hs,polar_vs,edge_de;
+    wire edge_hs_in=(state==ST_PRE_LINE);
+    wire edge_vs_in=(state==ST_PRE_FRAME);
+    wire [7:0] fusion_y_unused,fusion_dolp,fusion_aop;
+    wire fusion_bin_unused,fusion_de,fusion_hs_unused,fusion_vs_unused;
+    algo_polar_fusion u_polar_fusion(
+        .clk(clk),.rst_n(core_rst_n),.i0(i0_in),.i45(i45_in),.i90(i90_in),.i135(i135_in),
+        .rgb0(rgb0_in),.rgb45(rgb45_in),.rgb90(rgb90_in),.rgb135(rgb135_in),
+        .de_in(state==ST_FEED),.hs_in(ENABLE_EDGE?edge_hs_in:1'b0),
+        .vs_in(ENABLE_EDGE?edge_vs_in:1'b0),.thr_in(8'h40),
+        .polar_rgb_out(polar_rgb_unused),.polar_y_out(polar_y),
+        .polar_dolp_out(polar_dolp_unused),.polar_aop_out(polar_aop_unused),
+        .polar_de_out(polar_de),.polar_hs_out(polar_hs),.polar_vs_out(polar_vs),
+        .rgb_out(fusion_rgb),.y_out(fusion_y_unused),.dolp_out(fusion_dolp),
+        .aop_out(fusion_aop),.bin_out(fusion_bin_unused),.de_out(fusion_de),
+        .hs_out(fusion_hs_unused),.vs_out(fusion_vs_unused));
+
+    generate if(ENABLE_EDGE)begin:g_edge
+        algo_edge_polar #(.EDGE_MODE(1),.FUSE_MODE(0),.W_RGB(192),.W_DOLP(64),
+            .EDGE_INV(0),.BORDER(1),.LB_W(IMG_WIDTH),.LB_DEPTH(2048),.LB_AW(11)) u_edge(
+            .clk(clk),.rst_n(core_rst_n),.y_in(polar_y),.dolp_in(polar_dolp_unused),
+            .vin(polar_de),.hs_in(polar_hs),.vs_in(polar_vs),.thr_in(EDGE_THRESHOLD),
+            .rgb_out(edge_rgb),.y_out(),.e_rgb_out(),.e_dolp_out(),
+            .bin_out(),.de_out(edge_de),.hs_out(),.vs_out());
+    end else begin:g_no_edge
+        assign edge_rgb=24'd0;assign edge_de=1'b0;
+    end endgenerate
+
+    assign busy=(state!=ST_IDLE);
+    // 每次grant只服务当前短阶段。释放后必须等grant撤销再申请下一阶段。
+    assign request=(state==ST_READ_ISSUE)||(state==ST_READ_WAIT)||
+                   (state==ST_WRITE_ISSUE)||(state==ST_VERIFY_ISSUE)||(state==ST_VERIFY_WAIT);
+    assign rd_en=request&&grant&&ddr_ready&&(!abort_active||abort_after_verify)&&
+                  ((state==ST_READ_ISSUE&&read_issued<read_total)||
+                   (state==ST_VERIFY_ISSUE&&verify_issued<write_total));
+    assign wr_en=request&&grant&&ddr_ready&&(state==ST_WRITE_ISSUE&&write_index<write_total)&&
+                  (!abort_active||abort_after_verify||write_index!=0);
+    always @* begin
+        if(state==ST_VERIFY_ISSUE||state==ST_VERIFY_WAIT)expected_index=verify_returned;
+        else expected_index=write_index;
+        case(expected_index)
+            0:expected_word=angle0_words[383:256];
+            1:expected_word=angle0_words[255:128];
+            2:expected_word=angle0_words[127:0];
+            3:expected_word=angle45_words[383:256];
+            4:expected_word=angle45_words[255:128];
+            5:expected_word=angle45_words[127:0];
+            6:expected_word=angle90_words[383:256];
+            7:expected_word=angle90_words[255:128];
+            8:expected_word=angle90_words[127:0];
+            9:expected_word=angle135_words[383:256];
+            10:expected_word=angle135_words[255:128];
+            default:expected_word=angle135_words[127:0];
+        endcase
+    end
+    assign wr_data=expected_word;
+
+    reg [24:0] addr_comb,base_comb;
+    always @* begin
+        addr_comb=25'd0;base_comb=25'd0;
+        if(state==ST_READ_ISSUE)begin
+            if(!compute_latched)
+                addr_comb=src_latched+({20'd0,read_issued[1:0]}<<3);
+            else begin
+                case(read_issued/3)
+                    0:base_comb=ANGLE0_BASE;
+                    1:base_comb=ANGLE45_BASE;
+                    2:base_comb=ANGLE90_BASE;
+                    default:base_comb=ANGLE135_BASE;
+                endcase
+                addr_comb=base_comb+offset_latched+({23'd0,(read_issued%3)}<<3);
+            end
+        end else if(state==ST_VERIFY_ISSUE)begin
+            if(!compute_latched)
+                addr_comb=dst_latched+({21'd0,verify_issued[1:0]}<<3);
+            else if(verify_issued<3)
+                addr_comb=DOLP_BASE+offset_latched+({21'd0,verify_issued}<<3);
+            else if(verify_issued<6)
+                addr_comb=AOP_BASE+offset_latched+({21'd0,(verify_issued-4'd3)}<<3);
+            else if(verify_issued<9)
+                addr_comb=FUSION_BASE+offset_latched+({21'd0,(verify_issued-4'd6)}<<3);
+            else addr_comb=EDGE_BASE+offset_latched+({21'd0,(verify_issued-4'd9)}<<3);
+        end else if(state==ST_WRITE_ISSUE)begin
+            if(!compute_latched)
+                addr_comb=dst_latched+({21'd0,write_index[1:0]}<<3);
+            else if(write_index<3)
+                addr_comb=DOLP_BASE+offset_latched+({21'd0,write_index}<<3);
+            else if(write_index<6)
+                addr_comb=AOP_BASE+offset_latched+({21'd0,(write_index-4'd3)}<<3);
+            else if(write_index<9)
+                addr_comb=FUSION_BASE+offset_latched+({21'd0,(write_index-4'd6)}<<3);
+            else addr_comb=EDGE_BASE+offset_latched+({21'd0,(write_index-4'd9)}<<3);
+        end
+    end
+    assign addr=addr_comb;
+
+    always @(posedge clk or negedge rst_n) begin
+        if(!rst_n)begin
+            state<=ST_IDLE;compute_latched<=0;src_latched<=0;dst_latched<=0;offset_latched<=0;
+            after_release<=AFTER_READ_FEED;read_total<=0;read_issued<=0;read_returned<=0;
+            write_total<=0;write_index<=0;verify_issued<=0;verify_returned<=0;verify_attempts<=0;
+            blocks_started<=0;abort_seen<=0;abort_after_verify<=0;
+            verify_mismatch<=0;
+            feed_index<=0;raw_count<=0;fused_count<=0;edge_count<=0;
+            column_block<=0;compute_frame_start<=0;compute_line_start<=0;
+            angle0_words<=0;angle45_words<=0;angle90_words<=0;angle135_words<=0;
+            done<=0;error<=0;owner_release<=0;abort_ack<=0;reset_required<=0;
+        end else begin
+            done<=0;owner_release<=0;abort_ack<=0;
+            if(!abort_active)abort_seen<=0;
+            if(rd_en&&state==ST_READ_ISSUE)read_issued<=read_issued+1'b1;
+
+            // 命令计数与数据返回计数独立，允许二者在同一时钟各自前进。
+            if(rd_valid)begin
+                if(state==ST_READ_ISSUE||state==ST_READ_WAIT||state==ST_ABORT_READ_DRAIN)begin
+                    read_returned<=read_returned+1'b1;
+                    if(compute_latched)begin
+                        case(read_returned/3)
+                            0:angle0_words<={angle0_words[255:0],rd_data};
+                            1:angle45_words<={angle45_words[255:0],rd_data};
+                            2:angle90_words<={angle90_words[255:0],rd_data};
+                            default:angle135_words<={angle135_words[255:0],rd_data};
+                        endcase
+                    end
+                    else angle0_words<={angle0_words[255:0],rd_data};
+                end else if(state==ST_VERIFY_ISSUE||state==ST_VERIFY_WAIT)begin
+                    verify_returned<=verify_returned+1'b1;
+                    if(rd_data!==expected_word)verify_mismatch<=1'b1;
+                end
+            end
+
+            if(abort_active&&!abort_seen)begin
+                abort_seen<=1'b1;
+                case(state)
+                    ST_IDLE:begin abort_ack<=1'b1; end
+                    ST_READ_ISSUE,ST_READ_WAIT:state<=ST_ABORT_READ_DRAIN;
+                    ST_RELEASE_WAIT:state<=ST_ABORT_RELEASE;
+                    ST_FEED,ST_CORE_WAIT,ST_BUILD,ST_PRE_FRAME,ST_PRE_GAP,ST_PRE_LINE:
+                        state<=ST_ABORT_LOCAL;
+                    ST_WRITE_ISSUE:if(wr_en)begin
+                        abort_after_verify<=1'b1;
+                        if(write_index==write_total-1'b1)begin
+                            write_index<=write_index+1'b1;verify_issued<=0;verify_returned<=0;
+                            verify_mismatch<=0;state<=ST_VERIFY_ISSUE;
+                        end else write_index<=write_index+1'b1;
+                    end else if(write_index==0)begin owner_release<=1'b1;state<=ST_ABORT_RELEASE;end
+                    else abort_after_verify<=1'b1;
+                    ST_VERIFY_WAIT:begin
+                        abort_after_verify<=1'b1;
+                        if(rd_valid&&verify_returned==write_total-1'b1)begin
+                            if(!verify_mismatch&&rd_data===expected_word)begin
+                                error<=0;owner_release<=1'b1;state<=ST_FINISH_WAIT;
+                            end else if(verify_attempts+1'b1>=VERIFY_MAX_PASSES)begin
+                                verify_attempts<=VERIFY_MAX_PASSES;error<=1'b1;
+                                reset_required<=1'b1;state<=ST_TERMINAL;
+                            end else begin
+                                verify_attempts<=verify_attempts+1'b1;
+                                verify_issued<=0;verify_returned<=0;verify_mismatch<=0;
+                                owner_release<=1'b1;state<=ST_RETRY_RELEASE;
+                            end
+                        end
+                    end
+                    ST_VERIFY_ISSUE,ST_RETRY_RELEASE,ST_FINISH_WAIT:
+                        abort_after_verify<=1'b1;
+                    ST_TERMINAL:begin error<=1'b1;reset_required<=1'b1;end
+                    default:begin error<=1'b1;reset_required<=1'b1;state<=ST_TERMINAL;end
+                endcase
+            end else if(state==ST_TERMINAL)begin
+                error<=1'b1;reset_required<=1'b1;
+            end else case(state)
+                ST_IDLE:if(start)begin
+                    if(blocks_started>=BLOCK_LIMIT)begin
+                        error<=1'b1;reset_required<=1'b1;state<=ST_TERMINAL;
+                    end else begin
+                    blocks_started<=blocks_started+1'b1;
+                    compute_latched<=op_compute;src_latched<=source_addr;dst_latched<=dest_addr;
+                    offset_latched<=block_offset;read_total<=op_compute?5'd12:5'd3;
+                    read_issued<=0;read_returned<=0;
+                    write_total<=op_compute?(ENABLE_EDGE?4'd12:4'd9):4'd3;
+                    write_index<=0;verify_issued<=0;verify_returned<=0;verify_attempts<=0;
+                    verify_mismatch<=0;feed_index<=0;
+                    raw_count<=0;fused_count<=0;edge_count<=0;angle0_words<=0;angle45_words<=0;
+                    angle90_words<=0;angle135_words<=0;
+                    if(op_compute&&ENABLE_EDGE)begin
+                        if(block_offset==0)begin column_block<=0;compute_frame_start<=1;compute_line_start<=1;end
+                        else begin compute_frame_start<=0;compute_line_start<=(column_block==0);end
+                    end else begin compute_frame_start<=0;compute_line_start<=0;end
+                    error<=0;abort_after_verify<=0;state<=ST_READ_ISSUE;
+                    end
+                end
+                ST_READ_ISSUE:if(read_issued==read_total)state<=ST_READ_WAIT;
+                ST_READ_WAIT:if(read_returned==read_total||
+                                (rd_valid&&read_returned==read_total-1'b1))begin
+                    owner_release<=1;after_release<=compute_latched?AFTER_READ_FEED:AFTER_READ_WRITE;
+                    state<=ST_RELEASE_WAIT;
+                end
+                ST_RELEASE_WAIT:if(!grant)begin
+                    if(after_release==AFTER_READ_FEED)begin
+                        feed_index<=0;
+                        if(ENABLE_EDGE&&compute_frame_start)state<=ST_PRE_FRAME;
+                        else if(ENABLE_EDGE&&compute_line_start)state<=ST_PRE_LINE;
+                        else state<=ST_FEED;
+                    end
+                    else begin write_index<=0;state<=ST_WRITE_ISSUE;end
+                end
+                ST_PRE_FRAME:state<=ST_PRE_GAP;
+                ST_PRE_GAP:state<=ST_PRE_LINE;
+                ST_PRE_LINE:state<=ST_FEED;
+                ST_FEED:begin
+                    angle0_words<={angle0_words[359:0],24'd0};
+                    angle45_words<={angle45_words[359:0],24'd0};
+                    angle90_words<={angle90_words[359:0],24'd0};
+                    angle135_words<={angle135_words[359:0],24'd0};
+                    if(feed_index==15)begin feed_index<=16;state<=ST_CORE_WAIT;end
+                    else feed_index<=feed_index+1'b1;
+                end
+                ST_CORE_WAIT:begin
+                    if(polar_de&&raw_count<16)raw_count<=raw_count+1'b1;
+                    if(fusion_de&&fused_count<16)begin
+                        angle0_words<={angle0_words[359:0],{3{fusion_dolp}}};
+                        angle45_words<={angle45_words[359:0],aop_hue(fusion_aop)};
+                        angle90_words<={angle90_words[359:0],fusion_rgb};
+                        fused_count<=fused_count+1'b1;
+                    end
+                    if(ENABLE_EDGE&&edge_de&&edge_count<16)begin
+                        angle135_words<={angle135_words[359:0],edge_rgb};edge_count<=edge_count+1'b1;
+                    end
+                    if(ENABLE_EDGE)begin
+                        if((raw_count==16||(polar_de&&raw_count==15))&&
+                           (fused_count==16||(fusion_de&&fused_count==15))&&
+                           (edge_count==16||(edge_de&&edge_count==15)))state<=ST_BUILD;
+                    end else if(fusion_de&&fused_count==15)begin
+                        if(raw_count==16||(polar_de&&raw_count==15))state<=ST_BUILD;
+                        else begin error<=1;reset_required<=1;state<=ST_TERMINAL;end
+                    end
+                end
+                // 保留这一拍，让末笔结果的非阻塞写入完成，且DDR发命令时刻不变。
+                ST_BUILD:begin write_index<=0;state<=ST_WRITE_ISSUE;end
+                ST_WRITE_ISSUE:if(wr_en)begin
+                    write_index<=write_index+1'b1;
+                    if(write_index==write_total-1'b1)begin
+                        verify_issued<=0;verify_returned<=0;verify_mismatch<=0;state<=ST_VERIFY_ISSUE;
+                    end
+                end
+                ST_VERIFY_ISSUE:begin
+                    if(rd_en)verify_issued<=verify_issued+1'b1;
+                    if(verify_issued==write_total||
+                       (rd_en&&verify_issued==write_total-1'b1))state<=ST_VERIFY_WAIT;
+                end
+                ST_VERIFY_WAIT:begin
+                    if(rd_valid&&verify_returned==write_total-1'b1)begin
+                        // 最后一个读回值也须在本拍比较通过后才能完成。
+                        if(!verify_mismatch&&rd_data===expected_word)begin
+                            error<=0;owner_release<=1;state<=ST_FINISH_WAIT;
+                        end else begin
+                            if(verify_attempts+1'b1>=VERIFY_MAX_PASSES)begin
+                                verify_attempts<=VERIFY_MAX_PASSES;error<=1'b1;
+                                reset_required<=1'b1;state<=ST_TERMINAL;
+                            end else begin
+                                verify_attempts<=verify_attempts+1'b1;
+                                verify_issued<=0;verify_returned<=0;verify_mismatch<=0;
+                                owner_release<=1;state<=ST_RETRY_RELEASE;
+                            end
+                        end
+                    end
+                end
+                // 本轮回包已收齐：保持结果缓存，等实际grant撤销后再申请下一轮核验。
+                ST_RETRY_RELEASE:if(!grant)state<=ST_VERIFY_ISSUE;
+                ST_FINISH_WAIT:if(!grant)begin
+                    if(abort_after_verify)begin
+                        abort_ack<=1'b1;abort_after_verify<=0;state<=ST_IDLE;
+                    end else begin
+                        if(compute_latched&&ENABLE_EDGE)begin
+                            if(column_block>=BLOCKS_PER_LINE-1)column_block<=0;
+                            else column_block<=column_block+1'b1;
+                        end
+                        done<=1;state<=ST_IDLE;
+                    end
+                end
+                ST_ABORT_READ_DRAIN:if(read_returned>=read_issued||
+                    (rd_valid&&read_returned+1'b1>=read_issued))begin
+                    owner_release<=1'b1;state<=ST_ABORT_RELEASE;
+                end
+                ST_ABORT_RELEASE:if(!grant)begin abort_ack<=1'b1;state<=ST_IDLE;end
+                ST_ABORT_LOCAL:begin
+                    read_issued<=0;read_returned<=0;verify_issued<=0;verify_returned<=0;
+                    angle0_words<=0;angle45_words<=0;angle90_words<=0;angle135_words<=0;
+                    abort_ack<=1'b1;state<=ST_IDLE;
+                end
+                ST_ERROR_HOLD:begin error<=1;reset_required<=1;state<=ST_TERMINAL;end
+                default:begin error<=1;reset_required<=1;state<=ST_TERMINAL;end
+            endcase
+        end
+    end
+endmodule
--- v8/user_source/algorithms/polar_capture_ctrl.v
+++ fusion/user_source/algorithms/polar_capture_ctrl.v
@@ -0,0 +1,125 @@
+`timescale 1ns/1ps
+// 手动偏振片：每按一次NEXT，等待固定白平衡后的完整帧，再冻结读页复制。
+// 先置pause、再经过下一帧边界才取rp，避免边界上wp/rp同时变动导致源页被覆盖。
+// 四角度齐全后逐块计算；全部块读回核对成功，才一次性发布三个结果页面。
+`include "../ddr_page_map.vh"
+module polar_capture_ctrl #(
+    parameter integer FRAME_BLOCKS = 57600,
+    parameter integer SETTLE_FRAMES = 3,
+    parameter integer REQUIRE_GOOD_SETTLE = 0,
+    parameter [24:0] ANGLE0_BASE=`DDR_MAP_ANGLE0_BASE,
+    parameter [24:0] ANGLE45_BASE=`DDR_MAP_ANGLE45_BASE,
+    parameter [24:0] ANGLE90_BASE=`DDR_MAP_ANGLE90_BASE,
+    parameter [24:0] ANGLE135_BASE=`DDR_MAP_ANGLE135_BASE
+)(
+    input wire clk, rst_n, capture_pulse, restart_pulse,
+    input wire frame_start,
+    input wire good_frame, // 新完成并发布的有效帧事件，DDR域；不能用保留旧页代替。
+    input wire [1:0] live_page,
+    input wire [3:0] page_valid,
+    input wire result_source_active,
+    input wire block_busy, block_done, block_error,
+    input wire block_abort_ack, block_reset_required,
+    output reg display_pause,
+    output reg [1:0] angle,
+    output wire capture_busy, compute_busy,
+    output reg ready, error,
+    output reg block_start, block_compute, block_abort_req,
+    output reg [24:0] source_addr, dest_addr, block_offset
+);
+    localparam IDLE=0, SETTLE=1, FREEZE=2, COPY_START=3, COPY_WAIT=4,
+               LIVE_WAIT=5, COMPUTE_START=6, COMPUTE_WAIT=7, ABORT_WAIT=8;
+    reg [3:0] state;
+    reg [7:0] settle_count;
+    reg [15:0] block_index;
+    reg [24:0] frozen_base, snapshot_base;
+    reg restart_pending;
+    function [24:0] live_base;
+        input [1:0] page;
+        begin case(page)
+            0:live_base=`DDR_MAP_LIVE0_BASE; 1:live_base=`DDR_MAP_LIVE1_BASE;
+            2:live_base=`DDR_MAP_LIVE2_BASE; 3:live_base=`DDR_MAP_LIVE3_BASE;
+        endcase end
+    endfunction
+    function [24:0] angle_base;
+        input [1:0] a;
+        begin case(a)
+            0:angle_base=ANGLE0_BASE; 1:angle_base=ANGLE45_BASE;
+            2:angle_base=ANGLE90_BASE; 3:angle_base=ANGLE135_BASE;
+        endcase end
+    endfunction
+    assign capture_busy = state==SETTLE || state==FREEZE || state==COPY_START || state==COPY_WAIT;
+    assign compute_busy = state==LIVE_WAIT || state==COMPUTE_START || state==COMPUTE_WAIT || state==ABORT_WAIT;
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            state<=IDLE; display_pause<=0; angle<=0; ready<=0; error<=0;
+            block_start<=0; block_compute<=0; source_addr<=0; dest_addr<=0;
+            block_offset<=0; block_index<=0; settle_count<=0;
+            frozen_base<=0; snapshot_base<=0; restart_pending<=0;
+            block_abort_req<=0;
+        end else begin
+            block_start<=0;
+            if(block_reset_required||block_error)begin
+                // 终端硬故障只能由全链路复位清除，保持显示暂停并锁住整组结果。
+                ready<=0;error<=1;display_pause<=1;block_abort_req<=0;
+                restart_pending<=0;state<=ABORT_WAIT;
+            end else if(restart_pending)begin
+                ready<=0;display_pause<=1;block_abort_req<=1;state<=ABORT_WAIT;
+                if(block_abort_ack)begin
+                    state<=IDLE;display_pause<=0;angle<=0;ready<=0;error<=0;
+                    restart_pending<=0;block_abort_req<=0;block_index<=0;block_offset<=0;
+                end
+            end else if(restart_pulse)begin
+                ready<=0;
+                if(!block_busy&&!block_start)begin
+                    state<=IDLE;display_pause<=0;angle<=0;error<=0;
+                    block_index<=0;block_offset<=0;
+                end else begin
+                    display_pause<=1;restart_pending<=1;block_abort_req<=1;state<=ABORT_WAIT;
+                end
+            end else case(state)
+                IDLE: if(capture_pulse && !block_busy) begin
+                    ready<=0; error<=0; settle_count<=0; state<=SETTLE;
+                    if(ready) angle<=0; // 完成后再按NEXT，从新的0°整组开始。
+                end
+                // 页面保护会保留旧好图；只有新的好帧才能证明当前角度/WB已经稳定。
+                SETTLE: if(frame_start && (!REQUIRE_GOOD_SETTLE || good_frame)) begin
+                    if(settle_count+1 >= SETTLE_FRAMES) begin display_pause<=1; state<=FREEZE; end
+                    else settle_count<=settle_count+1'b1;
+                end
+                FREEZE: if(frame_start) begin
+                    if(page_valid[live_page]) begin
+                        frozen_base<=live_base(live_page); snapshot_base<=angle_base(angle);
+                        block_index<=0; block_offset<=0; state<=COPY_START;
+                    end else begin
+                        display_pause<=0; error<=1; state<=IDLE;
+                    end
+                end
+                COPY_START: if(!block_busy) begin
+                    source_addr<=frozen_base+block_offset; dest_addr<=snapshot_base+block_offset;
+                    block_compute<=0; block_start<=1; state<=COPY_WAIT;
+                end
+                COPY_WAIT: if(block_done) begin
+                    if(block_index==FRAME_BLOCKS-1) begin
+                        display_pause<=0; block_index<=0; block_offset<=0;
+                        if(angle==3) state<=LIVE_WAIT;
+                        else begin angle<=angle+1'b1; state<=IDLE; end
+                    end else begin
+                        block_index<=block_index+1'b1; block_offset<=block_offset+25'd24;
+                        state<=COPY_START;
+                    end
+                end
+                LIVE_WAIT: if(!result_source_active && !block_busy) state<=COMPUTE_START;
+                COMPUTE_START: if(!block_busy) begin
+                    block_compute<=1; block_start<=1; state<=COMPUTE_WAIT;
+                end
+                COMPUTE_WAIT: if(block_done) begin
+                    if(block_index==FRAME_BLOCKS-1) begin ready<=1; error<=0; angle<=0; state<=IDLE; end
+                    else begin block_index<=block_index+1'b1; block_offset<=block_offset+25'd24; state<=COMPUTE_START; end
+                end
+                ABORT_WAIT: ; // 未核对完成时保持忙，SW0复位可终止故障DDR事务。
+                default: state<=IDLE;
+            endcase
+        end
+    end
+endmodule
--- v8/user_source/algorithms/polar_ddr_arbiter.v
+++ fusion/user_source/algorithms/polar_ddr_arbiter.v
@@ -0,0 +1,86 @@
+`timescale 1ns/1ps
+// DDR命令归属仲裁。显示FIFO有余量、旧读回包及MC队列排空后才交给后台。
+// queue_idle只代表AW/W/AR已接收；后台的写完成由块引擎读回核对证明。
+module polar_ddr_arbiter #(
+    parameter integer MIN_DISPLAY_FILL = 320,
+    parameter integer STALL_LIMIT = 4194304
+)(
+    input wire clk, rst_n, calibrated,
+    input wire queue_idle, user_ready, rd_valid,
+    input wire [127:0] rd_data,
+    input wire vi_busy, vi_wr_en,
+    input wire [24:0] vi_addr,
+    input wire [127:0] vi_data,
+    input wire vo_busy, vo_rd_en, vo_frame_pending,
+    input wire [8:0] vo_fill,
+    input wire [9:0] vo_credit,
+    input wire [24:0] vo_addr,
+    input wire bg_request, bg_release, bg_rd_en, bg_wr_en,
+    input wire [24:0] bg_addr,
+    input wire [127:0] bg_data,
+    output reg bg_grant,
+    output wire live_ready, bg_ready,
+    output wire vo_return_valid, bg_return_valid,
+    output wire [127:0] return_data,
+    output wire wr_en, rd_en,
+    output wire [24:0] addr,
+    output wire [127:0] wr_data,
+    output reg reset_required
+);
+    reg release_pending;
+    reg [5:0] bg_credit;
+    localparam TW=(STALL_LIMIT<2)?1:$clog2(STALL_LIMIT);
+    reg[TW-1:0]vo_stall,bg_stall;
+    wire bg_submit_read = bg_grant && bg_rd_en && calibrated && !reset_required;
+    assign live_ready = user_ready && calibrated && !bg_grant && !reset_required;
+    assign bg_ready = user_ready && calibrated && bg_grant && !release_pending && !reset_required;
+    assign vo_return_valid = rd_valid && !bg_grant;
+    assign bg_return_valid = rd_valid && bg_grant;
+    assign return_data = rd_data;
+    assign wr_en = calibrated && !reset_required && (bg_grant ? bg_wr_en : vi_wr_en);
+    assign rd_en = calibrated && !reset_required && (bg_grant ? bg_rd_en : vo_rd_en);
+    assign addr = bg_grant ? bg_addr : (vi_wr_en ? vi_addr : vo_addr);
+    assign wr_data = bg_grant ? bg_data : vi_data;
+    // Unrelated camera writes must never hide a lost display/background response.
+    always @(posedge clk or negedge rst_n)begin
+        if(!rst_n)begin vo_stall<=0;bg_stall<=0;reset_required<=0;end
+        else begin
+            if(vo_credit==0 || vo_return_valid)vo_stall<=0;
+            else if(vo_stall==STALL_LIMIT-1)reset_required<=1;
+            else vo_stall<=vo_stall+1'b1;
+            if(bg_credit==0 || bg_return_valid)bg_stall<=0;
+            else if(bg_stall==STALL_LIMIT-1)reset_required<=1;
+            else bg_stall<=bg_stall+1'b1;
+            if((bg_return_valid && bg_credit==0 && !bg_submit_read) ||
+               (vo_return_valid && vo_credit==0 && !vo_rd_en))reset_required<=1;
+        end
+    end
+
+    always @(posedge clk or negedge rst_n) begin
+        if (!rst_n) begin
+            bg_grant <= 0; release_pending <= 0; bg_credit <= 0;
+        end else begin
+            case ({bg_submit_read, bg_return_valid})
+                2'b10: bg_credit <= bg_credit + 1'b1;
+                2'b01: if (bg_credit != 0) bg_credit <= bg_credit - 1'b1;
+                default: ;
+            endcase
+            if (!reset_required && !bg_grant) begin
+                release_pending <= 0;
+                // 不能先停显示再等FIFO变满；先让显示补足，再抢占短块。
+                if (calibrated && bg_request && !vi_busy && !vo_busy &&
+                    !vo_frame_pending && vo_fill >= MIN_DISPLAY_FILL &&
+                    vo_credit == 0 && queue_idle && !rd_valid &&
+                    !vi_wr_en && !vo_rd_en)
+                    bg_grant <= 1;
+            end else if(!reset_required) begin
+                if (bg_release) release_pending <= 1;
+                if ((release_pending || bg_release) && bg_credit == 0 &&
+                    queue_idle && !rd_valid && !bg_rd_en && !bg_wr_en) begin
+                    bg_grant <= 0;
+                    release_pending <= 0;
+                end
+            end
+        end
+    end
+endmodule
--- v8/user_source/algorithms/polar_status_cdc.v
+++ fusion/user_source/algorithms/polar_status_cdc.v
@@ -0,0 +1,50 @@
+`timescale 1ns/1ps
+// 慢速状态总线的双向toggle握手。源端保持payload到目的端确认，
+// 不能把每一位独立2FF后直接拼接成可能撕裂的mode/angle/status。
+module polar_status_cdc #(parameter WIDTH=4)(
+    input wire src_clk, src_rst_n,
+    input wire [WIDTH-1:0] src_data,
+    input wire dst_clk, dst_rst_n,
+    output reg [WIDTH-1:0] dst_data
+);
+    reg [WIDTH-1:0] payload;
+    reg request, acknowledge;
+    (* async_reg="true" *) reg ack_1, ack_2, req_1, req_2;
+    always @(posedge src_clk or negedge src_rst_n) begin
+        if (!src_rst_n) begin payload<=0; request<=0; ack_1<=0; ack_2<=0; end
+        else begin
+            ack_1<=acknowledge; ack_2<=ack_1;
+            if (ack_2 == request && payload != src_data) begin
+                payload<=src_data; request<=~request;
+            end
+        end
+    end
+    always @(posedge dst_clk or negedge dst_rst_n) begin
+        if (!dst_rst_n) begin req_1<=0; req_2<=0; acknowledge<=0; dst_data<=0; end
+        else begin
+            req_1<=request; req_2<=req_1;
+            if (req_2 != acknowledge) begin
+                dst_data<=payload;
+                acknowledge<=req_2;
+            end
+        end
+    end
+endmodule
+
+// 经过20ms按键消抖的命令，相邻脉冲远大于跨域握手延迟。
+module polar_pulse_cdc(
+    input wire src_clk, src_rst_n, src_pulse,
+    input wire dst_clk, dst_rst_n,
+    output wire dst_pulse
+);
+    reg toggle;
+    (* async_reg="true" *) reg sync_1, sync_2;
+    reg seen;
+    always @(posedge src_clk or negedge src_rst_n)
+        if (!src_rst_n) toggle<=0;
+        else if (src_pulse) toggle<=~toggle;
+    always @(posedge dst_clk or negedge dst_rst_n)
+        if (!dst_rst_n) begin sync_1<=0; sync_2<=0; seen<=0; end
+        else begin sync_1<=toggle; sync_2<=sync_1; seen<=sync_2; end
+    assign dst_pulse = sync_2 ^ seen;
+endmodule
--- v8/user_source/algorithms/polar_video_backend.v
