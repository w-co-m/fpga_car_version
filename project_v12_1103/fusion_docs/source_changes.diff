-// Adapted from algorithm5.zip for native RGB888 / 720P.
-`timescale 1ns/1ps
-
-module algo_level #(
-    parameter GRAY_MODE  = 0,       
-    parameter CENTER     = 0,       
-    parameter ADD        = 0,       
-    parameter GAIN_SHIFT = 4,       
-    parameter RGB_MODE   = 0        
-)(
-    input  wire        clk,
-    input  wire        rst_n,
-
-    input  wire [23:0] px_in,
-    input  wire        de_in,
-    input  wire        hs_in,
-    input  wire        vs_in,
-    input  wire [7:0]  thr_in,      
-
-    output reg  [23:0] rgb_out,
-    output reg  [7:0]  y_out,
-    output reg         bin_out,     
-    output reg         de_out,
-    output reg         hs_out,
-    output reg         vs_out
-);
-
-    localparam [7:0]  C8   = CENTER;            
-    localparam [15:0] CADD = CENTER + ADD;      
-
-    wire [7:0] r8 = px_in[23:16];
-    wire [7:0] g8 = px_in[15:8];
-    wire [7:0] b8 = px_in[7:0];
-
-    wire [7:0]  y_g;
-    wire        de_g, hs_g, vs_g;
-    wire [23:0] rgb_g_unused;
-
-    algo_gray #(.GRAY_MODE (GRAY_MODE)) u_gray (
-        .clk     (clk),    .rst_n  (rst_n),
-        .px_in   (px_in),
-        .de_in   (de_in),  .hs_in  (hs_in), .vs_in (vs_in),
-        .rgb_out (rgb_g_unused),
-        .y_out   (y_g),
-        .de_out  (de_g),   .hs_out (hs_g),  .vs_out (vs_g)
-    );
-
-    reg [7:0] thr_s1, thr_s2;
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin thr_s1 <= 8'd0; thr_s2 <= 8'd0; end
-        else        begin thr_s1 <= thr_in; thr_s2 <= thr_s1; end
-    end
-
-    function [8:0] xform;
-        input [7:0] c;
-        input [7:0] g;
-        reg [15:0] t, p;
-        reg [17:0] v, w;
-        begin
-            if (CENTER == 0) begin
-                p = c * g;                                  
-                v = (p >> GAIN_SHIFT) + CADD;
-                xform = (v > 18'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
-            end else begin
-                if (c >= C8) begin                          
-                    t = c - C8;
-                    p = t * g;
-                    v = (p >> GAIN_SHIFT) + CADD;
-                    xform = (v > 18'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
-                end else begin                              
-                    t = C8 - c;
-                    p = t * g;
-                    v = p >> GAIN_SHIFT;
-                    w = (v >= CADD) ? 18'd0 : (CADD - v);
-                    xform = (v >= CADD) ? {1'b1, 8'h00} : {1'b0, w[7:0]};
-                end
-            end
-        end
-    endfunction
-
-    function [8:0] dadd;
-        input [7:0] c;
-        input       sgn;        
-        input [7:0] mag;        
-        reg [8:0]   v;
-        begin
-            if (sgn) dadd = (mag > c) ? {1'b1, 8'h00} : {1'b0, (c - mag)};
-            else begin
-                v = {1'b0, c} + mag;
-                dadd = (v > 9'd255) ? {1'b1, 8'hFF} : {1'b0, v[7:0]};
-            end
-        end
-    endfunction
-
-    reg [7:0] r8a, g8a, b8a;        
-    reg [7:0] r8b, g8b, b8b;        
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            r8a <= 8'd0; g8a <= 8'd0; b8a <= 8'd0;
-            r8b <= 8'd0; g8b <= 8'd0; b8b <= 8'd0;
-        end else begin
-            r8a <= r8; g8a <= g8; b8a <= b8;
-            r8b <= r8a; g8b <= g8a; b8b <= b8a;
-        end
-    end
-
-    wire [8:0] yx  = xform(y_g, thr_s2);        
-    wire [7:0] yp  = yx[7:0];
-    wire       ycl = yx[8];
-
-    wire       dsgn = (y_g > yp);               
-    wire [7:0] dmag = dsgn ? (y_g - yp) : (yp - y_g);
-
-    wire [8:0] rx = (RGB_MODE == 0) ? dadd(r8b, dsgn, dmag) : xform(r8b, thr_s2);
-    wire [8:0] gx = (RGB_MODE == 0) ? dadd(g8b, dsgn, dmag) : xform(g8b, thr_s2);
-    wire [8:0] bx = (RGB_MODE == 0) ? dadd(b8b, dsgn, dmag) : xform(b8b, thr_s2);
-
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            rgb_out <= 24'd0;
-            y_out   <= 8'd0;
-            bin_out <= 1'b0;
-            de_out  <= 1'b0;
-            hs_out  <= 1'b0;
-            vs_out  <= 1'b0;
-        end else begin
-            y_out   <= yp;
-            rgb_out <= {rx[7:0], gx[7:0], bx[7:0]};
-            bin_out <= ycl | rx[8] | gx[8] | bx[8];     
-            de_out  <= de_g;
-            hs_out  <= hs_g;
-            vs_out  <= vs_g;
-        end
-    end
-
-endmodule
