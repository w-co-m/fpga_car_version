-        .rgb_out (rgb_g_unused),
-        .y_out   (y_g),
-        .de_out  (de_g),   .hs_out (hs_g),  .vs_out (vs_g)
-    );
-
-    reg [7:0] thr_s1, thr_s2, thr_s3;
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin thr_s1 <= 8'd0; thr_s2 <= 8'd0; thr_s3 <= 8'd0; end
-        else        begin thr_s1 <= thr_in; thr_s2 <= thr_s1; thr_s3 <= thr_s2; end
-    end
-
-    wire [7:0] bthr = OP_FROM_THR ? {thr_s2[7:1], 1'b0} : thr_s2;          
-    wire       y_bin = (y_g >= bthr);
-
-    wire [DW-1:0] din_lb = (DW == 1) ? y_bin
-                                     : (BIN_INPUT ? (y_bin ? 8'hFF : 8'h00) : y_g);
-
-    wire [DW-1:0] p00, p01, p02;
-    wire [DW-1:0] p10, p11, p12;
-    wire [DW-1:0] p20, p21, p22;
-    wire          de_w, hs_w, vs_w;
-
-    line_buffer_3x3 #(
-        .DW       (DW),
-        .LB_W     (LB_W),
-        .LB_DEPTH (LB_DEPTH),
-        .LB_AW    (LB_AW),
-        .BORDER   (BORDER),
-        .VS_ACTIVE_LOW(0)
-    ) u_lb (
-        .clk (clk), .rst_n (rst_n),
-        .din (din_lb), .de_in (de_g), .hs_in (hs_g), .vs_in (vs_g),
-        .p00 (p00), .p01 (p01), .p02 (p02),
-        .p10 (p10), .p11 (p11), .p12 (p12),
-        .p20 (p20), .p21 (p21), .p22 (p22),
-        .de_out (de_w), .hs_out (hs_w), .vs_out (vs_w),
-        .col_out (), .row_out ()
-    );
