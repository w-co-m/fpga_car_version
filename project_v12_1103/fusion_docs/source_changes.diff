-                     + ((be << 4) + (be << 3) + (be << 2) + be);
-    end
-    endgenerate
-
-    
-    reg [15:0] sum_r;
-    reg        de_s1, hs_s1, vs_s1;
-
-    always @(posedge clk or negedge rst_n) begin
