-        else if(gd_prev) begin x2<=0;y2<=y2==IMG_H-1 ? 0 : y2+1'b1;end
-    end
-end
-// Synchronous read with one-block prefetch. Never reset the RAM array.
-reg [7:0] ram_blk[0:MEM_DEPTH-1];
-reg [7:0] blk_ref;
-reg [BW-1:0] bcnt;
-reg [SUM_W-1:0] bsum;
-reg [AW-1:0] row_base,blk_col;
