-// Adapted from the supplied algorithm package for project_v5_1010.
-// RGB888, parameterized 720p coordinates, active-high VS edge, DE line ends.
-`timescale 1ns/1ps
-module algo_color_detect #(
-    parameter IMG_W=1280, IMG_H=720,
-    parameter XW=$clog2(IMG_W), YW=$clog2(IMG_H),
-    parameter HIT_W=$clog2(IMG_W*IMG_H+1),
-    parameter TARGET_COLOR = 0,          
-    parameter DET_RULE     = 0,          
-    parameter R_MIN = 8'd128, R_MAX = 8'd255,
-    parameter G_MIN = 8'd0,  G_MAX = 8'd64,
-    parameter B_MIN = 8'd0,  B_MAX = 8'd128,
-    parameter S_DEF   = 8'd32,            
-    parameter MIN_PIX = 16,              
-    parameter BOX_W   = 2,               
-    parameter BOX_FILL= 0,               
-    parameter BOX_COLOR = 24'h00FF00     
-)(
-    input  wire        clk,
-    input  wire        rst_n,
-    input  wire [23:0] px_in,            
-    input  wire        de_in,
-    input  wire        hs_in,
-    input  wire        vs_in,
-    input  wire [7:0]  thr_in,           
-    output reg  [23:0] rgb_out,          
-    output reg  [7:0]  y_out,            
-    output reg         bin_out,          
-    output reg  [XW-1:0]  bbox_x_min, bbox_x_max,
-    output reg  [YW-1:0]  bbox_y_min, bbox_y_max,
-    output reg         bbox_valid,       
-    output reg  [HIT_W-1:0] hit_cnt,          
-    output reg         de_out, hs_out, vs_out
-);
-    localparam [XW-1:0] X_INIT = {XW{1'b1}};
-    localparam [YW-1:0] Y_INIT = {YW{1'b1}};
-    wire [7:0] r8=px_in[23:16],g8=px_in[15:8],b8=px_in[7:0];
-    wire [7:0] rg_d=(r8>g8)?r8-g8:0,rb_d=(r8>b8)?r8-b8:0;
-    wire [7:0] gr_d=(g8>r8)?g8-r8:0,gb_d=(g8>b8)?g8-b8:0;
-    wire [7:0] br_d=(b8>r8)?b8-r8:0,bg_d=(b8>g8)?b8-g8:0;
-    wire [7:0] S=(thr_in==0)?S_DEF:thr_in;
-    wire dif_red=(rg_d>=S)&&(rb_d>=S);
-    wire dif_grn=(gr_d>=S)&&(gb_d>=S);
-    wire dif_blu=(br_d>=S)&&(bg_d>=S);
-    wire abs_hit=(r8>=R_MIN)&&(r8<=R_MAX)&&(g8>=G_MIN)&&(g8<=G_MAX)&&(b8>=B_MIN)&&(b8<=B_MAX);
-    wire is_tgt = (DET_RULE == 1 || TARGET_COLOR == 3) ? abs_hit :
-                  (TARGET_COLOR == 1)                  ? dif_grn :
-                  (TARGET_COLOR == 2)                  ? dif_blu : dif_red;
-    // Count active pixels/lines, independent of HS/VS pulse lengths.
-    reg [XW-1:0] xc;
-    reg [YW-1:0] yc;
-    reg de_prev,vs_prev;
-    wire frame_start=vs_in && !vs_prev;
-    always @(posedge clk or negedge rst_n) begin
-        if(!rst_n) begin xc<=0;yc<=0;de_prev<=0;vs_prev<=0;end
-        else begin
-            de_prev<=de_in;vs_prev<=vs_in;
-            if(frame_start) begin xc<=0;yc<=0;end
-            else if(de_in) xc<=(xc==IMG_W-1) ? 0 : xc+1'b1;
-            else if(de_prev) begin
-                xc<=0;yc<=(yc==IMG_H-1) ? 0 : yc+1'b1;
-            end
-        end
-    end
-    reg [XW-1:0] sx_min, sx_max;
-    reg [YW-1:0] sy_min, sy_max;
-    reg [HIT_W-1:0]   s_hits;
-    reg          s_seen;
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            sx_min <= X_INIT; sx_max <= {XW{1'b0}};
-            sy_min <= Y_INIT; sy_max <= {YW{1'b0}};
-            s_hits <= 0;  s_seen <= 1'b0;
-        end else if (frame_start) begin                 
-            sx_min <= X_INIT; sx_max <= {XW{1'b0}};
-            sy_min <= Y_INIT; sy_max <= {YW{1'b0}};
-            s_hits <= 0;  s_seen <= 1'b0;
-        end else if (de_in && is_tgt) begin
-            if (xc < sx_min) sx_min <= xc;
-            if (xc > sx_max) sx_max <= xc;
-            if (yc < sy_min) sy_min <= yc;
-            if (yc > sy_max) sy_max <= yc;
-            s_hits <= s_hits + 1'b1;
-            s_seen <= 1'b1;
-        end
-    end
-    wire ok = s_seen && (s_hits >= MIN_PIX);
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            bbox_x_min <= 0; bbox_x_max <= 0;
-            bbox_y_min <= 0;  bbox_y_max <= 0;
-            bbox_valid <= 1'b0;  hit_cnt <= 0;
-        end else if (frame_start) begin
-            bbox_x_min <= ok ? sx_min : 0;
-            bbox_x_max <= ok ? sx_max : 0;
-            bbox_y_min <= ok ? sy_min : 0;
-            bbox_y_max <= ok ? sy_max : 0;
-            bbox_valid <= ok;
-            hit_cnt    <= s_hits;
-        end
-    end
-    reg [23:0] pix1, pix2;
-    reg [XW-1:0] x1, x2;
-    reg [YW-1:0] y1, y2;
-    reg          t1, t2;
-    reg          d1, d2, h1, h2, v1, v2;
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            pix1 <= 24'd0; pix2 <= 24'd0;
-            x1 <= 0; x2 <= 0; y1 <= 0; y2 <= 0;
-            t1 <= 1'b0; t2 <= 1'b0;
