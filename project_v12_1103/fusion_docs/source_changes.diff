-    if (SE_CROSS == 0) begin : g_square        
-        wire [DW-1:0] r1 = f(p00, p01);
-        wire [DW-1:0] r2 = f(p02, p10);
-        wire [DW-1:0] r3 = f(p11, p12);
-        wire [DW-1:0] r4 = f(p20, p21);
-        wire [DW-1:0] s1 = f(r1, r2);
-        wire [DW-1:0] s2 = f(r3, r4);
-        wire [DW-1:0] t1 = f(s1, s2);
-        assign res = f(t1, p22);
