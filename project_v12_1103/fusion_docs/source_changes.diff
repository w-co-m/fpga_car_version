-            sum_r <= sum_c + RND;
-            de_s1 <= de_in;
-            hs_s1 <= hs_in;
-            vs_s1 <= vs_in;
-        end
-    end
-
-    wire [15:0] ysh = sum_r >> SHIFT;
-
-    always @(posedge clk or negedge rst_n) begin
-        if (!rst_n) begin
-            rgb_out <= 24'd0;
-            y_out   <= 8'd0;
-            de_out  <= 1'b0;
-            hs_out  <= 1'b0;
-            vs_out  <= 1'b0;
