-    wire op;
-    assign op = OP_FROM_THR ? thr_s3[0] : MORPH_OP[0];
-
-    function [DW-1:0] f;
-        input [DW-1:0] a, b;
-        begin
-
-            f = op ? ((a > b) ? a : b) : ((a < b) ? a : b);
-        end
-    endfunction
-
-    wire [DW-1:0] res;
-
