-    input wire de_in,hs_in,vs_in,input wire [7:0] thr_in,
-    output reg [23:0] rgb_out,output reg [7:0] y_out,output reg bin_out,
-    output reg motion_detected,output reg [CNT_W-1:0] motion_pixel_cnt,
-    output reg ref_ready,output reg de_out,hs_out,vs_out
-);
